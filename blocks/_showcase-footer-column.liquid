{% doc %}
  A footer link column: a bold heading followed by a freely-ordered list of links,
  plain text lines, sub-headings and rating links.
{% enddoc %}

<div
  class="footer-column"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
  {% endif %}

  <ul class="footer-column__list">
    {% content_for 'blocks' %}
  </ul>
</div>

{% stylesheet %}
  .footer-column__heading {
    margin: 0 0 var(--margin-md);
    font-size: var(--font-size--sm);
    font-weight: 600;
  }

  .footer-column__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column__item {
    font-size: var(--font-size--xs);
  }

  .footer-column__item--subheading {
    margin-block-start: var(--margin-lg);
  }

  .footer-column__item--rating {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    flex-wrap: wrap;
  }

  .footer-column__subheading {
    font-size: var(--font-size--sm);
    font-weight: 600;
  }

  .footer-column__link {
    color: inherit;
    text-decoration: none;
  }

  .footer-column__link:hover {
    text-decoration: underline;
  }

  .footer-column__text {
    color: inherit;
  }

  .footer-rating {
    display: inline-flex;
    align-items: center;
    gap: 1px;
  }

  .footer-rating__star,
  .footer-rating__star svg {
    width: 12px;
    height: 12px;
  }

  .footer-rating__star {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .footer-rating__star--full {
    color: var(--footer-rating-color, #f2b03d);
  }

  /* Half star: clip the filled icon to its left half. */
  .footer-rating__star--half {
    color: var(--footer-rating-color, #f2b03d);
    clip-path: inset(0 50% 0 0);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer column",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Column heading",
      "default": "Lorem ipsum"
    }
  ],
  "blocks": [
    { "type": "_showcase-footer-link" },
    { "type": "_showcase-footer-text" },
    { "type": "_showcase-footer-subheading" },
    { "type": "_showcase-footer-rating" }
  ]
}
{% endschema %}
