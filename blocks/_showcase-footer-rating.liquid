{% doc %}
  A review-platform link with a star rating shown beside it, for the "Read reviews"
  footer column.
{% enddoc %}

{% liquid
  assign rating = block.settings.rating | default: 5
  assign full_stars = rating | floor
  assign has_half = false
  assign remainder = rating | minus: full_stars
  if remainder >= 0.25
    assign has_half = true
  endif
%}

<li
  class="footer-column__item footer-column__item--rating"
  {{ block.shopify_attributes }}
>
  <a
    href="{{ block.settings.link | default: '#' }}"
    class="footer-column__link"
  >
    {{- block.settings.label -}}
  </a>

  <span
    class="footer-rating"
    role="img"
    aria-label="{{ rating }} out of 5"
  >
    {% for i in (1..5) %}
      {% liquid
        assign star_class = 'footer-rating__star'
        assign half_index = full_stars | plus: 1
        if i <= full_stars
          assign star_class = star_class | append: ' footer-rating__star--full'
        elsif has_half
          if i == half_index
            assign star_class = star_class | append: ' footer-rating__star--half'
          endif
        endif
      %}
      <span class="{{ star_class }}" aria-hidden="true">
        {{- 'icon-star.svg' | inline_asset_content -}}
      </span>
    {% endfor %}
  </span>
</li>

{% schema %}
{
  "name": "Rating link",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Review platform"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    }
  ]
}
{% endschema %}
