{% comment %}
  Site footer — three stacked bands separated by thin rules:
    1. Link columns + contact block
    2. Payment provider logos (static row; the scrolling marquee is a separate section)
    3. Logo + acknowledgement text + social icons

  Link columns come from Shopify menus rather than nested blocks, so links are
  managed in Navigation. On mobile the columns render a second time as accordions
  and the desktop grid is hidden — the same two-version approach as the reference,
  because a closed <details> can't be reliably forced open with CSS across browsers.
{% endcomment %}

{% liquid
  assign columns = section.blocks | where: 'type', 'column'
  assign payments = section.blocks | where: 'type', 'payment'
  assign socials = section.blocks | where: 'type', 'social'

  # Count blocks that actually carry an image, so a band of not-yet-populated
  # blocks collapses instead of rendering as an empty gap between two rules.
  assign payment_count = 0
  for block in payments
    if block.settings.image != blank
      assign payment_count = payment_count | plus: 1
    endif
  endfor
%}

{%- comment -%}
  base.css forces `.section` transparent, so the tint has to live on this sibling.
{%- endcomment -%}
<div
  class="section-background"
  style="background-color: {{ section.settings.background_color | default: '#f6f6f6' }};"
></div>

<div
  class="section section--{{ section.settings.section_width }} site-footer spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --footer-background: {{ section.settings.background_color | default: '#f6f6f6' }};
    --footer-divider: {{ section.settings.divider_color | default: '#e7e7e7' }};
    --footer-heading-color: {{ section.settings.heading_color | default: '#181818' }};
    --footer-text-color: {{ section.settings.text_color | default: '#5c5c5c' }};
    --footer-payment-height: {{ section.settings.payment_height }}px;
  "
>
  {%- comment -%} ---------- Band 1: link columns + contact ---------- {%- endcomment -%}
  {% if section.settings.show_links_band %}
    <div class="site-footer__band site-footer__band--links">
      {%- comment -%} Contact sits first in the DOM; desktop order is set in CSS. {%- endcomment -%}
      {% if section.settings.show_contact %}
        <div class="footer-contact">
          {% if section.settings.contact_heading != blank %}
            <h3 class="footer-heading">{{ section.settings.contact_heading }}</h3>
          {% endif %}

          {% if section.settings.contact_support != blank %}
            <p class="footer-contact__support">{{ section.settings.contact_support }}</p>
          {% endif %}

          {%- comment -%}
            Call and email share one row; location and tax share the next. Each pair
            is its own wrapper so a missing entry leaves its partner full width
            rather than collapsing the grid.
          {%- endcomment -%}
          {% if section.settings.phone_number != blank or section.settings.email_link_text != blank %}
          <div class="footer-contact__pair">
            {% if section.settings.phone_number != blank %}
              {% assign phone_href = section.settings.phone_number
                | remove: ' '
                | remove: '('
                | remove: ')'
                | remove: '-'
              %}
              <a href="tel:{{ phone_href }}" class="footer-contact__row">
                {% if section.settings.phone_icon != blank %}
                  {{
                    section.settings.phone_icon
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', class: 'footer-contact__icon', alt: '', sizes: '32px', widths: '32, 64, 96'
                  }}
                {% endif %}
                <span class="footer-contact__text">
                  <span class="footer-contact__label">{{ section.settings.phone_label | default: 'Call us' }}</span>
                  <span class="footer-contact__value">{{ section.settings.phone_number }}</span>
                </span>
              </a>
            {% endif %}

            {% if section.settings.email_link_text != blank %}
              {%- liquid
                assign email_tag = 'div'
                if section.settings.email_link != blank
                  assign email_tag = 'a'
                endif
              -%}
              <{{ email_tag }} {% if email_tag == 'a' %}href="{{ section.settings.email_link }}" {% endif %}class="footer-contact__row">
                {% if section.settings.email_icon != blank %}
                  {{
                    section.settings.email_icon
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', class: 'footer-contact__icon', alt: '', sizes: '32px', widths: '32, 64, 96'
                  }}
                {% endif %}
                <span class="footer-contact__text">
                  <span class="footer-contact__label">{{ section.settings.email_label | default: 'Email us' }}</span>
                  <span class="footer-contact__value">{{ section.settings.email_link_text }}</span>
                </span>
              </{{ email_tag }}>
            {% endif %}
          </div>
          {% endif %}

          {%- comment -%}
            Location and tax rows are plain divs, not links — nothing to navigate to.
          {%- endcomment -%}
          {% liquid
            assign has_location = false
            if section.settings.show_location_row and section.settings.location_text != blank
              assign has_location = true
            endif
            assign has_tax = false
            if section.settings.show_tax_row and section.settings.tax_text != blank
              assign has_tax = true
            endif
          %}
          {% if has_location or has_tax %}
          <div class="footer-contact__pair">
            {% if has_location %}
              <div class="footer-contact__row">
                {% if section.settings.location_icon != blank %}
                  {{
                    section.settings.location_icon
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', class: 'footer-contact__icon', alt: '', sizes: '32px', widths: '32, 64, 96'
                  }}
                {% endif %}
                <span class="footer-contact__text">
                  <span class="footer-contact__label">
                    {{- section.settings.location_label | default: 'Location' -}}
                  </span>
                  <span class="footer-contact__value">{{ section.settings.location_text }}</span>
                </span>
              </div>
            {% endif %}

            {% if has_tax %}
              <div class="footer-contact__row">
                {% if section.settings.tax_icon != blank %}
                  {{
                    section.settings.tax_icon
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', class: 'footer-contact__icon', alt: '', sizes: '32px', widths: '32, 64, 96'
                  }}
                {% endif %}
                <span class="footer-contact__text">
                  <span class="footer-contact__label">{{ section.settings.tax_label | default: 'Tax ID' }}</span>
                  <span class="footer-contact__value">{{ section.settings.tax_text }}</span>
                </span>
              </div>
            {% endif %}
          </div>
          {% endif %}
        </div>
      {% endif %}

      {% if columns.size > 0 %}
        {%- comment -%} Desktop: side-by-side columns. {%- endcomment -%}
        <div class="footer-columns">
          {% for block in columns %}
            <div class="footer-column" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-heading">{{ block.settings.heading }}</h3>
              {% endif %}

              {% if block.settings.menu != blank %}
                <ul class="footer-column__list">
                  {% for link in block.settings.menu.links %}
                    <li><a href="{{ link.url }}" class="footer-column__link">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        {%- comment -%} Mobile: the same columns as collapsed accordions. {%- endcomment -%}
        <div class="footer-accordions">
          {% for block in columns %}
            <details class="footer-accordion">
              <summary class="footer-accordion__summary">
                <span class="footer-heading">{{ block.settings.heading }}</span>
                <span class="svg-wrapper footer-accordion__chevron" aria-hidden="true">
                  {{- 'icon-chevron-down.svg' | inline_asset_content -}}
                </span>
              </summary>

              {% if block.settings.menu != blank %}
                <ul class="footer-column__list">
                  {% for link in block.settings.menu.links %}
                    <li><a href="{{ link.url }}" class="footer-column__link">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </details>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {%- comment -%} ---------- Band 2: payment logos ---------- {%- endcomment -%}
  {% if section.settings.show_payments_band and payment_count > 0 %}
    <div class="site-footer__band site-footer__band--payments">
      {% for block in payments %}
        {% if block.settings.image != blank %}
          <span class="footer-payment" {{ block.shopify_attributes }}>
            {{
              block.settings.image
              | image_url: width: 240
              | image_tag: loading: 'lazy', class: 'footer-payment__logo', alt: block.settings.alt, sizes: '64px', widths: '64, 128, 192'
            }}
          </span>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {%- comment -%}
    ---------- Band 3: social icons, then the copyright line ----------
    Social comes first in the DOM because that is the visual order now; the logo
    was dropped from this band entirely.
  {%- endcomment -%}
  {% if section.settings.show_bottom_band %}
    <div class="site-footer__band site-footer__band--bottom">
      <div class="footer-bottom__social">
        {% for block in socials %}
          {% if block.settings.link == blank %}{% continue %}{% endif %}
          <a
            href="{{ block.settings.link }}"
            class="footer-social"
            aria-label="{{ block.settings.label | default: 'Social' | escape }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.icon != blank %}
              {{
                block.settings.icon
                | image_url: width: 60
                | image_tag: loading: 'lazy', class: 'footer-social__icon', alt: '', sizes: '20px', widths: '20, 40, 60'
              }}
            {% endif %}
          </a>
        {% endfor %}
      </div>

      <div class="footer-bottom__center">
        {% if section.settings.acknowledgement != blank %}
          <div class="footer-bottom__text">{{ section.settings.acknowledgement }}</div>
        {% endif %}

        {% if section.settings.legal_menu != blank %}
          <ul class="footer-bottom__legal">
            {% for link in section.settings.legal_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>


{% stylesheet %}
  .site-footer {
    color: var(--footer-text-color);
  }

  .site-footer__band + .site-footer__band {
    border-block-start: 1px solid var(--footer-divider);
  }

  .footer-heading {
    margin: 0 0 var(--margin-md);
    color: var(--footer-heading-color);
    font-size: 16px;
    font-weight: 500;
  }

  /*
    ---- Band 1 ----
    Four evenly distributed tracks rather than a left cluster plus a right-pinned
    contact block, so the link columns spread across the full width instead of
    leaving dead space in the middle. `align-items: start` stops the short columns
    stretching to the tallest one, and the reduced bottom padding keeps the space
    under them reading as deliberate whitespace.
  */
  .site-footer__band--links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) 320px;
    align-items: start;
    gap: var(--gap-2xl);
    padding-block-start: 48px;
    padding-block-end: 32px;
  }

  /* Lets the three columns become grid items of the band itself. */
  .footer-columns {
    display: contents;
  }

  .footer-column {
    min-width: 0;
  }

  .footer-column__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column__list li + li {
    margin-block-start: 14px;
  }

  .footer-column__link {
    color: var(--footer-text-color);
    font-size: var(--font-size--sm);
    line-height: 1.6;
    text-decoration: none;
  }

  .footer-column__link:hover {
    text-decoration: underline;
  }

  /* Accordions are mobile-only; the grid above covers desktop. */
  .footer-accordions {
    display: none;
  }

  /* Explicitly last, since it comes first in the DOM for the mobile stack order. */
  .footer-contact {
    grid-column: 4;
    grid-row: 1;
    min-width: 0;
  }

  .footer-contact__support {
    margin: 0 0 var(--margin-lg);
    font-size: var(--font-size--sm);
  }

  /*
    Two rows per line. `auto-fit` rather than a fixed `1fr 1fr` so a pair holding
    only one row spans the full width instead of leaving a dead half-column.
  */
  .footer-contact__pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--gap-md) var(--gap-lg);
  }

  .footer-contact__pair + .footer-contact__pair {
    margin-block-start: var(--margin-lg);
  }

  .footer-contact__row {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    min-width: 0;
    color: var(--footer-text-color);
    text-decoration: none;
  }

  .footer-contact__icon {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .footer-contact__text {
    display: flex;
    flex-direction: column;
  }

  /*
    Below 390px the icon + text no longer fit side by side in a half-width
    column: "hello@woodeca.com" alone is ~139px and pushed 375px screens 2px
    wide. Stacking the icon over its text keeps both rows side by side and
    every value on one line; wrapping inside a word stays a last resort for
    even narrower screens.
  */
  @media (max-width: 389px) {
    .footer-contact__row {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-contact__text {
      min-width: 0;
      overflow-wrap: anywhere;
    }
  }

  .footer-contact__label {
    color: var(--footer-heading-color);
    font-size: var(--font-size--sm);
    font-weight: 600;
  }

  /* Line-height gives a wrapped address room without affecting single-line rows. */
  .footer-contact__value {
    font-size: var(--font-size--sm);
    line-height: 1.5;
  }

  /* ---- Band 2 ---- */
  .site-footer__band--payments {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Wraps to a second centred row rather than scrolling. */
    flex-wrap: wrap;
    gap: var(--gap-lg);
    padding-block: var(--padding-lg);
  }

  .footer-payment {
    display: inline-flex;
    align-items: center;
  }

  .footer-payment__logo {
    width: auto;
    height: var(--footer-payment-height, 24px);
    max-width: 64px;
    object-fit: contain;
  }

  /*
    ---- Band 3 ----
    A centred column at every width: social icons on top, copyright text under
    them. Same order on mobile, so no direction flip is needed below.
  */
  .site-footer__band--bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md);
    padding-block: 32px;
  }

  .footer-bottom__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-2xs);
    text-align: center;
  }

  .footer-bottom__text {
    max-width: 70ch;
    font-size: 14px;
    line-height: 1.6;
  }

  .footer-bottom__text > :first-child {
    margin-block-start: 0;
  }

  .footer-bottom__text > :last-child {
    margin-block-end: 0;
  }

  .footer-bottom__legal {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-bottom__legal a {
    color: var(--footer-text-color);
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom__social {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
  }

  .footer-social__icon {
    display: block;
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    /* Contact moves above the accordions, matching the reference's column-reverse. */
    .site-footer__band--links {
      display: flex;
      flex-direction: column;
      /*
        Must reset the desktop `start`: in a flex column that is the cross axis, so
        it shrinks the accordions to their text width instead of filling the row.
      */
      align-items: stretch;
      gap: var(--gap-xl);
      padding-block: var(--padding-xl);
    }

    /* Undo the desktop grid placement so the stack order is DOM order. */
    .footer-contact {
      grid-column: auto;
      grid-row: auto;
      flex: 1 1 auto;
      width: 100%;
    }

    .footer-columns {
      display: none;
    }

    .footer-accordions {
      display: block;
      order: 1;
    }

    .footer-accordion {
      border-block-start: 1px solid var(--footer-divider);
    }

    .footer-accordion:last-child {
      border-block-end: 1px solid var(--footer-divider);
    }

    .footer-accordion__summary {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--gap-sm);
      padding-block: var(--padding-md);
      padding-inline-end: 24px;
      cursor: pointer;
      list-style: none;
    }

    .footer-accordion__summary::-webkit-details-marker {
      display: none;
    }

    .footer-accordion__summary .footer-heading {
      margin: 0;
    }

    .footer-accordion__chevron {
      flex: 0 0 auto;
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
      color: var(--footer-heading-color);
      transition: rotate var(--animation-speed) var(--animation-easing);
    }

    .footer-accordion[open] .footer-accordion__chevron {
      rotate: 180deg;
    }

    .footer-accordion .footer-column__list {
      padding-block-end: var(--padding-md);
    }

    .site-footer__band--bottom {
      gap: var(--gap-lg);
      padding-block: var(--padding-xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Site footer",
  "tag": "footer",
  "class": "section-site-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
      "content": "Bands"
    },
    {
      "type": "checkbox",
      "id": "show_links_band",
      "label": "Show link columns and contact",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payments_band",
      "label": "Show payment logos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_band",
      "label": "Show bottom bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Contact block"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact block",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Heading",
      "default": "Any questions? We can help"
    },
    {
      "type": "text",
      "id": "contact_support",
      "label": "Supporting line",
      "default": "Available Sunday to Thursday, 9am to 6pm"
    },
    {
      "type": "image_picker",
      "id": "phone_icon",
      "label": "Phone icon"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Call us"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "+20 10 41920335"
    },
    {
      "type": "image_picker",
      "id": "email_icon",
      "label": "Email icon"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email us"
    },
    {
      "type": "text",
      "id": "email_link_text",
      "label": "Email link text",
      "default": "Send us a message"
    },
    {
      "type": "url",
      "id": "email_link",
      "label": "Email link"
    },
    {
      "type": "checkbox",
      "id": "show_location_row",
      "label": "Show location row",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "location_icon",
      "label": "Location icon"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Location label",
      "default": "Location"
    },
    {
