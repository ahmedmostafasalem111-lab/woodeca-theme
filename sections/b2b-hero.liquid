{% comment %}
  Image hero (divan.ru/b2b style): full-bleed image under a dark overlay, a
  centred H1 and subtitle in white, and a white pill button (usually #enquiry).
  The image is the LCP: eager, fetchpriority high and preloaded from <head> at
  high priority (layout/theme.liquid). Phones get 375–750px files whatever their
  pixel density, wider screens 750–1920px. No image: a solid band in
  the theme's dark palette colour, text unchanged.
{% endcomment %}
{%- render 'b2b-styles' -%}
{%- liquid
  assign image = section.settings.image
  assign overlay = section.settings.overlay_opacity | default: 0 | divided_by: 100.0
-%}
<div
  class="b2b-hero b2b-hero--{{ section.settings.size }}"
  style="--b2b-hero-overlay: {{ overlay }}; --b2b-hero-empty: {{ settings.color_palette.color1 | default: '#333333' }};"
>
  {% if image != blank %}
  {%- comment -%}
    Phones (under 750px) get the 375–750px files whatever their pixel density;
    wider screens get 750–1920px. Both preload tags are copied into <head> by
    layout/theme.liquid, so the download starts at high priority before the CSS
    and scripts; the media, srcset and sizes match the <picture> below, so the
    browser reuses the preloaded file.
  {%- endcomment -%}
  <link data-hero-preload rel="preload" as="image" fetchpriority="high" media="(max-width: 749px)" imagesrcset="{{ image | image_url: width: 375 }} 375w, {{ image | image_url: width: 550 }} 550w, {{ image | image_url: width: 750 }} 750w" imagesizes="100vw">
  <link data-hero-preload rel="preload" as="image" fetchpriority="high" media="(min-width: 750px)" imagesrcset="{{ image | image_url: width: 750 }} 750w, {{ image | image_url: width: 1100 }} 1100w, {{ image | image_url: width: 1500 }} 1500w, {{ image | image_url: width: 1920 }} 1920w" imagesizes="100vw">
  {%- capture hero_srcset -%}{{ image | image_url: width: 750 }} 750w, {{ image | image_url: width: 1100 }} 1100w, {{ image | image_url: width: 1500 }} 1500w, {{ image | image_url: width: 1920 }} 1920w{%- endcapture -%}
  <picture class="b2b-hero__picture">
    <source media="(max-width: 749px)" srcset="{{ image | image_url: width: 375 }} 375w, {{ image | image_url: width: 550 }} 550w, {{ image | image_url: width: 750 }} 750w" sizes="100vw">
    {{
      image
      | image_url: width: 1920
      | image_tag:
        class: 'b2b-hero__image',
        loading: 'eager',
        fetchpriority: 'high',
        srcset: hero_srcset,
        sizes: '100vw',
        alt: ''
    }}
  </picture>
    <div class="b2b-hero__overlay" aria-hidden="true"></div>
  {% elsif request.design_mode %}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'b2b-hero__image b2b-hero__placeholder' }}
  {% endif %}

  <div class="b2b-hero__content">
    {% if section.settings.heading != blank %}
      <h1 class="b2b-hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="b2b-hero__text">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="b2b-button b2b-button--light b2b-hero__button" href="{{ section.settings.button_link }}">
        {{- section.settings.button_label -}}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .b2b-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 500px;
    overflow: hidden;
    background-color: var(--b2b-hero-empty, #333333);
    color: #ffffff;
    text-align: center;
  }

  .b2b-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Laid over the hero so it takes no grid/flex slot; the image fills it. */
  .b2b-hero__picture {
    position: absolute;
    inset: 0;
  }

  .b2b-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / var(--b2b-hero-overlay, 0.45));
  }

  .b2b-hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 900px;
    padding: 48px 16px;
  }

  .b2b-hero__heading {
    margin: 0;
    color: #ffffff;
    font-size: 34px;
    font-weight: 500;
    line-height: 1.15;
  }

  .b2b-hero--compact .b2b-hero__heading {
    font-size: 30px;
  }

  .b2b-hero__text {
    max-width: 640px;
    margin: 0;
    color: #ffffff;
    font-size: 16px;
    line-height: 1.5;
  }

  .b2b-hero__button {
    margin-block-start: 12px;
  }

  @media screen and (min-width: 990px) {
    .b2b-hero {
      min-height: 600px;
    }

    .b2b-hero--compact {
      min-height: 462px;
    }

    .b2b-hero__heading {
      font-size: 65px;
      line-height: 1;
    }

    .b2b-hero--compact .b2b-hero__heading {
      font-size: 44px;
      line-height: 1.2;
    }

    .b2b-hero__text {
      font-size: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "B2B hero",
  "tag": "section",
  "class": "section-b2b-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "large", "label": "Large (600px desktop, 65px heading)" },
        { "value": "compact", "label": "Compact (462px desktop, 44px heading)" }
      ],
      "default": "large"
    },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Subtitle" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "#enquiry scrolls to the form." }
  ],
  "presets": [{ "name": "B2B hero" }]
}
{% endschema %}
