{% comment %}
  "Why We Love" — the product's own detail shots with a short note under each.

  Content comes from the existing `why_we_love_it_slides` metaobject list already
  set up on products, so nothing has to be re-authored: each entry supplies an
  image, a heading and a short text.

  Rendered as a horizontal scroll-snap slider. The card width is set so the next
  card is part-visible at the right edge, which is what signals the row can be
  swiped — no arrows, no dots, and no slider library: native overflow scrolling
  already does all of it, including momentum and keyboard paging.

  Below 990px images are capped by height so a portrait and a landscape detail
  shot sit on the same baseline; from 990px they are square, so the square
  detail shots aren't cropped to a strip. The type is a step down from the
  page's body size — this block is a supporting detail, not a hero.

  The whole section removes itself when the metafield is empty.
{% endcomment %}

{% liquid
  assign love_ns = section.settings.metafield_namespace | default: 'custom'
  assign love_key = section.settings.metafield_key | default: 'why_we_love_it_slides'
  assign slides = product.metafields[love_ns][love_key].value
%}

{% if slides != blank and slides.size > 0 %}
  <div
    class="section section--{{ section.settings.section_width }} product-love spacing-style"
    style="
      {% render 'spacing-padding', settings: section.settings %}
      --love-columns: {{ section.settings.columns }};
      --love-image-height: {{ section.settings.image_height }}px;
      --love-peek: {{ section.settings.peek | default: 18 }}%;
    "
  >
    {% if section.settings.heading != blank %}
      <h2 class="product-love__heading section-title">{{ section.settings.heading }}</h2>
    {% endif %}

    {%- comment -%}
      `tabindex="0"` because a scroll container holding no focusable children is
      unreachable by keyboard otherwise.
    {%- endcomment -%}
    <ol
      class="product-love__grid"
      role="list"
      tabindex="0"
      aria-label="{{ section.settings.heading | default: 'Why we love' | escape }}"
    >
      {% for slide in slides %}
        <li class="love-card">
          {% if slide.image != blank %}
            <div class="love-card__media">
              {{
                slide.image
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'love-card__image', alt: slide.heading, sizes: '(min-width: 990px) 460px, (min-width: 750px) 38vw, 70vw', widths: '300, 450, 600, 800, 1000'
              }}
            </div>
          {% endif %}

          {% if slide.heading != blank %}
            <h3 class="love-card__heading">{{ slide.heading }}</h3>
          {% endif %}

          {% if slide.text != blank %}
            <p class="love-card__text">{{ slide.text }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </div>
{% endif %}

{% stylesheet %}
  /* Title style: .section-title (base.css); ~14px to the content on phones, ~18px from 990px. */
  .product-love__heading {
    margin: 0 0 14px;
  }

  @media screen and (min-width: 990px) {
    .product-love__heading {
      margin-block-end: 18px;
    }
  }

  /*
    Scroll-snap track. `scroll-padding-inline-start` matches the gutter so a
    snapped card lands flush with the heading above it rather than against the
    viewport edge.
  */
  .product-love__grid {
    display: flex;
    gap: var(--gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* Room for the focus ring, which would otherwise be clipped by the scroller. */
    padding-block: 2px;
  }

  .product-love__grid::-webkit-scrollbar {
    display: none;
  }

  /*
    Card width is a share of the track minus the peek, so the following card is
    always part-visible however many columns the merchant picks. The gap has to
    come out of the width too, or the last card sits short of the edge.
  */
  .love-card {
    flex: 0 0
      calc(
        (100% - var(--love-peek, 18%) - (var(--love-columns, 2) - 1) * var(--gap-md)) /
          var(--love-columns, 2)
      );
    min-width: 0;
    scroll-snap-align: start;
  }

  /*
    Fixed height, not a fixed ratio: mixed portrait and landscape detail shots
    then share a baseline instead of each setting its own box height.
  */
  .love-card__media {
    border-radius: var(--style-border-radius-inputs, 8px);
    overflow: hidden;
  }

  .love-card__image {
    display: block;
    width: 100%;
    height: var(--love-image-height, 210px);
    object-fit: cover;
  }

  .love-card__heading {
    margin: var(--margin-sm) 0 var(--margin-3xs);
    font-size: var(--font-size--md);
    font-weight: 600;
  }

  .love-card__text {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--sm);
    line-height: 1.55;
  }

  @media screen and (max-width: 749px) {
    /*
      One-and-a-bit cards on a phone: wide enough to read, with the next card
      clearly cut off so the swipe is obvious.
    */
    .product-love__grid {
      --love-peek: 26%;

      gap: var(--gap-sm);
    }

    /* Overrides the multi-column calc entirely: one card per view, plus the peek. */
    .love-card {
      flex-basis: calc(100% - var(--love-peek));
    }

    .love-card__image {
      height: calc(var(--love-image-height, 210px) * 0.9);
    }

    .love-card__text {
      font-size: var(--font-size--xs);
    }
  }

  /*
    Desktop: square images, uncropped. Two square cards across the full page
    would be ~550px tall at 1440, so the track is capped and centred under the
    centred heading: cards come out at 460px with the same two-and-a-peek view
    (2 full cards + the 18% peek) as before.
  */
  @media screen and (min-width: 990px) {
    .product-love__grid {
      max-width: 1140px;
      margin-inline: auto;
    }

    .love-card__image {
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why we love",
  "tag": "section",
  "class": "section-product-love",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Love"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards per view",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "info": "Desktop only. Phones always show one card plus the peek."
    },
    {
      "type": "range",
      "id": "peek",
      "label": "Next-card peek",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "%",
      "default": 18,
      "info": "How much of the following card stays visible, signalling the row can be swiped."
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 120,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 210
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Number the entries",
      "default": true,
      "info": "No longer used: entries are not numbered. Kept so saved settings stay valid."
    },
    {
      "type": "header",
      "content": "Content source"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "why_we_love_it_slides",
      "info": "A product metafield holding a list of Why we love it slide entries."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
