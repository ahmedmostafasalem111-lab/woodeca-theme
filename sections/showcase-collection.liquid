{% comment %}
  Collection page: breadcrumbs, title with result count, optional editorial line,
  optional hero banner, sub-category refinement row, the native-facet filter bar,
  a four-column product grid with an optional promo banner spliced into the flow,
  then "Show more" plus numbered pagination.

  This is one section rather than several because `{% paginate %}` has to wrap the
  grid, the promo insertion is positional within that loop, and the filter bar and
  grid share the same facet state.

  Products come from whichever collection the template renders, so nothing here is
  collection-specific — every editable field is a section setting.
{% endcomment %}

{% liquid
  assign per_page = section.settings.products_per_page | default: 24
  assign promo_after = section.settings.promo_after_products | default: 8
  assign show_promo = false
  if section.settings.show_promo and section.settings.promo_heading != blank
    assign show_promo = true
  endif

  # Sub-category tiles are read from the current collection, not from section blocks.
  assign sub_ns = section.settings.subcat_namespace | default: 'custom'
  assign sub_key = section.settings.subcat_key | default: 'subcollections'
  assign icon_ns = section.settings.subcat_icon_namespace | default: 'custom'
  assign icon_key = section.settings.subcat_icon_key | default: 'tile_icon'
  assign subcollections = collection.metafields[sub_ns][sub_key].value
%}

<div
  class="section-background"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
></div>

<showcase-collection-component
  class="section section--{{ section.settings.section_width }} showcase-collection spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
    --collection-columns: {{ section.settings.columns }};
    --collection-columns-mobile: {{ section.settings.columns_mobile }};
    --collection-title-size: {{ section.settings.title_size }};
    --collection-filters-button-background: {{ section.settings.filters_button_background | default: '#333333' }};
    --collection-filters-button-text: {{ section.settings.filters_button_text | default: '#ffffff' }};
    --collection-badge-background: {{ section.settings.badge_background | default: '#e8705a' }};
    --collection-badge-text: {{ section.settings.badge_text_color | default: '#ffffff' }};
    --collection-toggle-active: {{ section.settings.toggle_active_color | default: '#7ec8e8' }};
    --collection-toggle-active-bg: {{ section.settings.toggle_active_background | default: '#d6f0fa' }};
    --collection-tile-background: {{ section.settings.tile_background | default: '#ffffff' }};
  "
>
  {%- comment -%} ---------- Breadcrumbs ---------- {%- endcomment -%}
  {% if section.settings.show_breadcrumbs %}
    <nav
      class="collection-breadcrumbs"
      aria-label="{{ section.settings.breadcrumbs_label | default: 'Breadcrumb' | escape }}"
    >
      <a href="{{ routes.root_url }}">
        {{- section.settings.breadcrumb_home_label | default: 'Home' -}}
      </a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ collection.title }}</span>
    </nav>
  {% endif %}

  {%- comment -%} ---------- Title + result count ---------- {%- endcomment -%}
  <div class="collection-heading">
    <h1 class="collection-heading__title">{{ collection.title }}</h1>
    {% if section.settings.show_count %}
      <span class="collection-heading__count">
        {{- collection.products_count }} {{ section.settings.count_label | default: 'found' -}}
      </span>
    {% endif %}
  </div>

  {%- comment -%} ---------- Editorial line + read more ---------- {%- endcomment -%}
  {% if section.settings.show_editorial %}
    {% liquid
      assign editorial = section.settings.editorial_text
      if editorial == blank
        assign editorial = collection.description
      endif
    %}
    {% if editorial != blank %}
      <div class="collection-editorial">
        <span class="collection-editorial__text">{{ editorial | strip_html | truncate: 200 }}</span>

        {% if section.settings.editorial_link_text != blank and section.settings.editorial_link != blank %}
          <a
            href="{{ section.settings.editorial_link }}"
            class="collection-editorial__link"
          >
            <span>{{ section.settings.editorial_link_text }}</span>
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-chevron-right.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}
      </div>
    {% endif %}
  {% endif %}

  {%- comment -%} ---------- Hero banner ---------- {%- endcomment -%}
  {% if section.settings.show_banner %}
    {% liquid
      assign banner_image = section.settings.banner_image
      if banner_image == blank
        assign banner_image = collection.image
      endif
    %}
    {% if banner_image != blank %}
      <div
        class="collection-banner"
        style="--collection-banner-height: {{ section.settings.banner_height }}px;"
      >
        {{
          banner_image
          | image_url: width: 2400
          | image_tag: loading: 'eager', fetchpriority: 'high', class: 'collection-banner__image', alt: collection.title, sizes: '100vw', widths: '480, 750, 1000, 1400, 1920, 2400'
        }}
      </div>
    {% endif %}
  {% endif %}

  {%- comment -%}
    ---------- Sub-category refinement row ----------
    Driven by a list-of-collections metafield on the collection being viewed, so each
    category shows its own sub-categories instead of one hardcoded set repeated
    everywhere. The icon travels with each sub-collection via its own metafield.
    No metafield means no row — never a fallback to some other category's tiles.
  {%- endcomment -%}
  {% if subcollections != blank and subcollections.size > 0 %}
    <div class="collection-subcats">
      {% for subcollection in subcollections %}
        {% liquid
          assign sub_icon = subcollection.metafields[icon_ns][icon_key]
          if sub_icon.value != blank
            assign sub_icon_value = sub_icon.value
          else
            assign sub_icon_value = null
          endif
        %}
        <a
          href="{{ subcollection.url }}"
          class="collection-subcat"
        >
          <span class="collection-subcat__media">
            {% if sub_icon_value != null %}
              {{
                sub_icon_value
                | image_url: width: 200
                | image_tag: loading: 'lazy', class: 'collection-subcat__icon', alt: subcollection.title, sizes: '64px', widths: '64, 128, 192'
              }}
            {% else %}
              <span class="svg-wrapper collection-subcat__icon-fallback" aria-hidden="true">
                {{- 'icon-grid-default.svg' | inline_asset_content -}}
              </span>
            {% endif %}

            {% if section.settings.show_subcat_count %}
              <span class="collection-subcat__count">{{ subcollection.products_count }}</span>
            {% endif %}
          </span>

          <span class="collection-subcat__label">{{ subcollection.title }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {%- comment -%} ---------- Filter and sort bar ---------- {%- endcomment -%}
  {% render 'showcase-collection-filters', collection: collection, section: section %}

  {%- comment -%} ---------- Product grid + pagination ---------- {%- endcomment -%}
  {% paginate collection.products by per_page %}
    {% if collection.products.size == 0 %}
      <div class="collection-empty">
        <p>{{ section.settings.empty_text | default: 'No products match these filters.' }}</p>
        <a href="{{ collection.url }}" class="collection-empty__reset">
          {{- section.settings.clear_all_label | default: 'Clear all' -}}
        </a>
      </div>
    {% else %}
      <div
        class="collection-grid"
        ref="grid"
      >
        {% for product in collection.products %}
          <div
            class="collection-grid__item"
            data-grid-item
          >
            {% render 'showcase-product-card',
              product: product,
              stock_text: section.settings.card_stock_text,
              show_quick_add: section.settings.show_quick_add,
              show_swatches: section.settings.show_swatches,
              swatch_option_name: section.settings.swatch_option_name,
              swatch_limit: section.settings.swatch_limit,
              show_image_slider: section.settings.show_image_slider,
              slider_limit: section.settings.slider_limit,
              show_dimensions: section.settings.show_dimensions,
              dimensions_namespace: section.settings.dimensions_namespace,
              dimensions_key: section.settings.dimensions_key,
              dimensions_label: section.settings.dimensions_label
            %}
          </div>

          {%- comment -%}
            Promo banner is spliced into the grid flow after N products. It only
            appears on the first page so it stays a single mid-grid placement.
          {%- endcomment -%}
          {% if show_promo and paginate.current_page == 1 and forloop.index == promo_after %}
            {%- liquid
              assign promo_tag = 'div'
              if section.settings.promo_link != blank
                assign promo_tag = 'a'
              endif
            -%}
            <{{ promo_tag }}
              {% if promo_tag == 'a' %}href="{{ section.settings.promo_link }}"{% endif %}
              class="collection-promo"
              style="--collection-promo-span: {{ section.settings.promo_span }};"
            >
              {% if section.settings.promo_image != blank %}
                {{
                  section.settings.promo_image
                  | image_url: width: 1600
                  | image_tag: loading: 'lazy', class: 'collection-promo__image', alt: section.settings.promo_heading, sizes: '(min-width: 990px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1300, 1600'
                }}
              {% endif %}

              <span class="collection-promo__scrim" aria-hidden="true"></span>

              <span class="collection-promo__content">
                <span class="collection-promo__heading">{{ section.settings.promo_heading }}</span>
                {% if section.settings.promo_subtext != blank %}
                  <span class="collection-promo__subtext">{{ section.settings.promo_subtext }}</span>
                {% endif %}
                {% if section.settings.promo_link_text != blank %}
                  <span class="collection-promo__link">{{ section.settings.promo_link_text }}</span>
                {% endif %}
              </span>
            </{{ promo_tag }}>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%} ---------- Show more (AJAX append) ---------- {%- endcomment -%}
      {% if paginate.next %}
        <div
          class="collection-load-more"
          ref="loadMoreWrap"
        >
          <button
            type="button"
            class="collection-load-more__button"
            ref="loadMore"
            data-next-url="{{ paginate.next.url }}"
            data-loading-label="{{ section.settings.loading_label | default: 'Loading…' | escape }}"
            on:click="/loadMore"
          >
            {{- section.settings.show_more_label | default: 'Show more' -}}
          </button>
        </div>
      {% endif %}

      {%- comment -%} ---------- Numbered pagination ---------- {%- endcomment -%}
      {% render 'pagination-controls', paginate: paginate %}
    {% endif %}
  {% endpaginate %}
</showcase-collection-component>

<script
  src="{{ 'showcase-collection.js' | asset_url }}"
  type="module"
></script>

<script
  src="{{ 'showcase-card-cart.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- comment -%} Also drives the colour swatches, so it loads whenever either is on. {%- endcomment -%}
{% if section.settings.show_image_slider or section.settings.show_swatches %}
  <script
    src="{{ 'showcase-card-slider.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% stylesheet %}
  .collection-breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-3xs);
    margin-block-end: var(--margin-lg);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  .collection-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .collection-breadcrumbs a:hover {
    text-decoration: underline;
  }

  /* Title and count share a baseline. */
  .collection-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--gap-sm);
  }

  .collection-heading__title {
    margin: 0;
    font-size: var(--collection-title-size, var(--font-size--4xl));
    font-weight: 700;
    line-height: var(--line-height--heading-tight);
  }

  .collection-heading__count {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    font-size: var(--font-size--lg);
    font-weight: 400;
  }

  .collection-editorial {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
    margin-block-start: var(--margin-md);
    font-size: var(--font-size--md);
  }

  .collection-editorial__link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--collection-link-color, #3b7de0);
    text-decoration: none;
  }

  .collection-editorial__link:hover {
    text-decoration: underline;
  }

  .collection-editorial__link .svg-wrapper,
  .collection-editorial__link svg {
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
  }

  .collection-banner {
    margin-block-start: var(--margin-xl);
    border-radius: var(--style-border-radius-inputs, 8px);
    overflow: hidden;
  }

  .collection-banner__image {
    width: 100%;
    height: var(--collection-banner-height, 380px);
    object-fit: cover;
  }

  /* ---- Sub-category row: icon tiles on desktop ---- */
  .collection-subcats {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-md);
    margin-block-start: var(--margin-xl);
    padding-block-end: var(--padding-lg);
    border-block-end: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .collection-subcats::-webkit-scrollbar {
    display: none;
  }

  .collection-subcat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-2xs);
    flex: 0 0 auto;
    width: 120px;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .collection-subcat__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 76px;
  }

  .collection-subcat__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .collection-subcat__icon-fallback,
  .collection-subcat__icon-fallback svg {
    width: 48px;
    height: 48px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
  }

  /* Count sits superscript to the label, as in the reference. */
  .collection-subcat__count {
    position: absolute;
    top: 0;
    right: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    font-size: var(--font-size--2xs);
  }

  .collection-subcat__label {
    font-size: var(--font-size--sm);
    text-align: center;
    text-wrap: balance;
  }

  .collection-subcat:hover .collection-subcat__label {
    text-decoration: underline;
  }

  /* ---- Product grid ---- */
  /*
    Desktop: four across with 30px gaps (divan.ru's grid: ~295px cards at 1366).
    Below 990px: two across, edge to edge — only this grid leaves the page
    margin; the heading, tiles, filters and pagination keep theirs.
  */
  .collection-grid {
    /* Container so the promo can derive one column's width for its height. */
    container-type: inline-size;
    --collection-grid-cols: var(--collection-columns, 4);
    --collection-grid-col-gap: 30px;

    display: grid;
    grid-template-columns: repeat(var(--collection-columns, 4), minmax(0, 1fr));
    gap: 30px var(--collection-grid-col-gap);
  }

  .collection-grid__item {
    min-width: 0;
  }

  /*
    Hover lifts the card into an elevated panel that overlays its neighbours, so the
    swatch row and controls have room without reflowing the grid. Scoped to the
    collection grid — homepage and PDP carousels keep the flat card.
    Pointer/hover query so it never latches on touch.
  */
  @media (hover: hover) and (pointer: fine) {
    .collection-grid__item {
      position: relative;
    }

    .collection-grid__item:hover {
      z-index: var(--layer-raised, 5);
    }

    .collection-grid__item:hover .showcase-card {
      position: absolute;
      inset-inline: 0;
      top: 0;
      padding: var(--padding-sm);
      border-radius: var(--style-border-radius-inputs, 8px);
      background-color: var(--color-background, #fff);
      box-shadow: 0 6px 24px rgb(0 0 0 / 0.12);
    }
  }

  /* ---- Mid-grid promo banner ---- */
  /*
    Height matches the product IMAGE box, not the whole card, so the banner sits
    flush with the image row and the neighbouring titles and prices flow beneath it.
    The media is 1:1, so one column's width is exactly the image height.
  */
  .collection-promo {
    position: relative;
    grid-column: span var(--collection-promo-span, 2);
    align-self: start;
    display: block;
    height: calc(
      (100cqi - (var(--collection-grid-cols, 4) - 1) * var(--collection-grid-col-gap, 30px)) /
        var(--collection-grid-cols, 4)
    );
    border-radius: var(--style-border-radius-inputs, 8px);
    color: var(--collection-promo-text, #fff);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
  }

  .collection-promo__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-promo__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgb(0 0 0 / var(--opacity-60)), rgb(0 0 0 / var(--opacity-20)));
  }

  /* Fallback tint so the promo is legible before an image is picked. */
  .collection-promo:not(:has(.collection-promo__image)) .collection-promo__scrim {
    background: var(--collection-promo-fallback, #333);
  }

  .collection-promo__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-xs);
    height: 100%;
    padding: var(--padding-xl);
  }

  .collection-promo__heading {
    font-size: var(--font-size--2xl);
    font-weight: 700;
    line-height: var(--line-height--heading-tight);
    text-wrap: balance;
  }

  .collection-promo__subtext {
    font-size: var(--font-size--sm);
  }

  /* Underlined text link, matching the hero carousel treatment. */
  .collection-promo__link {
    margin-block-start: auto;
    font-size: var(--font-size--sm);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ---- Show more ---- */
  .collection-load-more {
    display: flex;
    justify-content: center;
    margin-block-start: var(--margin-2xl);
  }

  .collection-load-more__button {
    min-width: 240px;
    padding: var(--padding-md) var(--padding-2xl);
    border: var(--style-border-width-inputs) solid rgb(var(--color-foreground-rgb) / var(--opacity-25));
    border-radius: 999px;
    background-color: transparent;
    color: var(--color-foreground);
    font-size: var(--font-size--md);
    cursor: pointer;
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .collection-load-more__button:hover {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
  }

  .collection-load-more__button[aria-busy='true'] {
    opacity: var(--opacity-60);
    pointer-events: none;
  }

  .collection-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-sm);
    padding-block: var(--padding-5xl);
    text-align: center;
  }

  .collection-empty__reset {
    color: var(--color-foreground);
    font-size: var(--font-size--sm);
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .collection-grid {
      /* Keep the promo height calc in step with the column count. */
      --collection-grid-cols: var(--collection-columns-mobile, 2);
      --collection-grid-col-gap: 5px;

      /* Full row of the page grid = edge to edge, no side margin. */
      grid-column: 1 / -1;
      grid-template-columns: repeat(var(--collection-columns-mobile, 2), minmax(0, 1fr));
      gap: var(--gap-lg) var(--collection-grid-col-gap);
    }

    /* Text sits 10px in from the card edge now the card meets the screen edge
       (the cart button carries its own 10px on the right). */
    .collection-grid .showcase-card__info {
      padding-inline-start: 10px;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-heading__title {
      font-size: var(--font-size--2xl);
    }

    .collection-heading__count {
      font-size: var(--font-size--sm);
    }

    .collection-editorial {
      font-size: var(--font-size--sm);
    }

    .collection-banner__image {
      height: 200px;
    }

    /* Promo spans the full mobile grid width and sizes to its own content. */
    .collection-promo {
      grid-column: 1 / -1;
      height: auto;
      min-height: 160px;
    }

    .collection-promo__heading {
      font-size: var(--font-size--lg);
    }

    .collection-promo__content {
      padding: var(--padding-lg);
    }

    .collection-load-more__button {
      width: 100%;
    }

    /* Sub-categories collapse to compact pill/tag style per the mobile reference. */
    .collection-subcats {
      gap: var(--gap-2xs);
      padding-block-end: var(--padding-md);
    }

    .collection-subcat {
      flex-direction: row;
      align-items: center;
      gap: 4px;
      width: auto;
      padding: var(--padding-2xs) var(--padding-md);
      border-radius: 999px;
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
      white-space: nowrap;
    }

    /* Unwrap the media element so the count becomes a direct pill child,
       then drop the icon itself — the mobile reference shows label + count only. */
    .collection-subcat__media {
      display: contents;
    }

    .collection-subcat__icon,
    .collection-subcat__icon-fallback {
      display: none;
    }

    .collection-subcat__label {
      font-size: var(--font-size--xs);
    }

    .collection-subcat__count {
      position: static;
      align-self: flex-start;
      font-size: 9px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection page",
  "tag": "section",
  "class": "section-showcase-collection",
  "enabled_on": {
    "templates": ["collection", "search"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header area"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home_label",
      "label": "Breadcrumb home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumbs_label",
      "label": "Breadcrumb accessible label",
      "default": "Breadcrumb"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "var(--font-size--2xl)", "label": "Medium" },
        { "value": "var(--font-size--3xl)", "label": "Large" },
        { "value": "var(--font-size--4xl)", "label": "Extra large" },
        { "value": "var(--font-size--5xl)", "label": "Huge" }
      ],
      "default": "var(--font-size--4xl)"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show result count next to title",
      "default": true
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count label",
      "default": "found",
      "info": "Shown after the number, e.g. \"1083 found\"."
    },
    {
      "type": "header",
      "content": "Editorial line"
    },
    {
      "type": "checkbox",
      "id": "show_editorial",
