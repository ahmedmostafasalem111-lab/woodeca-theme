{% comment %}
  Page heading and a one-line intro, in the shared .section-title style. Used
  above app content such as the Judge.me All Reviews widget (page.reviews).
  Renders nothing when both are empty.
{% endcomment %}
{% if section.settings.heading != blank or section.settings.text != blank %}
  <div class="section section--page-width page-intro spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <div class="page-intro__inner">
      {% if section.settings.heading != blank %}
        <h1 class="page-intro__heading section-title">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="page-intro__text">{{ section.settings.text }}</p>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .page-intro__inner {
    text-align: start;
  }

  .page-intro__heading {
    margin: 0 0 8px;
  }

  .page-intro__text {
    margin: 0;
    max-width: 60ch;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--md);
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page intro",
  "tag": "section",
  "class": "section-page-intro",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "text", "id": "text", "label": "Intro", "default": "Real reviews from Woodeca customers across Egypt." },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Page intro" }]
}
{% endschema %}
