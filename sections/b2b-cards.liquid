{% comment %}
  Grey card grid (divan.ru/b2b "Плюсы" / "Этапы работы"): heading and
  subtitle, then cards in 3 (or 2) columns on desktop and one column on phones.
  Card style:
  - icon: outline icon top-left, bold title, small text;
  - number: a big muted "(01)", "(02)"… instead of the icon;
  - plain: title and text only.
  An optional pill button (usually #enquiry) and a small note follow.
  Nothing renders without cards.
{% endcomment %}
{%- render 'b2b-styles' -%}
{%- assign cards = section.blocks | where: 'type', 'card' -%}
{% if cards.size > 0 %}
  <div class="section section--page-width b2b-section{% if section.settings.band %} b2b-section--band{% endif %}">
    <div class="b2b-cards">
      {% if section.settings.heading != blank or section.settings.text != blank %}
        <div class="b2b-head">
          {% if section.settings.heading != blank %}
            <h2 class="b2b-head__title{% if section.settings.heading_size == 'md' %} b2b-head__title--md{% endif %}">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.text != blank %}
            <p class="b2b-head__text">{{ section.settings.text }}</p>
          {% endif %}
        </div>
      {% endif %}

      <ul class="b2b-cards__grid b2b-cards__grid--{{ section.settings.columns }}" role="list">
        {%- for block in cards -%}
          <li class="b2b-card b2b-cards__card b2b-cards__card--{{ section.settings.card_style }}" {{ block.shopify_attributes }}>
            {%- case section.settings.card_style -%}
              {%- when 'icon' -%}
                <span class="b2b-cards__icon" aria-hidden="true">{% render 'b2b-icon', name: block.settings.icon %}</span>
              {%- when 'number' -%}
                <span class="b2b-cards__number" aria-hidden="true">({% if forloop.index < 10 %}0{% endif %}{{ forloop.index }})</span>
            {%- endcase -%}
            {% if block.settings.title != blank %}
              <h3 class="b2b-cards__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="b2b-cards__text">{{ block.settings.text }}</p>
            {% endif %}
          </li>
        {%- endfor -%}
      </ul>

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <div class="b2b-actions">
          <a class="b2b-button" href="{{ section.settings.button_link }}" {% if section.settings.request_type != blank %}data-enquiry-request="{{ section.settings.request_type | escape }}"{% endif %}>
            {{- section.settings.button_label -}}
          </a>
          {% if section.settings.note != blank %}
            <p class="b2b-actions__note">{{ section.settings.note }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
  <script src="{{ 'b2b.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}

{% stylesheet %}
  .b2b-cards__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .b2b-cards__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
  }

  .b2b-cards__icon {
    display: inline-flex;
    width: 48px;
    height: 48px;
    margin-block-end: 22px;
    color: var(--color-foreground);
  }

  .b2b-cards__icon svg {
    width: 100%;
    height: 100%;
    --icon-stroke-width: 1px;
  }

  .b2b-cards__number {
    margin-block-end: 40px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-30, 0.3));
    font-size: 40px;
    font-weight: 400;
    line-height: 1;
  }

  .b2b-cards__title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
  }

  .b2b-cards__text {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.8));
    font-size: 14px;
    line-height: 1.5;
  }

  .b2b-cards__card--plain .b2b-cards__title {
    font-size: 18px;
  }

  @media screen and (min-width: 750px) {
    .b2b-cards__grid--2,
    .b2b-cards__grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .b2b-cards__grid {
      gap: 20px;
    }

    .b2b-cards__grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .b2b-cards__card {
      min-height: 267px;
      padding: 31px;
    }

    .b2b-cards__card--number {
      min-height: 313px;
    }

    .b2b-cards__card--plain {
      min-height: 287px;
      padding: 40px;
    }

    .b2b-cards__icon {
      width: 64px;
      height: 64px;
      margin-block-end: 36px;
    }

    .b2b-cards__number {
      margin-block-end: 72px;
      font-size: 64px;
    }

    .b2b-cards__title {
      font-size: 22px;
      font-weight: 500;
      line-height: 1.5;
    }

    .b2b-cards__text {
      font-size: 16px;
    }

    .b2b-cards__card--plain .b2b-cards__title {
      font-size: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "B2B cards",
  "tag": "section",
  "class": "section-b2b-cards",
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon (icon cards)",
          "options": [
            { "value": "factory", "label": "Factory" },
            { "value": "ruler", "label": "Ruler (sizes)" },
            { "value": "discount", "label": "Price tag" },
            { "value": "account", "label": "Person" },
            { "value": "chat", "label": "Chat" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "swatch", "label": "Swatches" },
            { "value": "store", "label": "Store" },
            { "value": "checkmark", "label": "Checkmark" }
          ],
          "default": "checkmark"
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "lg", "label": "Large (44px)" },
        { "value": "md", "label": "Medium (30px)" }
      ],
      "default": "lg"
    },
    { "type": "textarea", "id": "text", "label": "Subtitle" },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "number", "label": "Numbered steps" },
        { "value": "plain", "label": "Title and text" }
      ],
      "default": "icon"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "band", "label": "Grey band background", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "#enquiry scrolls to the form." },
    { "type": "text", "id": "request_type", "label": "Pre-select in the form", "info": "Optional: the enquiry form's request type to select when the button is used." },
    { "type": "text", "id": "note", "label": "Note under the button" }
  ],
  "presets": [{ "name": "B2B cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
