{% comment %}
  Three-row site header.

  Row 1 — utility bar: location + contact dropdowns on the left, audience links on
          the right.
  Row 2 — main row: logo, Catalog mega-menu pill, nav links, search, and the
          account / call / cart icons. This row is the one that stays
          pinned while the page scrolls.
  Row 3 — promo category link bar.

  On mobile all three collapse into a single condensed icon row, with search
  revealed by a disclosure rather than a separate overlay.

  Dropdown contents come from Shopify navigation menus (link_list settings) so
  merchants manage those links in Navigation rather than as nested blocks.
{% endcomment %}

{% liquid
  assign utility_left = section.blocks | where: 'type', 'utility_left'
  assign utility_right = section.blocks | where: 'type', 'utility_right'
  assign nav_links = section.blocks | where: 'type', 'nav_link'
  assign promo_links = section.blocks | where: 'type', 'promo_link'
%}

<div
  class="showcase-header"
  style="
    --showcase-header-background: {{ section.settings.background_color | default: '#ffffff' }};
    --showcase-header-text: {{ section.settings.text_color | default: '#1c1c1c' }};
    --showcase-utility-background: {{ section.settings.utility_background_color | default: '#fafafa' }};
    --showcase-utility-text: {{ section.settings.utility_text_color | default: '#5c5c5c' }};
    --showcase-utility-size: {{ section.settings.utility_font_size }};
    --showcase-promo-text: {{ section.settings.promo_text_color | default: '#1c1c1c' }};
    --showcase-promo-size: {{ section.settings.promo_font_size }};
    --showcase-nav-size: {{ section.settings.nav_font_size }};
    --showcase-search-background: {{ section.settings.search_background_color | default: '#f2f2f0' }};
    --showcase-logo-size: {{ section.settings.logo_font_size }};
    --showcase-call-background: {{ section.settings.call_background | default: '#e8262d' }};
    --showcase-call-text: {{ section.settings.call_text_color | default: '#ffffff' }};
    --showcase-cart-bubble-background: {{ section.settings.cart_bubble_background | default: '#e8705a' }};
    --showcase-cart-bubble-text: {{ section.settings.cart_bubble_text | default: '#ffffff' }};
  "
>
  {%- comment -%} ---------- Row 1: utility bar ---------- {%- endcomment -%}
  {% if section.settings.show_utility_bar %}
    <div class="showcase-header__utility">
      <div class="showcase-header__inner showcase-header__utility-inner">
        <div class="showcase-header__utility-group">
          {%- comment -%}
            Call-us pill sits in the far-left utility slot. Hidden entirely when no
            phone number is set, so it never renders as a dead link.
          {%- endcomment -%}
          {% if section.settings.show_call_button and section.settings.phone_number != blank %}
            {% assign call_href = section.settings.phone_number | remove: ' ' | remove: '(' | remove: ')' | remove: '-' %}
            <a
              href="tel:{{ call_href }}"
              class="showcase-header__call"
            >
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-phone-waves.svg' | inline_asset_content -}}
              </span>
              <span>{{ section.settings.call_label | default: 'Call Us' }}</span>
            </a>
          {% endif %}

          {% for block in utility_left %}
            {% if block.settings.menu != blank %}
              <details
                class="showcase-dropdown"
                {{ block.shopify_attributes }}
              >
                <summary class="showcase-dropdown__summary">
                  <span>{{ block.settings.label }}</span>
                  <span class="svg-wrapper showcase-dropdown__caret" aria-hidden="true">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </summary>
                <div class="showcase-dropdown__panel">
                  <ul class="showcase-dropdown__list">
                    {% for link in block.settings.menu.links %}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
              </details>
            {% else %}
              {%- liquid
                assign link_tag = 'span'
                if block.settings.link != blank
                  assign link_tag = 'a'
                endif
              -%}
              <{{ link_tag }}
                {% if link_tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
                class="showcase-header__utility-link"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label -}}
              </{{ link_tag }}>
            {% endif %}
          {% endfor %}
        </div>

        <div class="showcase-header__utility-group showcase-header__utility-group--end">
          {% for block in utility_right %}
            {% if block.settings.menu != blank %}
              <details
                class="showcase-dropdown"
                {{ block.shopify_attributes }}
              >
                <summary class="showcase-dropdown__summary">
                  <span>{{ block.settings.label }}</span>
                  <span class="svg-wrapper showcase-dropdown__caret" aria-hidden="true">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </summary>
                <div class="showcase-dropdown__panel showcase-dropdown__panel--end">
                  <ul class="showcase-dropdown__list">
                    {% for link in block.settings.menu.links %}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
              </details>
            {% else %}
              {%- liquid
                assign link_tag = 'span'
                if block.settings.link != blank
                  assign link_tag = 'a'
                endif
              -%}
              <{{ link_tag }}
                {% if link_tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
                class="showcase-header__utility-link"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label -}}
              </{{ link_tag }}>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {%- comment -%} ---------- Row 2: main row (sticky) ---------- {%- endcomment -%}
  <div class="showcase-header__main{% if section.settings.sticky_main_row %} showcase-header__main--sticky{% endif %}">
    <div class="showcase-header__inner showcase-header__main-inner">
      {%- comment -%}
        Mobile-only: full-height navigation drawer. Replaces the old <details>
        dropdown, which floated a flat mixed link list under the sticky header.
      {%- endcomment -%}
      {% render 'showcase-mobile-drawer', section: section %}

      {%- comment -%}
        Mobile-only: full-screen search. Replaces the old <details> panel, which
        dropped a bar over the page and left the page behind it competing for
        attention — and which also overflowed the viewport while closed.
      {%- endcomment -%}
      {% render 'showcase-search-overlay', section: section %}

      <a
        href="{{ routes.root_url }}"
        class="showcase-header__logo"
      >
        {% if section.settings.logo_image != blank %}
          {%- liquid
            # An SVG logo is served as-is at any requested width — this store's
            # is ~700 KB because it wraps a bitmap. Rasterise it to PNG
            # (transparency kept) at the sizes it is actually shown.
            assign logo = section.settings.logo_image
            assign logo_url = logo | image_url
            assign logo_format = ''
            if logo_url contains '.svg'
              assign logo_format = 'png'
            endif
          -%}
          <img
            class="showcase-header__logo-image"
            src="{% if logo_format != blank %}{{ logo | image_url: width: 320, format: logo_format }}{% else %}{{ logo | image_url: width: 320 }}{% endif %}"
            srcset="{% render 'showcase-srcset', image: logo, widths: '112,160,224,320,336,480', format: logo_format %}"
            sizes="(min-width: 990px) 160px, 112px"
            alt="{{ section.settings.logo_text | escape }}"
            {% if logo.width %}
              width="{{ logo.width }}"
              height="{{ logo.height }}"
            {% endif %}
          >
        {% else %}
          <span class="showcase-header__logo-text">{{ section.settings.logo_text }}</span>
        {% endif %}
      </a>

      {%- comment -%} Catalog mega-menu pill {%- endcomment -%}
      {% if section.settings.show_catalog_button %}
        <details class="showcase-catalog">
          <summary class="showcase-catalog__summary">
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-menu.svg' | inline_asset_content -}}
            </span>
            <span>{{ section.settings.catalog_label }}</span>
            <span class="svg-wrapper showcase-dropdown__caret" aria-hidden="true">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </summary>
          <div class="showcase-catalog__panel">
            {% if section.settings.catalog_menu != blank %}
              <ul class="showcase-catalog__grid">
                {% for link in section.settings.catalog_menu.links %}
                  <li class="showcase-catalog__column">
                    <a
                      href="{{ link.url }}"
                      class="showcase-catalog__column-title"
                    >
                      {{- link.title -}}
                    </a>

                    {% if link.links.size > 0 %}
                      <ul class="showcase-catalog__sublist">
                        {% for child in link.links %}
                          <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="showcase-dropdown__empty">{{ section.settings.dropdown_empty_text }}</p>
            {% endif %}
          </div>
        </details>
      {% endif %}

      {%- comment -%} Desktop nav links {%- endcomment -%}
      {% if nav_links.size > 0 %}
        <nav
          class="showcase-header__nav"
          aria-label="{{ section.settings.nav_label | default: 'Main navigation' | escape }}"
        >
          {% for block in nav_links %}
            {%- liquid
              assign link_tag = 'span'
              if block.settings.link != blank
                assign link_tag = 'a'
              endif
            -%}
            <{{ link_tag }}
              {% if link_tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
              class="showcase-header__nav-link"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label -}}
            </{{ link_tag }}>
          {% endfor %}
        </nav>
      {% endif %}

      {%- comment -%} Desktop search {%- endcomment -%}
      <div class="showcase-header__search-slot">
        {% render 'showcase-search-form', section: section, id_suffix: 'desktop' %}
      </div>

      {%- comment -%} Right-hand action icons {%- endcomment -%}
      <div class="showcase-header__actions">
        {% if section.settings.show_account %}
          <a
            href="{% if shop.customer_accounts_enabled %}{{ routes.account_url }}{% else %}{{ section.settings.account_link | default: '#' }}{% endif %}"
            class="showcase-header__icon-button showcase-header__icon-button--desktop"
            aria-label="{{ section.settings.account_label | default: 'Account' | escape }}"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-account.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}

        {%- comment -%} Phone sits between account and cart. {%- endcomment -%}
        {% if section.settings.show_phone and section.settings.phone_number != blank %}
          {% assign icon_call_href = section.settings.phone_number | remove: ' ' | remove: '(' | remove: ')' | remove: '-' %}
          <a
            href="tel:{{ icon_call_href }}"
            class="showcase-header__icon-button showcase-header__icon-button--desktop"
            aria-label="{{ section.settings.call_label | default: 'Call Us' | escape }}"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-phone-waves.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}

        {%- comment -%} Mobile-only chat + location icons, per the condensed layout {%- endcomment -%}
        {% if section.settings.show_mobile_chat and section.settings.mobile_chat_link != blank %}
          <a
            href="{{ section.settings.mobile_chat_link }}"
            class="showcase-header__icon-button showcase-header__icon-button--mobile"
            aria-label="{{ section.settings.mobile_chat_label | default: 'Chat' | escape }}"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-chat.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}

        {%- comment -%}
          Direct-dial button. The number is the one already set for the utility
          bar's Call Us pill, so there is a single place to change it, and the
          `tel:` href opens the dialer rather than routing through a page.
        {%- endcomment -%}
        {% if section.settings.show_mobile_call and section.settings.phone_number != blank %}
          {% assign mobile_call_href = section.settings.phone_number
            | remove: ' '
            | remove: '('
            | remove: ')'
            | remove: '-'
          %}
          <a
            href="tel:{{ mobile_call_href }}"
            class="showcase-header__icon-button showcase-header__icon-button--mobile"
            aria-label="{{ section.settings.call_label | default: 'Call Us' | escape }}"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-phone.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}

        {%- comment -%}
          Still a real link, so it works without JavaScript and can be opened in
          a new tab; the drawer script intercepts the plain click.
        {%- endcomment -%}
        <a
          href="{{ routes.cart_url }}"
          class="showcase-header__icon-button showcase-header__cart"
          data-cart-open
          aria-label="{{ section.settings.cart_label | default: 'Cart' | escape }}"
        >
          <span class="svg-wrapper" aria-hidden="true">
            {{- 'icon-cart.svg' | inline_asset_content -}}
          </span>

          {%- comment -%}
            Always rendered (hidden at zero) so the cart script can show and
            update it after any add, remove or quantity change without a reload.
          {%- endcomment -%}
          {% if section.settings.show_cart_count %}
            <span
              class="showcase-header__cart-count"
              {% if cart.item_count == 0 %}
                hidden
              {% endif %}
            >
              {{- cart.item_count -}}
            </span>
          {% endif %}
        </a>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Row 3: promo link bar ---------- {%- endcomment -%}
  {% if promo_links.size > 0 %}
    <div class="showcase-header__promo">
      <div class="showcase-header__inner showcase-header__promo-inner">
        {% for block in promo_links %}
          {%- liquid
            assign link_tag = 'span'
            if block.settings.link != blank
              assign link_tag = 'a'
            endif
          -%}
          <{{ link_tag }}
            {% if link_tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
            class="showcase-header__promo-link"
            {% if block.settings.highlight %}
              data-highlight="true"
            {% endif %}
            {% if block.settings.highlight and section.settings.promo_highlight_color != blank %}
              style="color: {{ section.settings.promo_highlight_color }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {{- block.settings.label -}}
          </{{ link_tag }}>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% if section.settings.sticky_main_row %}
  <script
    src="{{ 'showcase-header-sticky.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<script
  src="{{ 'showcase-search-overlay.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<script
  src="{{ 'showcase-search-desktop.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<script
  src="{{ 'showcase-mobile-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<script
  src="{{ 'showcase-header-menus.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% stylesheet %}
  .showcase-header {
    background-color: var(--showcase-header-background);
    color: var(--showcase-header-text);
  }

  .showcase-header__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  /* ---------- Row 1: utility ---------- */
  .showcase-header__utility {
    background-color: var(--showcase-utility-background);
    color: var(--showcase-utility-text);
    font-size: var(--showcase-utility-size, var(--font-size--xs));
  }

  .showcase-header__utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    min-height: 36px;
  }

  .showcase-header__utility-group {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
  }

  .showcase-header__utility-group--end {
    justify-content: flex-end;
  }

  .showcase-header__utility-link {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  /* An unlinked item renders as a span and shouldn't look clickable. */
  a.showcase-header__utility-link:hover {
    text-decoration: underline;
  }

  /* Solid brand pill in the far-left utility slot, replacing the old location picker. */
  .showcase-header__call {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
    padding: 6px var(--padding-sm);
    border-radius: 999px;
    background-color: var(--showcase-call-background);
    color: var(--showcase-call-text);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .showcase-header__call:hover {
    opacity: var(--opacity-90);
  }

  .showcase-header__call .svg-wrapper,
  .showcase-header__call svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    color: var(--showcase-call-text);
  }

  /* ---------- Shared disclosure dropdown ---------- */
  .showcase-dropdown {
    position: relative;
  }

  .showcase-dropdown__summary {
    display: flex;
    align-items: center;
    gap: var(--gap-3xs);
    color: inherit;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }

  .showcase-dropdown__summary::-webkit-details-marker {
    display: none;
  }

  .showcase-dropdown__caret {
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    transition: rotate var(--animation-speed) var(--animation-easing);
  }

  .showcase-dropdown[open] > .showcase-dropdown__summary .showcase-dropdown__caret {
    rotate: 180deg;
  }

  .showcase-dropdown__leading-icon {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .showcase-dropdown__panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: var(--layer-raised);
    min-width: 200px;
    padding: var(--padding-2xs);
    border-radius: var(--style-border-radius-popover, 8px);
    background-color: var(--color-background, #fff);
    box-shadow: var(--shadow-popover);
  }

  .showcase-dropdown__panel--end {
    left: auto;
    right: 0;
  }

  .showcase-dropdown__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .showcase-dropdown__list a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
    border-radius: 4px;
    color: var(--color-foreground);
    font-size: var(--font-size--sm);
    text-decoration: none;
  }

  .showcase-dropdown__list a:hover {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
  }

  .showcase-dropdown__empty {
    margin: 0;
    padding: var(--padding-xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  /* ---------- Row 2: main ---------- */
  .showcase-header__main {
    background-color: var(--showcase-header-background);
    border-block-end: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  /*
    Sticky lives on the header group, not the main row. A sticky element is bound to
    its parent's box, so pinning the row alone only held while the ~166px header was
    still on screen — it unstuck immediately.
  */
  #header-group:has(.showcase-header__main--sticky) {
    position: sticky;
    top: 0;
    z-index: var(--layer-sticky, 20);
  }

  /* Rows 1 and 3 collapse on scroll, leaving the main row pinned. */
  .showcase-header__utility,
  .showcase-header__promo {
    overflow: hidden;
    transition:
      max-height var(--animation-speed) var(--animation-easing),
      opacity var(--animation-speed) var(--animation-easing);
    max-height: 120px;
  }

  .showcase-header--stuck .showcase-header__utility,
  .showcase-header--stuck .showcase-header__promo {
    max-height: 0;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-header__utility,
    .showcase-header__promo {
      transition: none;
    }
  }

  .showcase-header__main-inner {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    min-height: 72px;
  }

  .showcase-header__logo {
    flex-shrink: 0;
    color: inherit;
    text-decoration: none;
  }

  .showcase-header__logo-text {
    font-size: var(--showcase-logo-size, var(--font-size--2xl));
    font-weight: 700;
    letter-spacing: var(--letter-spacing-sm);
  }

  .showcase-header__logo-image {
    display: block;
    width: auto;
    max-height: 40px;
  }

  /* Catalog pill */
  .showcase-catalog {
    position: relative;
    flex-shrink: 0;
  }

  .showcase-catalog__summary {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    padding: var(--padding-2xs) var(--padding-md);
    border: var(--style-border-width-inputs) solid rgb(var(--color-foreground-rgb) / var(--opacity-25));
    border-radius: 999px;
    color: inherit;
    font-size: var(--font-size--sm);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }

  .showcase-catalog__summary::-webkit-details-marker {
    display: none;
  }

  .showcase-catalog__summary .svg-wrapper,
  .showcase-catalog__summary svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  /* Full-width mega-menu panel. */
  .showcase-catalog__panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: var(--layer-raised);
    width: min(90vw, 900px);
    padding: var(--padding-lg);
    border-radius: var(--style-border-radius-popover, 8px);
    background-color: var(--color-background, #fff);
    box-shadow: var(--shadow-popover);
  }

  .showcase-catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--gap-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .showcase-catalog__column-title {
    display: block;
    margin-block-end: var(--margin-2xs);
    color: var(--color-foreground);
    font-size: var(--font-size--sm);
    font-weight: 600;
    text-decoration: none;
  }

  .showcase-catalog__sublist {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .showcase-catalog__sublist a {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--xs);
    text-decoration: none;
  }

  .showcase-catalog__sublist a:hover {
    color: var(--color-foreground);
    text-decoration: underline;
  }

  .showcase-header__nav {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    flex-shrink: 0;
  }

  .showcase-header__nav-link {
    color: inherit;
    font-size: var(--showcase-nav-size, var(--font-size--md));
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  a.showcase-header__nav-link:hover {
    text-decoration: underline;
  }

  .showcase-header__search-slot {
    flex-grow: 1;
    min-width: 0;
  }

  .showcase-header__actions {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    flex-shrink: 0;
  }

  .showcase-header__icon-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    list-style: none;
  }

  .showcase-header__icon-button::-webkit-details-marker {
    display: none;
  }

  .showcase-header__icon-button .svg-wrapper,
  .showcase-header__icon-button svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }

  .showcase-header__cart {
    position: relative;
  }

  .showcase-header__cart-count {
    position: absolute;
    top: 2px;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    border-radius: 999px;
    background-color: var(--showcase-cart-bubble-background);
    color: var(--showcase-cart-bubble-text);
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
  }

  /* `display: flex` above would otherwise win over the hidden attribute. */
  .showcase-header__cart-count[hidden] {
    display: none;
  }

  /* ---------- Row 3: promo bar ---------- */
  .showcase-header__promo-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-lg);
    min-height: 48px;
    padding-block: var(--padding-2xs);
  }

  .showcase-header__promo-link {
    color: var(--showcase-promo-text);
    font-size: var(--showcase-promo-size, var(--font-size--sm));
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  a.showcase-header__promo-link:hover {
    text-decoration: underline;
  }

  /* ---------- Mobile-only pieces, hidden on desktop ---------- */
  .showcase-header__drawer-trigger,
  .showcase-header__icon-button--mobile {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .showcase-header__utility,
    .showcase-header__promo,
    .showcase-header__nav,
    .showcase-catalog,
    .showcase-header__search-slot,
    .showcase-header__icon-button--desktop {
      display: none;
    }

    .showcase-header__drawer-trigger {
      display: flex;
      flex-shrink: 0;
    }

    .showcase-header__icon-button--mobile {
      display: flex;
    }

    .showcase-header__main-inner {
      gap: var(--gap-2xs);
      min-height: 56px;
    }

    /* Logo centres itself between the two icon clusters. */
    .showcase-header__logo {
      flex-grow: 1;
      text-align: center;
    }

    .showcase-header__logo-text {
      font-size: var(--font-size--lg);
    }

    .showcase-header__logo-image {
      margin-inline: auto;
      max-height: 28px;
    }

    .showcase-header__actions {
      gap: 0;
    }

    .showcase-header__icon-button {
      width: 36px;
      height: 36px;
    }

  }

  /* ---------- Mobile navigation drawer ---------- */
  /* Locks the page behind the drawer without shifting it. */
  .mobile-drawer-locked {
    overflow: hidden;
    touch-action: none;
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  /*
    Opens directly under the header rather than over it. `--drawer-top` is
    published by the drawer script from the header's measured bottom edge, so the
    offset follows the header as it collapses on scroll. The 0px fallback keeps
    the drawer usable if the script has not run yet.
  */
  .mobile-drawer {
    position: fixed;
    inset-block: var(--drawer-top, 0px) 0;
    inset-inline: 0;
    /* Below the header so it stays reachable, above everything else. */
    z-index: 2147482000;
  }

  .mobile-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0.5);
    opacity: 0;
    transition: opacity 240ms var(--animation-easing, ease);
  }

  .mobile-drawer--open .mobile-drawer__overlay {
    opacity: 1;
  }

  .mobile-drawer__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    display: flex;
    flex-direction: column;
    width: 88%;
    max-width: 420px;
    /* Fills the drawer box, which already stops short of the header. */
    height: 100%;
    background-color: #ffffff;
    translate: -100% 0;
    transition: translate 240ms var(--animation-easing, ease);
  }

  .mobile-drawer--open .mobile-drawer__panel {
    translate: 0 0;
  }

  /*
    Hamburger doubles as the close control. Both glyphs are in the markup and
    `aria-expanded` decides which shows, so the icon can never disagree with the
    drawer's real state.
  */
  .showcase-header__drawer-icon--close,
  .showcase-header__drawer-trigger[aria-expanded='true'] .showcase-header__drawer-icon--open {
    display: none;
  }

  .showcase-header__drawer-trigger[aria-expanded='true'] .showcase-header__drawer-icon--close {
    display: flex;
  }

  /* Panels stack here; sub views slide over the main one. */
  .mobile-drawer__views {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }

  .mobile-drawer__view {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    background-color: #ffffff;
  }

  .mobile-drawer__view--sub {
    translate: 100% 0;
    transition: translate 240ms var(--animation-easing, ease);
  }

  .mobile-drawer__view--sub.is-active {
    translate: 0 0;
  }

  /* Group separation: a thicker rule reads as a cluster break. */
  .mobile-drawer__group + .mobile-drawer__group {
    border-block-start: 8px solid rgb(0 0 0 / 0.05);
  }

  .mobile-drawer__group--flush + .mobile-drawer__group--flush,
  .mobile-drawer__group--flush {
    border-block-start: 0;
  }

  .mobile-drawer__row {
    display: flex;
    align-items: center;
    gap: 11px;
    width: 100%;
    min-height: 54px;
    padding: 0 16px;
    border: 0;
    border-block-end: 1px solid #e7e7e7;
    background: transparent;
    color: var(--color-foreground);
    font-size: 12.5px;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .mobile-drawer__row--drill {
    justify-content: space-between;
    font-weight: 600;
  }

  .mobile-drawer__row-label {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Fixed width keeps labels aligned whether or not an icon exists. */
  .mobile-drawer__row-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 30px;
    height: 28px;
  }

  .mobile-drawer__row-img {
    width: auto;
    height: auto;
    max-width: 26px;
    max-height: 26px;
    object-fit: contain;
  }

  .mobile-drawer__row-icon .svg-wrapper,
  .mobile-drawer__row-icon svg {
    width: 20px;
    height: 20px;
  }

  .mobile-drawer__chevron,
  .mobile-drawer__chevron svg {
    width: 12px;
    height: 12px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
  }

  /* Support contacts: heading plus icon rows, no trailing rule on the last row. */
  .mobile-drawer__help {
    padding-block-start: var(--padding-md);
  }

  .mobile-drawer__help-heading {
    margin: 0;
    padding: 0 16px var(--padding-2xs);
    font-size: 14px;
    font-weight: 700;
  }

  .mobile-drawer__row--help {
    min-height: 48px;
    font-weight: 500;
  }

  .mobile-drawer__row--help:last-child {
    border-block-end: 0;
  }

  .mobile-drawer__language {
    display: flex;
    align-items: center;
    padding: var(--padding-sm) 16px;
  }

  .mobile-drawer__locale-form {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .mobile-drawer__locale-select {
    padding: 4px 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 12.5px;
    cursor: pointer;
  }

  .mobile-drawer__subbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-block-end: 1px solid #e7e7e7;
    background-color: #f7f7f7;
  }

  .mobile-drawer__back {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .mobile-drawer__back .svg-wrapper,
  .mobile-drawer__back svg {
    width: 17px;
    height: 14px;
  }

  .mobile-drawer__subtitle {
    flex: 1 1 auto;
    /* Offset by the back button so the title sits optically centred. */
    margin-inline-end: 28px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer__panel,
    .mobile-drawer__overlay,
    .mobile-drawer__view--sub {
      transition: none;
    }
  }
{% endstylesheet %}

