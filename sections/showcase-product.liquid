{% comment %}
  Product hero, in the order the buy box reads top to bottom:

    gallery → styling-inspiration videos → discount badge → title → price row →
    instalment bar → assurances → delivery estimate → option pickers → stock →
    quantity → add to cart

  Every figure that could go stale is derived rather than authored: the discount
  percentage comes from the variant's own compare-at price, the instalment
  amounts from the variant price, and the delivery window from today plus the
  product's lead-time metafields.

  Option selection is resolved client-side against the variant matrix the option
  picker renders, with money already formatted by Liquid, so switching a variant
  costs no request and no currency formatting in JavaScript.

  The bottom-pinned buy bar is rendered at the end of this section so it sits
  above everything that follows it on the page.
{% endcomment %}

{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id

  # Metafield-driven extras. Namespace is configurable; each row hides when empty.
  assign ns = section.settings.metafield_namespace | default: 'custom'
  assign display_name = product.metafields[ns]['display_name'].value
  assign bonus_value = product.metafields[ns]['loyalty_bonus'].value
  assign series_name = product.metafields[ns]['series_name'].value
  assign series_link = product.metafields[ns]['series_link'].value
  assign collection_name = product.metafields[ns]['collection_name'].value
  assign collection_link = product.metafields[ns]['collection_link'].value

  # Set products (bedroom sets): the set builder replaces quantity + Add to cart.
  assign set_components = product.metafields.custom.set_components.value
  assign is_set = false
  if set_components != blank and set_components.size > 0
    assign is_set = true
  endif

  assign media_list = product.media | where: 'media_type', 'image'
  if media_list.size == 0
    assign media_list = product.images
  endif

  # Discount is derived, never authored: no compare-at price means no badge.
  assign has_compare = false
  assign save_percent = 0
  if selected_variant.compare_at_price > selected_variant.price
    assign has_compare = true
    assign price_gap = selected_variant.compare_at_price | minus: selected_variant.price
    assign save_percent = price_gap | times: 100.0 | divided_by: selected_variant.compare_at_price | round
  endif
%}

<showcase-product-component
  class="showcase-product"
  style="
    --product-cta-background: {{ section.settings.cta_background | default: '#333333' }};
    --product-cta-text: {{ section.settings.cta_text_color | default: '#ffffff' }};
    --product-gallery-background: {{ section.settings.gallery_background | default: '#f2f2f0' }};
    --product-accent: {{ section.settings.accent_color | default: '#e8342a' }};
    --product-instalment-background: {{ section.settings.instalment_background | default: '#f2f2f0' }};
    --product-title-size: {{ section.settings.title_size }};
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
  "
>
  <div class="section section--{{ section.settings.section_width }} showcase-product__body spacing-style"
    style="{% render 'spacing-padding', settings: section.settings %}"
  >
    {%- comment -%} Product + Offer + BreadcrumbList JSON-LD, in the server HTML. {%- endcomment -%}
    {% render 'product-structured-data', product: product %}

    {%- comment -%} ---------- Breadcrumbs ---------- {%- endcomment -%}
    {% if section.settings.show_breadcrumbs %}
      {%- liquid
        # The collection the customer came from (/collections/<handle>/products/<handle>,
        # linked from collection grids). Arriving directly (ads, search, homepage): the
        # product's main category by product type, never its family collection.
        assign crumb_collection = collection
        if crumb_collection == blank or crumb_collection.id == blank
          capture crumb_handle
            render 'product-category-handle', product: product
          endcapture
          assign crumb_handle = crumb_handle | strip
          assign crumb_collection = collections[crumb_handle]
        endif
      -%}
      <nav class="product-breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">
          {{- section.settings.breadcrumb_home_label | default: 'Home' -}}
        </a>
        {% if crumb_collection != blank and crumb_collection.id != blank %}
          <span aria-hidden="true">/</span>
          <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a>
        {% endif %}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ product.title }}</span>
      </nav>
    {% endif %}

    <div class="product-hero">
      {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
      <div class="product-gallery">
        <div class="product-gallery__rail">
          {% liquid
            # 0 (the default) shows every image; the rail scrolls when they
            # don't fit beside the main image.
            assign thumb_count = section.settings.thumb_limit | default: 0
            if thumb_count == 0
              assign thumb_count = media_list.size
            endif
          %}
          {% for image in media_list limit: thumb_count %}
            <button
              type="button"
              class="product-thumb{% if forloop.first %} product-thumb--active{% endif %}"
              ref="thumbs[]"
              data-media-id="{{ image.id }}"
              data-full="{{ image | image_url: width: 1200 }}"
              data-srcset="{% render 'showcase-srcset', image: image, widths: '160,600,750,900,1200,1600,2000' %}"
              data-alt="{{ image.alt | default: product.title | escape }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ section.settings.thumb_label | default: 'View image' | escape }} {{ forloop.index }}"
              on:click="/selectThumb"
            >
              {{ image | image_url: width: 260 | image_tag: loading: 'lazy', alt: '', sizes: '88px', widths: '90, 180, 260' }}
            </button>
          {% endfor %}
        </div>

        <div class="product-gallery__stage">
          {% if section.settings.show_share %}
            <button
              type="button"
              class="product-gallery__share"
              aria-label="{{ section.settings.share_label | default: 'Share' | escape }}"
              on:click="/share"
            >
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-share.svg' | inline_asset_content -}}
              </span>
            </button>
          {% endif %}

          {%- comment -%}
            Desktop: one swappable image. Written as a plain <img> so the `ref`
            the gallery/variant JS targets is guaranteed to be on the element.
          {%- endcomment -%}
          <div class="product-gallery__main">
            {% if media_list.size > 0 %}
              {%- comment -%}
                The desktop LCP image: loaded eagerly at high priority. It is
                hidden below 990px, where `sizes` resolves to 1px so phones only
                fetch the tiny candidate instead of a desktop-size file.
              {%- endcomment -%}
              <img
                ref="mainImage"
                class="product-gallery__image"
                src="{{ media_list[0] | image_url: width: 1200 }}"
                srcset="{% render 'showcase-srcset', image: media_list[0], widths: '160,600,750,900,1200,1600,2000' %}"
                sizes="(min-width: 990px) 45vw, 1px"
                alt="{{ media_list[0].alt | default: product.title | escape }}"
                width="{{ media_list[0].width }}"
                height="{{ media_list[0].height }}"
                loading="eager"
                fetchpriority="high"
              >
            {% elsif request.design_mode %}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'product-gallery__image' }}
            {% endif %}
          </div>

          {%- comment -%} Mobile: native swipe track with dot pagination. {%- endcomment -%}
          <div
            class="product-gallery__scroller"
            ref="scroller"
          >
            {% for image in media_list %}
              <div class="product-gallery__slide" ref="slides[]" data-media-id="{{ image.id }}">
                {%- comment -%}
                  The first slide is the mobile LCP image, so it is never lazy.
                  The second is a normal lazy image (the one a swipe reveals).
                  Slides 3+ keep their sources in data- attributes until the
                  customer swipes or picks a colour (showcase-product.js):
                  inside a horizontal track "lazy" alone doesn't hold them back.
                  On desktop the track is hidden and `sizes` drops to 1px.
                {%- endcomment -%}
                {%- liquid
                  if forloop.first
                    assign slide_loading = 'eager'
                    assign slide_priority = 'high'
                  else
                    assign slide_loading = 'lazy'
                    assign slide_priority = 'auto'
                  endif
                -%}
                {% if forloop.index <= 2 %}
                  <img
                    src="{{ image | image_url: width: 800 }}"
                    srcset="{% render 'showcase-srcset', image: image, widths: '160,400,600,800,1000,1200,1500' %}"
                    sizes="(max-width: 989px) calc(100vw - 32px), 1px"
                    alt="{{ image.alt | default: product.title | escape }}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    loading="{{ slide_loading }}"
                    fetchpriority="{{ slide_priority }}"
                  >
                {% else %}
                  <img
                    data-src="{{ image | image_url: width: 800 }}"
                    data-srcset="{% render 'showcase-srcset', image: image, widths: '160,400,600,800,1000,1200,1500' %}"
                    sizes="(max-width: 989px) calc(100vw - 32px), 1px"
                    data-alt="{{ image.alt | default: product.title | escape }}"
                    alt=""
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    loading="lazy"
                  >
                {% endif %}
              </div>
            {% endfor %}
          </div>

          {% if media_list.size > 1 %}
            <div class="product-gallery__dots">
              {% for image in media_list %}
                <span
                  class="gallery-dot{% if forloop.first %} gallery-dot--active{% endif %}"
                  ref="dots[]"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                ></span>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {%- comment -%}
          2 — Styling-inspiration circles. Sits under the gallery so it reads as
          part of the imagery on desktop and directly under the photo on mobile.
        {%- endcomment -%}
        {% render 'showcase-product-inspiration', product: product, section: section %}
      </div>

      {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
      <div class="product-buybox">
        {%- comment -%}
          3 — Discount badge, computed from the variant's own prices. There is no
          static label anywhere: no compare-at price means no badge.
        {%- endcomment -%}
        {%- comment -%}
          The product's own label (custom.product_label) sits right beside it,
          or alone in its place when there is no discount.
        {%- endcomment -%}
        <div class="product-badge-row">
          {% if save_percent > 0 %}
            <p class="product-save-badge" ref="saveBadge">
              {{ section.settings.save_badge_prefix | default: 'Save' }}
              <span ref="savePercent">{{ save_percent }}</span>%
            </p>
          {% else %}
            <p class="product-save-badge" ref="saveBadge" hidden>
              {{ section.settings.save_badge_prefix | default: 'Save' }}
              <span ref="savePercent"></span>%
            </p>
          {% endif %}
          {% render 'showcase-product-label', product: product, style: 'pill' %}
        </div>

        {%- comment -%} 4 — Title. {%- endcomment -%}
        {% if display_name != blank %}
          <h1 class="product-buybox__display-name">{{ display_name }}</h1>
          <p class="product-buybox__full-title">{{ product.title }}</p>
        {% else %}
          <h1 class="product-buybox__display-name">{{ product.title }}</h1>
        {% endif %}

        {%- comment -%}
          4b — Judge.me star rating, only for a product that has reviews, so the
          info block keeps its spacing everywhere else. Judge.me's own badge
          markup: the server-rendered stars from its metafield, which the
          Judge.me core app embed then takes over (tapping it jumps to the
          reviews widget further down the page). data-template matches what
          Judge.me's own badge app block outputs (as on the live theme); with
          "product" Judge.me's settings would hide it on product pages.
        {%- endcomment -%}
        {%- assign review_count = product.metafields.reviews.rating_count.value | default: 0 -%}
        {% if review_count > 0 %}
          <div
            class="product-buybox__rating jdgm-widget jdgm-preview-badge"
            data-id="{{ product.id }}"
            data-template="manual-installation"
          >
            {{- product.metafields.judgeme.badge -}}
          </div>
        {% endif %}

        {%- comment -%}
          5 — Price row: current price and the struck-through compare-at price on
          the same line, followed by the tax note.
        {%- endcomment -%}
        <div class="product-price-row">
          <span class="product-price-row__current" ref="priceTarget">
            {%- render 'showcase-money', amount: selected_variant.price -%}
          </span>
          <s
            class="product-price-row__compare"
            ref="compareTarget"
            {% unless has_compare %}hidden{% endunless %}
          >
            {%- render 'showcase-money', amount: selected_variant.compare_at_price -%}
          </s>
          {% if section.settings.tax_note != blank %}
            <span class="product-price-row__tax">{{ section.settings.tax_note }}</span>
          {% endif %}
        </div>

        {%- comment -%} 6 — Instalment bar and its modal. {%- endcomment -%}
        {% render 'showcase-product-installments',
          product: product,
          selected_variant: selected_variant,
          section: section
        %}

        {%- comment -%}
          7 — Info rows: the assurances with the delivery estimate (working days,
          Fridays skipped) slotted in after the first one, so they read
          Warranty → Delivery → Exchange & Return as one evenly spaced list.
        {%- endcomment -%}
        {%- capture delivery_row -%}
          {% render 'showcase-product-delivery-estimate', product: product, section: section %}
        {%- endcapture -%}
        {% render 'showcase-product-assurances', section: section, delivery: delivery_row %}

        {%- comment -%} 9 — Option pickers. {%- endcomment -%}
        {% render 'showcase-product-options',
          product: product,
          selected_variant: selected_variant,
          section: section
        %}

        {% if section.settings.show_stock_badge %}
          {% liquid
            assign stock_copy = ''
            if selected_variant.available
              if selected_variant.inventory_management == blank
                assign stock_copy = section.settings.in_stock_label | default: 'In stock'
              elsif selected_variant.inventory_quantity > section.settings.stock_threshold
                assign stock_copy = section.settings.high_stock_label | default: 'In stock: more than %count% pcs.' | replace: '%count%', section.settings.stock_threshold
              elsif selected_variant.inventory_quantity > 0
                assign stock_copy = section.settings.low_stock_label | default: 'In stock: %count% pcs.' | replace: '%count%', selected_variant.inventory_quantity
              else
                assign stock_copy = section.settings.in_stock_label | default: 'In stock'
              endif
            else
              assign stock_copy = section.settings.out_of_stock_label | default: 'Out of stock'
            endif
          %}
          <p
            class="product-buybox__stock"
            ref="stockTarget"
          >
            {{- stock_copy -}}
          </p>
        {% endif %}

        {%- comment -%} Loyalty line — metafield only, hidden when unset. {%- endcomment -%}
        {% if bonus_value != blank %}
          <p class="product-buybox__bonus">
            <span class="product-buybox__bonus-icon" aria-hidden="true">
              {{- 'icon-discount.svg' | inline_asset_content -}}
            </span>
            {{ section.settings.bonus_prefix | default: 'up to' }} {{ bonus_value }}
            {{ section.settings.bonus_suffix | default: 'bonuses' }}
          </p>
        {% endif %}

        {%- comment -%}
          10 — Quantity. Lives inside the form so its value posts with the add,
          and the buttons are wired through the component rather than inline JS.
          Set products get the set builder instead: Add to cart, the "Your set"
          box and the "Customise your set" drawer.
        {%- endcomment -%}
        {% if is_set %}
          {% render 'showcase-set-builder',
            product: product,
            selected_variant: selected_variant,
            section: section,
            components: set_components
          %}
        {% else %}
        <div class="product-buybox__actions">
          {% form 'product', product, id: form_id, class: 'product-buybox__form' %}
            <input
              type="hidden"
              name="id"
              value="{{ selected_variant.id }}"
              ref="variantInput"
            >

            <div class="product-quantity">
              <span class="product-quantity__label" id="Quantity-{{ section.id }}-label">
                {{- section.settings.quantity_label | default: 'Quantity' -}}
              </span>
              <div class="product-quantity__control">
                <button
                  type="button"
                  class="product-quantity__step"
                  data-quantity-step="-1"
                  aria-label="{{ section.settings.quantity_down_label | default: 'Decrease quantity' | escape }}"
                  on:click="/stepQuantity"
                >
                  <span class="svg-wrapper" aria-hidden="true">
                    {{- 'icon-minus.svg' | inline_asset_content -}}
                  </span>
                </button>
                <input
                  type="number"
                  class="product-quantity__input"
                  name="quantity"
                  ref="quantityInput"
                  value="1"
                  min="1"
                  step="1"
                  inputmode="numeric"
                  aria-labelledby="Quantity-{{ section.id }}-label"
                >
                <button
                  type="button"
                  class="product-quantity__step"
                  data-quantity-step="1"
                  aria-label="{{ section.settings.quantity_up_label | default: 'Increase quantity' | escape }}"
                  on:click="/stepQuantity"
                >
                  <span class="svg-wrapper" aria-hidden="true">
                    {{- 'icon-plus.svg' | inline_asset_content -}}
                  </span>
                </button>
              </div>
            </div>

            <button
              type="submit"
              name="add"
              class="product-buybox__add"
              ref="addButton"
              data-default-label="{{ section.settings.add_to_cart_label | default: 'Add to cart' | escape }}"
              data-sold-out-label="{{ section.settings.sold_out_label | default: 'Sold out' | escape }}"
              {% unless selected_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if selected_variant.available -%}
                {{ section.settings.add_to_cart_label | default: 'Add to cart' }}
              {%- else -%}
                {{ section.settings.sold_out_label | default: 'Sold out' }}
              {%- endif -%}
            </button>
          {% endform %}

        </div>
        {% endif %}

        {%- comment -%} ---------- Delivery teaser ---------- {%- endcomment -%}
        {% if section.settings.show_delivery_teaser %}
          <a
            href="#{{ section.settings.delivery_anchor | default: 'delivery-and-assembly' }}"
            class="product-delivery-teaser"
          >
            <span class="svg-wrapper product-delivery-teaser__icon" aria-hidden="true">
              {{- 'icon-truck.svg' | inline_asset_content -}}
            </span>
            <span class="product-delivery-teaser__text">
              <span class="product-delivery-teaser__title">
                {{- section.settings.delivery_anchor_label | default: 'Delivery and assembly' -}}
              </span>
              <span class="product-delivery-teaser__detail">
                {{- section.settings.delivery_teaser_text -}}
              </span>
            </span>
            <span class="svg-wrapper product-delivery-teaser__chevron" aria-hidden="true">
              {{- 'icon-chevron-right.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}

        {%- comment -%} ---------- Series / collection links (metafield only) ---------- {%- endcomment -%}
        {% if series_name != blank and series_link != blank %}
          <a href="{{ series_link }}" class="product-link-row">
            <span class="svg-wrapper product-link-row__icon" aria-hidden="true">
              {{- 'icon-grid-default.svg' | inline_asset_content -}}
            </span>
            <span class="product-link-row__text">
              <span class="product-link-row__label">
                {{- section.settings.series_row_label | default: 'All products in the series' -}}
              </span>
              <span class="product-link-row__value">{{ series_name }}</span>
            </span>
            <span class="svg-wrapper product-link-row__arrow" aria-hidden="true">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}

        {% if collection_name != blank and collection_link != blank %}
          <a href="{{ collection_link }}" class="product-link-row">
            <span class="svg-wrapper product-link-row__icon" aria-hidden="true">
              {{- 'icon-store.svg' | inline_asset_content -}}
            </span>
            <span class="product-link-row__text">
              <span class="product-link-row__label">
                {{- section.settings.collection_row_label | default: 'All products in the collection' -}}
              </span>
              <span class="product-link-row__value">{{ collection_name }}</span>
            </span>
            <span class="svg-wrapper product-link-row__arrow" aria-hidden="true">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  {%- comment -%}
    Sticky bar lives at the end of the component so it shares refs with the hero
    and pins above every following section.
  {%- endcomment -%}
  {% if section.settings.show_sticky_bar %}
    {% render 'showcase-product-sticky-bar',
      product: product,
      selected_variant: selected_variant,
      section: section,
      form_id: form_id,
      set_builder: is_set
    %}
  {% endif %}
</showcase-product-component>

<script
  src="{{ 'showcase-product.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .showcase-product {
    display: block;
  }

  .product-breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-3xs);
    margin-block-end: var(--margin-lg);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  .product-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .product-breadcrumbs a:hover {
    text-decoration: underline;
  }

  .product-hero {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: var(--gap-2xl);
    align-items: start;
  }

  /* ---- Gallery ---- */
  .product-gallery {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--gap-sm);
  }

  /*
    Exactly as tall as the main image (`height: 0` keeps it out of the row's
    sizing, `min-height: 100%` then fills the row), scrolling when a product
    has more thumbnails than fit. A thin scrollbar shows that it scrolls.
  */
  .product-gallery__rail {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    height: 0;
    min-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground-rgb) / var(--opacity-20)) transparent;
  }

  .product-thumb {
    flex-shrink: 0;
    padding: 0;
    border: var(--border-width-md) solid transparent;
    border-radius: 4px;
    background-color: var(--product-gallery-background);
    cursor: pointer;
    overflow: hidden;
  }

  .product-thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .product-thumb--active {
    border-color: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  .product-gallery__stage {
    position: relative;
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: var(--product-gallery-background);
    overflow: hidden;
  }

  .product-gallery__share {
    position: absolute;
    top: var(--padding-sm);
    right: var(--padding-sm);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .product-gallery__share .svg-wrapper,
  .product-gallery__share svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .product-gallery__image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* Mobile swipe track is hidden on desktop, where the thumb rail drives swapping. */
  .product-gallery__scroller,
  .product-gallery__dots {
    display: none;
  }

  /* ---- Buy box ---- */
  .product-buybox {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
  }

  /*
    Info block sizing (badge → title → price → instalments → info rows → Color),
    after ricracshop.com's product page at 375px, scaled up from 990px. The buy
    box's 12px gap stays; the spacing inside this block is set with margins on
    top of it: badge→title 8, title→price 12, price→instalments 12,
    instalments→info rows 20, rows 8 apart, last row→Color 20.
  */
  .product-buybox__display-name {
    margin: 0;
    font-size: 19.6px;
    font-weight: 700;
    line-height: 1.35;
  }

  @media screen and (min-width: 990px) {
    .product-buybox__display-name {
      font-size: 22px;
    }
  }

  /* Stars sit 6px under the title (12px buy-box gap − 6) and keep the 12px to the price. */
  .product-buybox__rating {
    margin-block-start: -6px;
    font-size: var(--font-size--sm);
    line-height: 1.4;
  }

  .product-buybox__full-title {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--md);
  }

  .product-buybox__stock {
    margin: 0;
    padding: var(--padding-3xs) var(--padding-sm);
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
    font-size: var(--font-size--xs);
  }

  .product-buybox__bonus {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin: 0;
    font-size: var(--font-size--sm);
  }

  .product-buybox__bonus-icon,
  .product-buybox__bonus-icon svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  /* ---- Discount badge + product label ---- */
  .product-badge-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    /* 12px buy-box gap − 4 = 8px to the title (nothing when the row is hidden). */
    margin-block-end: -4px;
  }

  /* Neither a discount nor a label: no row, no gap. */
  .product-badge-row:not(:has(> :not([hidden]))) {
    display: none;
  }

  /* The label pill is the badge's twin: same height, shape, size and weight. */
  .product-save-badge,
  .product-label--pill {
    flex: 0 0 auto;
    margin: 0;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.4;
  }

  @media screen and (min-width: 990px) {
    .product-badge-row {
      margin-block-end: -3px;
    }

    .product-save-badge,
    .product-label--pill {
      padding: 3px 9px;
      font-size: 14px;
    }
  }

  .product-label--pill {
    flex-shrink: 1;
  }

  .product-save-badge {
    background-color: var(--product-accent, #e8342a);
    color: #ffffff;
  }

  .product-save-badge[hidden] {
    display: none;
  }

  /* ---- Price row ---- */
  .product-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--gap-2xs) var(--gap-sm);
  }

  .product-price-row__current {
    color: var(--product-accent, #e8342a);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.1;
  }

  .product-price-row__compare {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
  }

  .product-price-row__compare[hidden] {
    display: none;
  }

  .product-price-row__tax {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.2;
  }

  @media screen and (min-width: 990px) {
    .product-price-row__current {
      font-size: 18px;
    }

    .product-price-row__compare {
      font-size: 17px;
    }

    .product-price-row__tax {
      font-size: 15px;
    }
  }

  /* ---- Quantity ---- */
  .product-quantity {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    margin-block-end: var(--margin-md);
  }

  .product-quantity__label {
    font-size: var(--font-size--sm);
    font-weight: 500;
  }

  .product-quantity__control {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: 6px;
    overflow: hidden;
  }

  .product-quantity__step {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .product-quantity__step svg {
    width: 14px;
    height: 14px;
  }

  .product-quantity__input {
    width: 44px;
    height: 38px;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    font-size: var(--font-size--sm);
    text-align: center;
    /* Spinners duplicate the buttons either side of the field. */
    appearance: textfield;
  }

  .product-quantity__input::-webkit-outer-spin-button,
  .product-quantity__input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  /* Spans both gallery tracks so the video row is not squeezed into the rail. */
  .product-gallery .product-inspiration {
    grid-column: 1 / -1;
  }

  .product-buybox__actions {
    display: flex;
    align-items: end;
    gap: var(--gap-sm);
    width: 100%;
    margin-block-start: var(--margin-sm);
  }

  /*
    `min-width: 0` is what stops this row overflowing: a flex item's default
    `min-width: auto` refuses to shrink below its content.
  */
  .product-buybox__form {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
  }

  .product-buybox__add {
    width: 100%;
    padding: var(--padding-lg) var(--padding-2xl);
    border: none;
    border-radius: var(--style-border-radius-buttons-primary, 4px);
    background-color: var(--product-cta-background);
    color: var(--product-cta-text);
    font-size: var(--font-size--md);
    font-weight: 600;
    cursor: pointer;
  }

  .product-buybox__add:disabled {
    opacity: var(--opacity-50);
    cursor: not-allowed;
  }

  /* ---- Delivery teaser + link rows ---- */
  .product-delivery-teaser,
  .product-link-row {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    width: 100%;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .product-delivery-teaser {
    padding-block: var(--padding-md);
    border-block-end: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .product-link-row {
    margin-block-start: var(--margin-2xs);
    padding: var(--padding-md);
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .product-delivery-teaser__icon,
  .product-delivery-teaser__icon svg,
  .product-link-row__icon,
  .product-link-row__icon svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    flex-shrink: 0;
  }

  .product-delivery-teaser__text,
  .product-link-row__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
    min-width: 0;
  }

  .product-delivery-teaser__title,
  .product-link-row__label {
    font-size: var(--font-size--md);
    font-weight: 600;
  }

  .product-delivery-teaser__detail {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  .product-link-row__value {
    color: var(--product-link-accent, #b8813f);
    font-size: var(--font-size--sm);
  }

  .product-delivery-teaser__chevron,
  .product-delivery-teaser__chevron svg,
  .product-link-row__arrow,
  .product-link-row__arrow svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    flex-shrink: 0;
  }

  /* ---- Responsive ---- */
  @media screen and (max-width: 989px) {
    .product-hero {
      grid-template-columns: 1fr;
      gap: var(--gap-lg);
    }

    /* Thumb rail and the static main image give way to the swipe track. */
    .product-gallery {
      grid-template-columns: 1fr;
    }

    .product-gallery__rail,
    .product-gallery__main {
      display: none;
    }

    .product-gallery__scroller {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .product-gallery__scroller::-webkit-scrollbar {
      display: none;
    }

    .product-gallery__slide {
      flex: 0 0 100%;
      scroll-snap-align: center;
    }

    .product-gallery__slide img {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: contain;
      mix-blend-mode: multiply;
    }

    .product-gallery__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding-block: var(--padding-sm);
    }

    .gallery-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-25));
    }

    .gallery-dot--active {
      background-color: var(--color-foreground);
    }

    .product-buybox__display-name {
      font-size: 19.6px;
    }

    .product-price-row__current {
      font-size: 16px;
    }

    /*
      The bottom-pinned buy bar carries Add To Cart and Buy It Now on mobile, so
      the in-page pair is redundant here. Desktop keeps them, because there the
      bar sits below the hero and is off screen when the page first loads.

      Hidden rather than removed from the markup: the form still has to exist for
      the bar's buttons to submit through, and the quantity field posts with it.
    */
    .product-buybox__actions .product-buybox__add {
      display: none;
    }

    .product-quantity {
      margin-block-end: 0;
    }

    /* Leaves room for the fixed buy bar so the last row is never covered. */
    .showcase-product__body {
      padding-block-end: calc(var(--mobile-sticky-bar-height, 72px) + var(--padding-lg));
    }
  }
{% endstylesheet %}

