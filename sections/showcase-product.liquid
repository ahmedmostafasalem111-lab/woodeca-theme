{% comment %}
  Product hero: breadcrumbs, thumbnail gallery + main image, buy box, the
  variant swatch-card picker, a delivery teaser, and series/collection links.
  The sticky mini-bar is rendered at the end of this section so it pins above
  everything that follows.

  Variant selection uses the product's native Color option. Each swatch card
  carries its variant's image, formatted price, availability and stock copy, so
  selection swaps in place with no request and no client-side money formatting.

  Metafield-driven rows (series, collection, loyalty bonus, instalments) render
  only when their metafield has a value.
{% endcomment %}

{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id

  assign colour_option = null
  for product_option in product.options_with_values
    assign option_name_down = product_option.name | downcase
    assign wanted_down = section.settings.variant_option_name | default: 'Color' | downcase
    if option_name_down == wanted_down
      assign colour_option = product_option
    endif
  endfor

  # Metafield-driven extras. Namespace is configurable; each row hides when empty.
  assign ns = section.settings.metafield_namespace | default: 'custom'
  assign display_name = product.metafields[ns]['display_name'].value
  assign bonus_value = product.metafields[ns]['loyalty_bonus'].value
  assign instalment_value = product.metafields[ns]['instalment_amount'].value
  assign series_name = product.metafields[ns]['series_name'].value
  assign series_link = product.metafields[ns]['series_link'].value
  assign collection_name = product.metafields[ns]['collection_name'].value
  assign collection_link = product.metafields[ns]['collection_link'].value

  assign media_list = product.media | where: 'media_type', 'image'
  if media_list.size == 0
    assign media_list = product.images
  endif
%}

<showcase-product-component
  class="showcase-product"
  style="
    --product-cta-background: {{ section.settings.cta_background | default: '#333333' }};
    --product-cta-text: {{ section.settings.cta_text_color | default: '#ffffff' }};
    --product-gallery-background: {{ section.settings.gallery_background | default: '#f2f2f0' }};
    --product-title-size: {{ section.settings.title_size }};
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
  "
>
  <div class="section section--{{ section.settings.section_width }} showcase-product__body spacing-style"
    style="{% render 'spacing-padding', settings: section.settings %}"
  >
    {%- comment -%} ---------- Breadcrumbs ---------- {%- endcomment -%}
    {% if section.settings.show_breadcrumbs %}
      <nav class="product-breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">
          {{- section.settings.breadcrumb_home_label | default: 'Online store' }} {{ shop.name -}}
        </a>
        {% if collection != blank %}
          <span aria-hidden="true">/</span>
          <a href="{{ collection.url }}">{{ collection.title }}</a>
        {% endif %}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ product.title }}</span>
      </nav>
    {% endif %}

    <div class="product-hero">
      {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
      <div class="product-gallery">
        <div class="product-gallery__rail">
          {% for image in media_list limit: section.settings.thumb_limit %}
            <button
              type="button"
              class="product-thumb{% if forloop.first %} product-thumb--active{% endif %}"
              ref="thumbs[]"
              data-full="{{ image | image_url: width: 1400 }}"
              data-alt="{{ image.alt | default: product.title | escape }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ section.settings.thumb_label | default: 'View image' | escape }} {{ forloop.index }}"
              on:click="/selectThumb"
            >
              {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {% endfor %}
        </div>

        <div class="product-gallery__stage">
          {% if section.settings.show_share %}
            <button
              type="button"
              class="product-gallery__share"
              aria-label="{{ section.settings.share_label | default: 'Share' | escape }}"
              on:click="/share"
            >
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-share.svg' | inline_asset_content -}}
              </span>
            </button>
          {% endif %}

          {%- comment -%}
            Desktop: one swappable image. Written as a plain <img> so the `ref`
            the gallery/variant JS targets is guaranteed to be on the element.
          {%- endcomment -%}
          <div class="product-gallery__main">
            {% if media_list.size > 0 %}
              <img
                ref="mainImage"
                class="product-gallery__image"
                src="{{ media_list[0] | image_url: width: 1400 }}"
                alt="{{ product.title | escape }}"
                width="{{ media_list[0].width }}"
                height="{{ media_list[0].height }}"
                loading="eager"
              >
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'product-gallery__image' }}
            {% endif %}
          </div>

          {%- comment -%} Mobile: native swipe track with dot pagination. {%- endcomment -%}
          <div
            class="product-gallery__scroller"
            ref="scroller"
          >
            {% for image in media_list %}
              <div class="product-gallery__slide">
                {{
                  image
                  | image_url: width: 1200
                  | image_tag: loading: 'lazy', alt: product.title
                }}
              </div>
            {% endfor %}
          </div>

          {% if media_list.size > 1 %}
            <div class="product-gallery__dots">
              {% for image in media_list %}
                <span
                  class="gallery-dot{% if forloop.first %} gallery-dot--active{% endif %}"
                  ref="dots[]"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                ></span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
      <div class="product-buybox">
        {% if display_name != blank %}
          <h1 class="product-buybox__display-name">{{ display_name }}</h1>
          <p class="product-buybox__full-title">{{ product.title }}</p>
        {% else %}
          <h1 class="product-buybox__display-name">{{ product.title }}</h1>
        {% endif %}

        {% if section.settings.show_stock_badge %}
          {% liquid
            assign stock_copy = ''
            if selected_variant.available
              if selected_variant.inventory_management == blank
                assign stock_copy = section.settings.in_stock_label | default: 'In stock'
              elsif selected_variant.inventory_quantity > section.settings.stock_threshold
                assign stock_copy = section.settings.high_stock_label | default: 'In stock: more than %count% pcs.' | replace: '%count%', section.settings.stock_threshold
              elsif selected_variant.inventory_quantity > 0
                assign stock_copy = section.settings.low_stock_label | default: 'In stock: %count% pcs.' | replace: '%count%', selected_variant.inventory_quantity
              else
                assign stock_copy = section.settings.in_stock_label | default: 'In stock'
              endif
            else
              assign stock_copy = section.settings.out_of_stock_label | default: 'Out of stock'
            endif
          %}
          <p
            class="product-buybox__stock"
            ref="stockTarget"
          >
            {{- stock_copy -}}
          </p>
        {% endif %}

        {%- comment -%} Loyalty line — metafield only, hidden when unset. {%- endcomment -%}
        {% if bonus_value != blank %}
          <p class="product-buybox__bonus">
            <span class="product-buybox__bonus-icon" aria-hidden="true">
              {{- 'icon-discount.svg' | inline_asset_content -}}
            </span>
            {{ section.settings.bonus_prefix | default: 'up to' }} {{ bonus_value }}
            {{ section.settings.bonus_suffix | default: 'bonuses' }}
          </p>
        {% endif %}

        <div
          class="product-buybox__price"
          ref="priceTarget"
        >
          {{ selected_variant.price | money }}
        </div>

        {%- comment -%} Instalments line — metafield only, hidden when unset. {%- endcomment -%}
        {% if instalment_value != blank %}
          <p class="product-buybox__instalment">
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-card.svg' | inline_asset_content -}}
            </span>
            <span>
              {{- instalment_value }} {{ section.settings.instalment_suffix | default: 'per month with' }}
              {{ section.settings.instalment_provider | default: 'instalments' -}}
            </span>
          </p>
        {% endif %}

        <div class="product-buybox__actions">
          {% form 'product', product, id: form_id, class: 'product-buybox__form' %}
            <input
              type="hidden"
              name="id"
              value="{{ selected_variant.id }}"
              ref="variantInput"
            >
            <button
              type="submit"
              name="add"
              class="product-buybox__add"
              ref="addButton"
              data-default-label="{{ section.settings.add_to_cart_label | default: 'Add to cart' | escape }}"
              data-sold-out-label="{{ section.settings.sold_out_label | default: 'Sold out' | escape }}"
              {% unless selected_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if selected_variant.available -%}
                {{ section.settings.add_to_cart_label | default: 'Add to cart' }}
              {%- else -%}
                {{ section.settings.sold_out_label | default: 'Sold out' }}
              {%- endif -%}
            </button>
          {% endform %}

          <button
            type="button"
            class="wishlist-button"
            ref="wishlistButtons[]"
            data-wishlist
            aria-pressed="false"
            aria-label="{{ section.settings.wishlist_label | default: 'Add to wishlist' | escape }}"
            on:click="/toggleWishlist"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-heart.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        {%- comment -%} ---------- Variant swatch cards ---------- {%- endcomment -%}
        {% if colour_option != null and colour_option.values.size > 1 %}
          <details class="variant-picker" open>
            <summary class="variant-picker__summary">
              <span class="variant-picker__label">
                {{ colour_option.name }}
                <span class="variant-picker__count">({{ colour_option.values.size }})</span>
              </span>

              <span class="variant-picker__current">
                {% if selected_variant.featured_image != blank %}
                  <span class="variant-picker__current-swatch" aria-hidden="true"></span>
                {% endif %}
                {{ selected_variant.title }}
                <span class="svg-wrapper variant-picker__caret" aria-hidden="true">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </span>
            </summary>

            <div class="variant-picker__body">
              {% if section.settings.show_in_stock_toggle %}
                <span class="variant-picker__filter">
                  <span class="variant-toggle" aria-hidden="true">
                    <span class="variant-toggle__knob"></span>
                  </span>
                  <span>{{ section.settings.in_stock_filter_label | default: 'In stock' }}</span>
                </span>
              {% endif %}

              <div class="variant-picker__header">
                <span class="variant-picker__group-name">
                  {{- section.settings.variant_group_label | default: 'Basic collection' -}}
                </span>
                <span class="variant-picker__from">
                  {{ section.settings.from_label | default: 'From' }} {{ product.price_min | money }}
                </span>
              </div>

              <div class="variant-picker__cards">
                {% for variant in product.variants %}
                  {% liquid
                    assign variant_image = variant.featured_image | default: product.featured_image

                    assign variant_stock = section.settings.in_stock_label | default: 'In stock'
                    unless variant.available
                      assign variant_stock = section.settings.out_of_stock_label | default: 'Out of stock'
                    endunless

                    capture variant_price_html
                      echo variant.price | money
                    endcapture
                  %}
                  <button
                    type="button"
                    class="variant-card{% if variant.id == selected_variant.id %} variant-card--active{% endif %}"
                    ref="variantCards[]"
                    data-variant-id="{{ variant.id }}"
                    data-price-html="{{ variant_price_html | escape }}"
                    data-stock-text="{{ variant_stock | escape }}"
                    data-available="{{ variant.available }}"
                    {% if variant_image != blank %}
                      data-image="{{ variant_image | image_url: width: 1400 }}"
                    {% endif %}
                    aria-current="{% if variant.id == selected_variant.id %}true{% else %}false{% endif %}"
                    on:click="/selectVariant"
                  >
                    <span class="variant-card__media">
                      {% if variant_image != blank %}
                        {{ variant_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: variant.title }}
                      {% endif %}
                    </span>
                    <span class="variant-card__name">{{ variant.title }}</span>
                    <span class="variant-card__price">{{ variant.price | money }}</span>
                  </button>
                {% endfor %}
              </div>
            </div>
          </details>
        {% endif %}

        {%- comment -%} ---------- Delivery teaser ---------- {%- endcomment -%}
        {% if section.settings.show_delivery_teaser %}
          <a
            href="#{{ section.settings.delivery_anchor | default: 'delivery-and-assembly' }}"
            class="product-delivery-teaser"
          >
            <span class="svg-wrapper product-delivery-teaser__icon" aria-hidden="true">
              {{- 'icon-truck.svg' | inline_asset_content -}}
            </span>
            <span class="product-delivery-teaser__text">
              <span class="product-delivery-teaser__title">
                {{- section.settings.delivery_anchor_label | default: 'Delivery and assembly' -}}
              </span>
              <span class="product-delivery-teaser__detail">
                {{- section.settings.delivery_teaser_text -}}
              </span>
            </span>
            <span class="svg-wrapper product-delivery-teaser__chevron" aria-hidden="true">
              {{- 'icon-chevron-right.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}

        {%- comment -%} ---------- Series / collection links (metafield only) ---------- {%- endcomment -%}
        {% if series_name != blank %}
          <a href="{{ series_link | default: '#' }}" class="product-link-row">
            <span class="svg-wrapper product-link-row__icon" aria-hidden="true">
              {{- 'icon-grid-default.svg' | inline_asset_content -}}
            </span>
            <span class="product-link-row__text">
              <span class="product-link-row__label">
                {{- section.settings.series_row_label | default: 'All products in the series' -}}
              </span>
              <span class="product-link-row__value">{{ series_name }}</span>
            </span>
            <span class="svg-wrapper product-link-row__arrow" aria-hidden="true">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}

        {% if collection_name != blank %}
          <a href="{{ collection_link | default: '#' }}" class="product-link-row">
            <span class="svg-wrapper product-link-row__icon" aria-hidden="true">
              {{- 'icon-store.svg' | inline_asset_content -}}
            </span>
            <span class="product-link-row__text">
              <span class="product-link-row__label">
                {{- section.settings.collection_row_label | default: 'All products in the collection' -}}
              </span>
              <span class="product-link-row__value">{{ collection_name }}</span>
            </span>
            <span class="svg-wrapper product-link-row__arrow" aria-hidden="true">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  {%- comment -%}
    Sticky bar lives at the end of the component so it shares refs with the hero
    and pins above every following section.
  {%- endcomment -%}
  {% if section.settings.show_sticky_bar %}
    {% render 'showcase-product-sticky-bar',
      product: product,
      selected_variant: selected_variant,
      section: section,
      form_id: form_id
    %}
  {% endif %}
</showcase-product-component>

<script
  src="{{ 'showcase-product.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .showcase-product {
    display: block;
  }

  .product-breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-3xs);
    margin-block-end: var(--margin-lg);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  .product-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .product-breadcrumbs a:hover {
    text-decoration: underline;
  }

  .product-hero {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: var(--gap-2xl);
    align-items: start;
  }

  /* ---- Gallery ---- */
  .product-gallery {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--gap-sm);
  }

  .product-gallery__rail {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    max-height: 620px;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .product-gallery__rail::-webkit-scrollbar {
    display: none;
  }

  .product-thumb {
    flex-shrink: 0;
    padding: 0;
    border: var(--border-width-md) solid transparent;
    border-radius: 4px;
    background-color: var(--product-gallery-background);
    cursor: pointer;
    overflow: hidden;
  }

  .product-thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .product-thumb--active {
    border-color: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  .product-gallery__stage {
    position: relative;
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: var(--product-gallery-background);
    overflow: hidden;
  }

  .product-gallery__share {
    position: absolute;
    top: var(--padding-sm);
    right: var(--padding-sm);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .product-gallery__share .svg-wrapper,
  .product-gallery__share svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .product-gallery__image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* Mobile swipe track is hidden on desktop, where the thumb rail drives swapping. */
  .product-gallery__scroller,
  .product-gallery__dots {
    display: none;
  }

  /* ---- Buy box ---- */
  .product-buybox {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
  }

  .product-buybox__display-name {
    margin: 0;
    font-size: var(--product-title-size, var(--font-size--4xl));
    font-weight: 700;
    line-height: var(--line-height--heading-tight);
  }

  .product-buybox__full-title {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--md);
  }

  .product-buybox__stock {
    margin: 0;
    padding: var(--padding-3xs) var(--padding-sm);
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
    font-size: var(--font-size--xs);
  }

  .product-buybox__bonus {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin: 0;
    font-size: var(--font-size--sm);
  }

  .product-buybox__bonus-icon,
  .product-buybox__bonus-icon svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .product-buybox__price {
    font-size: var(--font-size--4xl);
    font-weight: 700;
    line-height: 1.1;
  }

  .product-buybox__instalment {
    display: flex;
    align-items: center;
    gap: var(--gap-3xs);
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--xs);
  }

  .product-buybox__instalment .svg-wrapper,
  .product-buybox__instalment svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .product-buybox__actions {
    display: flex;
    align-items: stretch;
    gap: var(--gap-sm);
    width: 100%;
    margin-block-start: var(--margin-sm);
  }

  .product-buybox__form {
    flex-grow: 1;
    margin: 0;
  }

  .product-buybox__add {
    width: 100%;
    padding: var(--padding-lg) var(--padding-2xl);
    border: none;
    border-radius: var(--style-border-radius-buttons-primary, 4px);
    background-color: var(--product-cta-background);
    color: var(--product-cta-text);
    font-size: var(--font-size--md);
    font-weight: 600;
    cursor: pointer;
  }

  .product-buybox__add:disabled {
    opacity: var(--opacity-50);
    cursor: not-allowed;
  }

  .wishlist-button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 60px;
    padding: 0;
    border: var(--style-border-width-inputs) solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: 50%;
    background-color: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .wishlist-button--sm {
    width: 40px;
    height: 40px;
  }

  .wishlist-button .svg-wrapper,
  .wishlist-button svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }

  .wishlist-button--active {
    color: var(--product-wishlist-active, #e8342a);
  }

  .wishlist-button--active svg {
    fill: currentcolor;
  }

  /* ---- Variant picker ---- */
  .variant-picker {
    width: 100%;
    margin-block-start: var(--margin-md);
    border: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: var(--style-border-radius-inputs, 8px);
  }

  .variant-picker__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    padding: var(--padding-lg);
    cursor: pointer;
    list-style: none;
  }

  .variant-picker__summary::-webkit-details-marker {
    display: none;
  }

  .variant-picker__label {
    font-size: var(--font-size--lg);
    font-weight: 600;
  }

  .variant-picker__count {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    font-weight: 400;
  }

  .variant-picker__current {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--sm);
  }

  .variant-picker__caret,
  .variant-picker__caret svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    transition: rotate var(--animation-speed) var(--animation-easing);
  }

  .variant-picker[open] .variant-picker__caret {
    rotate: 180deg;
  }

  .variant-picker__body {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    padding: 0 var(--padding-lg) var(--padding-lg);
  }

  .variant-picker__filter {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    font-size: var(--font-size--sm);
  }

  /* Toggle is scoped to this section — the collection filter bar's own toggle
     styles are not loaded on the product template. */
  .variant-toggle {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
    width: 34px;
    height: 20px;
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-15));
  }

  .variant-toggle__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / var(--opacity-25));
  }

  .variant-picker__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-sm);
  }

  .variant-picker__group-name {
    font-size: var(--font-size--sm);
    font-weight: 600;
  }

  .variant-picker__from {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  .variant-picker__cards {
    display: flex;
    gap: var(--gap-2xs);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .variant-picker__cards::-webkit-scrollbar {
    display: none;
  }

  .variant-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 0 0 auto;
    width: 108px;
    padding: var(--padding-2xs);
    border: var(--border-width-md) solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--color-foreground);
    text-align: left;
    cursor: pointer;
  }

  .variant-card--active {
    border-color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }

  .variant-card__media {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 4px;
    background-color: var(--product-gallery-background);
    overflow: hidden;
  }

  .variant-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .variant-card__name {
    font-size: var(--font-size--2xs);
    line-height: 1.3;
  }

  .variant-card__price {
    font-size: var(--font-size--xs);
    font-weight: 600;
  }

  /* ---- Delivery teaser + link rows ---- */
  .product-delivery-teaser,
  .product-link-row {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    width: 100%;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .product-delivery-teaser {
    padding-block: var(--padding-md);
    border-block-end: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .product-link-row {
    margin-block-start: var(--margin-2xs);
    padding: var(--padding-md);
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .product-delivery-teaser__icon,
  .product-delivery-teaser__icon svg,
  .product-link-row__icon,
  .product-link-row__icon svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    flex-shrink: 0;
  }

  .product-delivery-teaser__text,
  .product-link-row__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
    min-width: 0;
  }

  .product-delivery-teaser__title,
  .product-link-row__label {
    font-size: var(--font-size--md);
    font-weight: 600;
  }

  .product-delivery-teaser__detail {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  .product-link-row__value {
    color: var(--product-link-accent, #b8813f);
    font-size: var(--font-size--sm);
  }

  .product-delivery-teaser__chevron,
  .product-delivery-teaser__chevron svg,
  .product-link-row__arrow,
  .product-link-row__arrow svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    flex-shrink: 0;
  }

  /* ---- Responsive ---- */
  @media screen and (max-width: 989px) {
    .product-hero {
      grid-template-columns: 1fr;
      gap: var(--gap-lg);
    }

    /* Thumb rail and the static main image give way to the swipe track. */
    .product-gallery {
      grid-template-columns: 1fr;
    }

    .product-gallery__rail,
    .product-gallery__main {
      display: none;
    }

    .product-gallery__scroller {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .product-gallery__scroller::-webkit-scrollbar {
      display: none;
    }

    .product-gallery__slide {
      flex: 0 0 100%;
      scroll-snap-align: center;
    }

    .product-gallery__slide img {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: contain;
      mix-blend-mode: multiply;
    }

    .product-gallery__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding-block: var(--padding-sm);
    }

    .gallery-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-25));
    }

    .gallery-dot--active {
      background-color: var(--color-foreground);
    }

    .product-buybox__display-name {
      font-size: var(--font-size--2xl);
    }

    .product-buybox__price {
      font-size: var(--font-size--3xl);
    }

    .variant-card {
      width: 96px;
    }
  }
{% endstylesheet %}

