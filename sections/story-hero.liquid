{% comment %}
  Story page hero: breadcrumb, then a full-bleed video or image with a large
  centred heading ("woodeca."). 376:496 on phones, 1440:648 from 750px.

  The image is the poster and the fallback, and it is the page's LCP image
  (eager, fetchpriority high, and preloaded from <head> at high priority —
  copied there by layout/theme.liquid; 375–1920px srcset, phones get ≤750px). A video only starts downloading once the page
  has loaded and gone idle (story-hero.js), and never with Save-Data, a 2G/3G
  connection or reduced motion — then the image stays. No video and no image:
  a solid dark band with the heading.
{% endcomment %}
{%- liquid
  assign image = section.settings.image
  assign video = section.settings.video
  assign overlay = section.settings.overlay_opacity | default: 0 | divided_by: 100.0

  # Smallest MP4 that still fills the screen: ≤720p for phones, ≤1080p for desktop.
  assign src_mobile = ''
  assign src_desktop = ''
  if video != blank
    assign mp4s = video.sources | where: 'format', 'mp4' | sort: 'height'
    for source in mp4s
      if source.height <= 720
        assign src_mobile = source.url
      endif
      if source.height <= 1080
        assign src_desktop = source.url
      endif
    endfor
    if src_desktop == blank and mp4s.size > 0
      assign src_desktop = mp4s.first.url
    endif
    if src_mobile == blank
      assign src_mobile = src_desktop
    endif
    if image == blank
      assign image = video.preview_image
    endif
  endif
-%}

{% if section.settings.show_breadcrumbs %}
  <div class="section section--page-width story-hero__crumbs">
    {% render 'showcase-breadcrumbs',
      current: section.settings.breadcrumb_label,
      home_label: section.settings.breadcrumb_home_label
    %}
  </div>
{% endif %}

<story-hero-component
  class="story-hero{% if image == blank and src_desktop == blank %} story-hero--empty{% endif %}"
  style="--story-hero-overlay: {{ overlay }}; --story-hero-empty: {{ settings.color_palette.color1 | default: '#333333' }};"
  {% if src_desktop != blank %}
    data-src-mobile="{{ src_mobile }}"
    data-src-desktop="{{ src_desktop }}"
  {% endif %}
>
  {% if image != blank %}
  {%- comment -%}
    Copied into <head> by layout/theme.liquid, so the hero download
    starts at high priority before the CSS and scripts. Same srcset/sizes as
    the image below, so the browser reuses it.
  {%- endcomment -%}
  <link data-hero-preload rel="preload" as="image" fetchpriority="high" href="{{ image | image_url: width: 1920 }}" imagesrcset="{{ image | image_url: width: 375 }} 375w, {{ image | image_url: width: 550 }} 550w, {{ image | image_url: width: 750 }} 750w, {{ image | image_url: width: 1100 }} 1100w, {{ image | image_url: width: 1500 }} 1500w, {{ image | image_url: width: 1920 }} 1920w" imagesizes="100vw">
  {%- comment -%} The image's own srcset is the same list, so the preload is reused. {%- endcomment -%}
  {%- capture hero_srcset -%}{{ image | image_url: width: 375 }} 375w, {{ image | image_url: width: 550 }} 550w, {{ image | image_url: width: 750 }} 750w, {{ image | image_url: width: 1100 }} 1100w, {{ image | image_url: width: 1500 }} 1500w, {{ image | image_url: width: 1920 }} 1920w{%- endcapture -%}
    {{
      image
      | image_url: width: 1920
      | image_tag:
        class: 'story-hero__media story-hero__image',
        loading: 'eager',
        fetchpriority: 'high',
        srcset: hero_srcset,
        sizes: '100vw',
        alt: ''
    }}
  {% endif %}

  {% if src_desktop != blank %}
    <video
      class="story-hero__media story-hero__video"
      muted
      playsinline
      loop
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    ></video>
  {% endif %}

  <div class="story-hero__overlay" aria-hidden="true"></div>

  {% if section.settings.heading != blank %}
    <h1 class="story-hero__heading">{{ section.settings.heading }}</h1>
  {% endif %}
</story-hero-component>

{% if src_desktop != blank %}
  <script src="{{ 'story-hero.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}

{% stylesheet %}
  .story-hero__crumbs {
    padding-block-start: var(--padding-md);
  }

  .story-hero__crumbs .showcase-breadcrumbs {
    margin-block-end: var(--margin-md);
  }

  .story-hero {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 376 / 496;
    overflow: hidden;
    /* No media: the theme's dark palette colour. */
    background-color: var(--story-hero-empty, #333333);
    color: #ffffff;
  }

  .story-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Fades in over the poster once it is actually playing. */
  .story-hero__video {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .story-hero__video.is-playing {
    opacity: 1;
  }

  .story-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / var(--story-hero-overlay, 0.2));
    pointer-events: none;
  }

  .story-hero--empty .story-hero__overlay {
    display: none;
  }

  .story-hero__heading {
    position: relative;
    margin: 0;
    padding-inline: 16px;
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-size: 56px;
    font-weight: var(--font-heading--weight, 600);
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .story-hero {
      aspect-ratio: 1440 / 648;
    }

    .story-hero__heading {
      font-size: clamp(72px, 7.64vw, 110px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story hero",
  "tag": "section",
  "class": "section-story-hero",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "breadcrumb_home_label", "label": "Breadcrumb home label", "default": "Home" },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb page label", "default": "Our Story" },
    { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on a loop once the page has loaded. Not shown with data saver or a slow connection." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown before the video starts, and instead of it when there's no video." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "woodeca." },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 20 }
  ],
  "presets": [{ "name": "Story hero" }]
}
{% endschema %}
