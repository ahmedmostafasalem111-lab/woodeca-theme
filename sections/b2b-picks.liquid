{% comment %}
  "This season's picks" (divan.ru designers page): a carousel of large cards,
  about 2.2 visible on desktop (597×396 image) with arrows and dots, a swipe
  row on phones. Each card is the shared product card (same image logic and
  colour-swatch photo swap as everywhere else), shown with a wide image, plus a
  muted line "N more in <collection>" linking to the product's main collection.
  Products come from the product list, or the collection when the list is empty.
{% endcomment %}
{%- render 'b2b-styles' -%}
{%- liquid
  assign source = section.settings.products
  if source == blank or source.size == 0
    assign source = section.settings.collection.products
  endif
  assign generic = 'all,frontpage,bestsellers,new-arrivals,ready-to-ship,designer-picks,product-block-1-best-sellers,product-block-2-must-haves'
  assign generic_list = generic | split: ','
-%}
{% if source != blank and source.size > 0 %}
  <div class="section section--page-width b2b-section b2b-picks">
    {% if section.settings.heading != blank %}
      <div class="b2b-head">
        <h2 class="b2b-head__title{% if section.settings.heading_size == 'md' %} b2b-head__title--md{% endif %}">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <p class="b2b-head__text">{{ section.settings.text }}</p>
        {% endif %}
      </div>
    {% endif %}

    <b2b-carousel class="b2b-picks__viewport" data-dots>
      <ul class="b2b-picks__track b2b-swipe" role="list" data-track>
        {%- for product in source limit: section.settings.limit -%}
          {%- liquid
            assign home = nil
            for c in product.collections
              unless generic_list contains c.handle
                if c.products_count > 1
                  assign home = c
                  break
                endif
              endunless
            endfor
          -%}
          <li class="b2b-picks__item">
            {% render 'showcase-product-card',
              product: product,
              show_quick_add: section.settings.show_quick_add,
              show_swatches: section.settings.show_swatches
            %}
            {% if home != nil %}
              {%- assign more = home.products_count | minus: 1 -%}
              <a class="b2b-picks__more" href="{{ home.url }}">
                {{- section.settings.more_template | default: '[count] more in [collection]' | replace: '[count]', more | replace: '[collection]', home.title -}}
              </a>
            {% endif %}
          </li>
        {%- endfor -%}
      </ul>
      <button type="button" class="b2b-arrow b2b-arrow--prev" data-prev aria-label="{{ section.settings.prev_label | default: 'Previous' | escape }}">
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
      </button>
      <button type="button" class="b2b-arrow b2b-arrow--next" data-next aria-label="{{ section.settings.next_label | default: 'Next' | escape }}">
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
      </button>
      <div class="b2b-dots" data-dots-list aria-hidden="true"></div>
    </b2b-carousel>
  </div>
  <script src="{{ 'showcase-card-cart.js' | asset_url }}" type="module" fetchpriority="low"></script>
  <script src="{{ 'b2b.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}

{% stylesheet %}
  .b2b-picks__viewport {
    position: relative;
    display: block;
  }

  .b2b-picks__track {
    margin-block: 0;
    list-style: none;
  }

  .b2b-picks__item {
    display: flex;
    flex-direction: column;
    width: 280px;
  }

  /* The shared card with a wide image on the light background, like divan's picks. */
  .b2b-picks .showcase-card__media {
    aspect-ratio: 597 / 396;
    background-color: #f2f2f0;
  }

  .b2b-picks__more {
    margin-block-start: 4px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text, 0.6));
    font-size: 13px;
    text-decoration: none;
  }

  .b2b-picks__more:hover {
    text-decoration: underline;
  }

  .b2b-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-block-start: 24px;
  }

  .b2b-dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-20, 0.2));
    cursor: pointer;
  }

  .b2b-dots button[aria-current='true'] {
    background-color: var(--color-foreground);
  }

  @media screen and (min-width: 990px) {
    .b2b-picks .b2b-picks__track {
      display: flex;
      gap: 30px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .b2b-picks__item {
      width: calc((100% - 60px) / 2.2);
    }

    .b2b-picks__more {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "B2B product picks",
  "tag": "section",
  "class": "section-b2b-picks",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "lg", "label": "Large (44px)" },
        { "value": "md", "label": "Medium (30px)" }
      ],
      "default": "md"
    },
    { "type": "textarea", "id": "text", "label": "Subtitle" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "Or a collection", "info": "Used when no products are picked." },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "more_template", "label": "More line", "default": "[count] more in [collection]", "info": "[count] and [collection] are filled in per product." },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add", "default": true },
    { "type": "text", "id": "prev_label", "label": "Previous button label", "default": "Previous" },
    { "type": "text", "id": "next_label", "label": "Next button label", "default": "Next" }
  ],
  "presets": [{ "name": "B2B product picks" }]
}
{% endschema %}
