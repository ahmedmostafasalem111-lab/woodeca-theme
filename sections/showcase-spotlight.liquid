{% comment %}
  Featured collection spotlight: heading + description above a two-column layout —
  a tall lifestyle photograph on the left and a scrollable mini product list on
  the right — with a full-width pill CTA underneath. On mobile the image stacks on
  top and the mini list becomes a horizontal swipe carousel.
{% endcomment %}

{% liquid
  # The photo — not the number of products — sets the row height, so the list can
  # scroll inside a box that tracks it. Falls back to a landscape ratio when no
  # image is picked and the placeholder SVG is shown instead.
  assign spotlight_ratio = section.settings.image.aspect_ratio | default: 1.45
%}

<div
  class="section-background"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
></div>

<div
  class="section section--{{ section.settings.section_width }} showcase-spotlight spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
    --spotlight-image-width: {{ section.settings.image_width }}%;
    --spotlight-heading-size: {{ section.settings.heading_size }};
    --spotlight-cta-background: {{ section.settings.cta_background | default: '#333333' }};
    --spotlight-cta-text: {{ section.settings.cta_text_color | default: '#ffffff' }};
    --spotlight-thumb-background: {{ section.settings.thumb_background | default: '#f2f2f0' }};
    --spotlight-image-ratio: {{ spotlight_ratio }};
    --spotlight-image-position: {{ section.settings.image_position | default: '50% 50%' }};
    --spotlight-overlap: {{ section.settings.mobile_overlap | default: 0 }}px;
    {%- comment -%}
      Emitted on the section so it is inspectable here rather than only on the
      inner list. Tablet narrows it in the 989 block.
    {%- endcomment -%}
    --spotlight-card-width: {{ section.settings.mobile_card_width | default: 43 }}%;
  "
>
  {% if section.settings.heading != blank or section.settings.description != blank %}
    <div class="showcase-spotlight__header">
      {% if section.settings.heading != blank %}
        <h2 class="showcase-spotlight__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="showcase-spotlight__description">{{ section.settings.description }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="showcase-spotlight__columns">
    <div class="showcase-spotlight__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: loading: 'lazy', class: 'showcase-spotlight__image', alt: section.settings.heading
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'showcase-spotlight__image showcase-spotlight__image--placeholder' }}
      {% endif %}
    </div>

    <div class="showcase-spotlight__list-column">
      <div class="showcase-spotlight__list" data-spotlight-scroller>
        {% for block in section.blocks %}
          {% liquid
            assign item_product = block.settings.product
            if item_product != blank
              assign item_title = item_product.title
              assign item_price = item_product.price | money
              assign item_image = item_product.featured_image
              assign item_url = item_product.url
            else
              assign item_title = block.settings.title
              assign item_price = block.settings.price
              assign item_image = block.settings.image
              assign item_url = block.settings.url
            endif
            assign item_url = item_url | default: '#'

            # Only a single-variant, in-stock product can be added straight from the
            # card. Anything with options keeps its link so we never silently add the
            # wrong variant on a product that requires a choice.
            assign item_variant_id = null
            if item_product != blank and item_product != nil
              if item_product.variants.size == 1
                assign only_variant = item_product.variants.first
                if only_variant.available
                  assign item_variant_id = only_variant.id
                endif
              endif
            endif
          %}
          <div
            class="spotlight-item"
            {{ block.shopify_attributes }}
          >
            <div class="spotlight-item__media">
              <a
                href="{{ item_url }}"
                tabindex="-1"
                aria-hidden="true"
                class="spotlight-item__media-link"
              >
                {% if item_image != blank %}
                  {{
                    item_image
                    | image_url: width: 300
                    | image_tag: loading: 'lazy', class: 'spotlight-item__image', alt: item_title
                  }}
                {% else %}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'spotlight-item__image spotlight-item__image--placeholder' }}
                {% endif %}
              </a>

              {% if section.settings.show_wishlist %}
                <button
                  type="button"
                  class="spotlight-item__wishlist"
                  aria-label="Add {{ item_title | escape }} to wishlist"
                >
                  <span class="svg-wrapper" aria-hidden="true">
                    {{- 'icon-heart.svg' | inline_asset_content -}}
                  </span>
                </button>
              {% endif %}
            </div>

            <div class="spotlight-item__info">
              <a
                href="{{ item_url }}"
                class="spotlight-item__title"
              >
                {{- item_title -}}
              </a>
              <p class="spotlight-item__price">{{ item_price }}</p>

              {% if section.settings.add_to_cart_label != blank %}
                {% if item_variant_id != null %}
                  <button
                    type="button"
                    class="spotlight-item__add"
                    data-cart-add
                    data-variant-id="{{ item_variant_id }}"
                    data-cart-url="{{ routes.cart_url }}"
                    data-label-add="Add {{ item_title | escape }} to cart"
                    data-label-added="{{ item_title | escape }} is in your cart. Go to cart"
                    aria-label="Add {{ item_title | escape }} to cart"
                  >
                    {{ section.settings.add_to_cart_label }}
                  </button>
                {% else %}
                  {%- comment -%}
                    Options required, or out of stock — send the shopper to the product
                    page rather than guessing a variant.
                  {%- endcomment -%}
                  <a
                    href="{{ item_url }}"
                    class="spotlight-item__add"
                    aria-label="Choose options for {{ item_title | escape }}"
                  >
                    {{ section.settings.options_label | default: 'Choose options' }}
                  </a>
                {% endif %}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {%- comment -%}
        Mobile-only scroll indicator. Hidden on desktop, where the list scrolls
        vertically inside the panel instead.
      {%- endcomment -%}
      <div class="showcase-spotlight__progress" data-spotlight-progress aria-hidden="true">
        <span class="showcase-spotlight__progress-thumb" data-spotlight-thumb></span>
      </div>
    </div>
  </div>

  {% if section.settings.cta_label != blank %}
    <a
      href="{{ section.settings.cta_link | default: '#' }}"
      class="showcase-spotlight__cta"
    >
      <span>{{ section.settings.cta_label }}</span>
      <span class="svg-wrapper" aria-hidden="true">
        {{- 'icon-chevron-right.svg' | inline_asset_content -}}
      </span>
    </a>
  {% endif %}
</div>

{%- comment -%}
  Reuses the shared card add-to-cart delegation rather than a second implementation.
{%- endcomment -%}
<script
  src="{{ 'showcase-card-cart.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<script
  src="{{ 'showcase-spotlight-progress.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% stylesheet %}
  /*
    The header group is sticky, so an editor scroll-to-section or an anchor jump
    lands the section top underneath it. scroll-margin keeps the heading clear
    without any layout-shifting top margin.
  */
  .showcase-spotlight {
    scroll-margin-block-start: calc(var(--header-group-height, 0px) + 12px);
  }

  .showcase-spotlight__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    margin-block-end: var(--margin-xl);
  }

  .showcase-spotlight__heading {
    margin: 0;
    font-size: var(--spotlight-heading-size, var(--font-size--3xl));
    line-height: var(--line-height--heading-tight);
  }

  .showcase-spotlight__description {
    max-width: 80ch;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--md);
  }

  .showcase-spotlight__description > :first-child {
    margin-block-start: 0;
  }

  .showcase-spotlight__description > :last-child {
    margin-block-end: 0;
  }

  .showcase-spotlight__columns {
    display: grid;
    grid-template-columns: var(--spotlight-image-width) 1fr;
    gap: var(--gap-lg);
    align-items: stretch;
  }

  /*
    The photo is the only thing that sizes the grid row: its aspect ratio gives it a
    definite height, and the list column opts out of row sizing entirely (below), so
    the panel tracks the image rather than the image stretching to fit the cards.
  */
  .showcase-spotlight__media {
    min-height: 420px;
    max-height: 780px;
    border-radius: var(--style-border-radius-inputs, 8px);
    aspect-ratio: var(--spotlight-image-ratio, 1.45);
    overflow: hidden;
  }

  .showcase-spotlight__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-spotlight__image--placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  /*
    Absolutely positioning the list means it contributes zero height to the grid row,
    so however many products the merchant adds — 4 or 12 — the box stays the height of
    the photo and the overflow scrolls instead of squeezing the cards.
  */
  .showcase-spotlight__list-column {
    position: relative;
    min-height: 0;
  }

  .showcase-spotlight__list {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    padding-inline-end: var(--padding-xs);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground-rgb) / var(--opacity-30)) transparent;
  }

  /* Cards keep their natural height — never stretched to make the list fit. */
  .showcase-spotlight__list > .spotlight-item {
    flex: 0 0 auto;
  }

  .showcase-spotlight__list::-webkit-scrollbar {
    width: 4px;
  }

  .showcase-spotlight__list::-webkit-scrollbar-track {
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .showcase-spotlight__list::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  /*
    Thumbnail takes 38% of the row, matching the reference's 220px box in a 573px
    row, so it scales with the panel instead of being pinned to a small fixed size.
  */
  .spotlight-item {
    display: grid;
    grid-template-columns: 38% 1fr;
    gap: var(--gap-sm);
    align-items: start;
  }

  .spotlight-item__media {
    position: relative;
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: var(--spotlight-thumb-background);
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .spotlight-item__media-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .spotlight-item__image {
    width: 82%;
    height: 82%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .spotlight-item__image--placeholder {
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .spotlight-item__wishlist {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .spotlight-item__wishlist .svg-wrapper,
  .spotlight-item__wishlist svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .spotlight-item__info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    align-items: flex-start;
    padding-inline: var(--padding-sm);
  }

  .spotlight-item__title {
    color: var(--color-foreground);
    font-size: var(--font-size--sm);
    text-decoration: none;
  }

  .spotlight-item__price {
    margin: 0;
    font-size: var(--font-size--md);
    font-weight: 600;
  }

  /*
    Fixed-width outlined button, left-aligned in the text column — not a full-width
    bar. Caps at the reference's 200px and shrinks only on narrow panels.
  */
  .spotlight-item__add {
    width: min(200px, 100%);
    height: 35px;
    padding-inline: var(--padding-xs);
    border: var(--style-border-width-inputs) solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: 4px;
    background-color: transparent;
    color: var(--color-foreground);
    font-size: var(--font-size--sm);
    cursor: pointer;
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .spotlight-item__add:hover {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
  }

  /* Scroll indicator — only meaningful in the mobile horizontal layout. */
  .showcase-spotlight__progress {
    display: none;
    position: relative;
    width: 110px;
    height: 4px;
    margin: 14px auto 0;
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    overflow: hidden;
  }

  .showcase-spotlight__progress-thumb {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 30%;
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
  }

  @media (prefers-reduced-motion: no-preference) {
    .showcase-spotlight__list {
      scroll-behavior: smooth;
    }
  }

  /* Full-width dark pill CTA under both columns. */
  .showcase-spotlight__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xs);
    width: 100%;
    margin-block-start: var(--margin-xl);
    padding-block: var(--padding-md);
    border-radius: 999px;
    background-color: var(--spotlight-cta-background);
    color: var(--spotlight-cta-text);
    font-size: var(--font-size--md);
    font-weight: 500;
    text-decoration: none;
  }

  .showcase-spotlight__cta .svg-wrapper,
  .showcase-spotlight__cta svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  @media screen and (max-width: 989px) {
    .showcase-spotlight__columns {
      grid-template-columns: 1fr;
    }

    /*
      Square from the point the layout goes single-column. Without this the box
      keeps the desktop's image-derived ratio, so the banner took the shape of
      whatever photo was uploaded. min/max-height existed only to prop up that
      ratio-driven box and would fight the square, so both are neutralised.
    */
    .showcase-spotlight__media {
      min-height: 0;
      max-height: none;
      aspect-ratio: 1 / 1;
    }

    /*
      Below the photo the list becomes a single-row swipe carousel with the next card
      peeking in at the right edge, matching the other product carousels in the theme.
      The absolute positioning used on desktop is undone here so the row sits in flow.
    */
    .showcase-spotlight__list-column {
      position: static;
    }

    .showcase-spotlight__list {
      position: static;
      flex-direction: row;
      padding-inline-end: 0;
      padding-block-end: var(--padding-xs);
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    /*
      Tablet override. The section emits 43% for phones; at this width that would
      give only two very wide cards, so narrow it here and let the 749 block put
      it back for phones.
    */
    .showcase-spotlight__list {
      --spotlight-card-width: 32%;
    }

    .showcase-spotlight__list > .spotlight-item {
      flex: 0 0 var(--spotlight-card-width, 32%);
      grid-template-columns: minmax(0, 1fr);
      scroll-snap-align: start;
    }
  }

  /*
    ---- Mobile ----
    Compact editorial block: heading, description, full-bleed hero, then a swipe row
    of small cards. Everything is scoped to `.showcase-spotlight`, so no other card
    or carousel on the site is touched.
  */
  @media screen and (max-width: 749px) {
    .showcase-spotlight.spacing-style {
      padding-block-start: 20px;
      padding-block-end: 16px;
    }

    /*
      Text keeps the page gutter. Pulling it outward risked overflowing the page,
      which the brief rules out — only the hero bleeds, and that pull exactly
      cancels the gutter so it can never exceed the viewport.
    */
    .showcase-spotlight__header {
      gap: 0;
      margin-block-end: 0;
    }

    .showcase-spotlight__heading {
      margin-block-end: 12px;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.3;
      text-align: start;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    .showcase-spotlight__description {
      max-width: 100%;
      margin-block-end: 14px;
      color: var(--color-foreground);
      font-size: 11.5px;
      font-weight: 400;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .showcase-spotlight__columns {
      gap: 0;
    }

    /*
      Hero bleeds to both viewport edges by cancelling the page gutter exactly.
      Height is explicit rather than an aspect-ratio: the desktop rule's ratio was
      not constraining this box, so the image rendered at its natural portrait
      height. 56vw is ~210px at 375px wide.
    */
    /*
      Square on mobile, matching the reference. The image is absolutely positioned
      so it contributes no height — with `height: 100%` in normal flow it resolves
      against an indefinite parent, falls back to the photo's natural height and
      overrides the aspect-ratio, which is what produced the wide letterbox strip.
    */
    .showcase-spotlight__media {
      position: relative;
      min-height: 0;
      max-height: none;
      height: auto;
      aspect-ratio: 1 / 1;
      align-self: start;
      /* Cancels the page gutter so the square reaches both edges. */
      margin-inline: calc(var(--page-margin, 16px) * -1);
      border-radius: 0;
      overflow: hidden;
    }

    .showcase-spotlight__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* Merchant-adjustable, so a square crop can be re-aimed per image. */
      object-position: var(--spotlight-image-position, 50% 50%);
      mix-blend-mode: normal;
    }

    /*
      Flush against the image bottom by default, so the two read as one block.
      The overlap setting can pull the row up over the photo's lower edge.
    */
    .showcase-spotlight__list {
      /* Undo the tablet narrowing so the section's setting governs on phones. */
      --spotlight-card-width: inherit;

      position: relative;
      z-index: 1;
      gap: 9px;
      margin-block-start: var(--spotlight-overlap, 0px);
      padding-inline: 0;
      padding-block-end: 0;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .showcase-spotlight__list::-webkit-scrollbar {
      display: none;
    }

    .showcase-spotlight__list > .spotlight-item {
      flex: 0 0 var(--spotlight-card-width);
      display: flex;
      flex-direction: column;
      gap: 6px;
      /* Opaque, so cards read cleanly when overlapped onto the photo. */
      background-color: var(--color-background, #fff);
    }

    .spotlight-item__media {
      aspect-ratio: 1 / 1;
      border-radius: 3px;
      background-color: #f3f3f3;
    }

    /* Contain, so furniture is never cropped. */
    .spotlight-item__image {
      width: 88%;
      height: 88%;
      object-fit: contain;
      mix-blend-mode: multiply;
    }

    .spotlight-item__wishlist {
      top: 7px;
      right: 7px;
      width: 16px;
      height: 16px;
      background: transparent;
    }

    .spotlight-item__wishlist .svg-wrapper,
    .spotlight-item__wishlist svg {
      width: 15px;
      height: 15px;
    }

    /* Column layout is what keeps prices and buttons on a shared baseline. */
    .spotlight-item__info {
      flex: 1 1 auto;
      gap: 0;
      padding-inline: 0;
    }

    .spotlight-item__title {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      /* Reserves two lines so short names don't shorten their card. */
      min-height: calc(2 * 1.35 * 10.5px);
      font-size: 10.5px;
      font-weight: 400;
      line-height: 1.35;
      overflow: hidden;
    }

    .spotlight-item__price {
      margin-block-start: 4px;
      font-size: 11.5px;
      font-weight: 600;
    }

    .spotlight-item__add {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 27px;
      /* auto pushes every button to the bottom of its card. */
      margin-block-start: auto;
      padding-inline: 4px;
      border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
      border-radius: 3px;
      /* Transparent fill, matching the desktop outlined treatment. */
      background-color: transparent;
      font-size: 10px;
      font-weight: 500;
      line-height: 1.2;
      text-align: center;
      text-decoration: none;
    }

    .spotlight-item__add:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 1px;
    }

    /* Matches the reference's small centred indicator. */
    .showcase-spotlight__progress {
      display: block;
      width: 62px;
      height: 4px;
      margin-block-start: 12px;
    }

    .showcase-spotlight__cta {
      margin-block-start: 16px;
      padding-block: var(--padding-sm);
      font-size: var(--font-size--sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection spotlight",
  "tag": "section",
  "class": "section-showcase-spotlight",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lorem ipsum dolor. SIT."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "var(--font-size--2xl)", "label": "Medium" },
        { "value": "var(--font-size--3xl)", "label": "Large" },
        { "value": "var(--font-size--4xl)", "label": "Extra large" }
      ],
      "default": "var(--font-size--3xl)"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A collection of lorem ipsum dolor sit amet that accommodates and adapts to all consectetur adipiscing elit.</p>"
    },
    {
      "type": "header",
      "content": "Feature image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "50% 0%", "label": "Top" },
        { "value": "0% 50%", "label": "Left" },
        { "value": "50% 50%", "label": "Center" },
        { "value": "100% 50%", "label": "Right" },
        { "value": "50% 100%", "label": "Bottom" },
        { "value": "0% 0%", "label": "Top left" },
        { "value": "100% 0%", "label": "Top right" },
