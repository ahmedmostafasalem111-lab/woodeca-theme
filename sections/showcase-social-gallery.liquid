{% comment %}
  Social / inspiration gallery: heading + subtext, a four-across image row with
  captions and arrow navigation, then an SEO content block (secondary heading plus
  rich-text body) beneath the gallery.
{% endcomment %}

<div
  class="section-background"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
></div>

<div
  class="section section--{{ section.settings.section_width }} showcase-gallery spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
    --gallery-heading-size: {{ section.settings.heading_size }};
  "
>
  {% if section.settings.heading != blank or section.settings.subtext != blank %}
    <div class="showcase-gallery__header">
      {% if section.settings.heading != blank %}
        <h2 class="showcase-gallery__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="showcase-gallery__subtext">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>
  {% endif %}

  {%- capture gallery_items -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign item_tag = 'div'
        if block.settings.link != blank
          assign item_tag = 'a'
        endif
      -%}
      <{{ item_tag }}
        class="gallery-item"
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        {{ block.shopify_attributes }}
      >
        <span class="gallery-item__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 700
              | image_tag: loading: 'lazy', class: 'gallery-item__image', alt: block.settings.caption
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'gallery-item__image gallery-item__image--placeholder' }}
          {% endif %}
        </span>

        {% if block.settings.caption != blank %}
          <span class="gallery-item__caption">{{ block.settings.caption }}</span>
        {% endif %}
      </{{ item_tag }}>
    {%- endfor -%}
  {%- endcapture -%}

  {% render 'scroll-row',
    content: gallery_items,
    columns: section.settings.columns,
    columns_mobile: section.settings.columns_mobile,
    show_arrows: section.settings.show_arrows,
    show_progress: section.settings.show_progress,
    gap: 'var(--gap-md)',
    align: 'start',
    prev_label: 'Previous photos',
    next_label: 'Next photos'
  %}

  {% if section.settings.seo_heading != blank or section.settings.seo_body != blank %}
    <div class="showcase-gallery__seo">
      {% if section.settings.seo_heading != blank %}
        <h3 class="showcase-gallery__seo-heading">{{ section.settings.seo_heading }}</h3>
      {% endif %}

      {% if section.settings.seo_body != blank %}
        <div class="showcase-gallery__seo-body">{{ section.settings.seo_body }}</div>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .showcase-gallery__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    margin-block-end: var(--margin-xl);
  }

  .showcase-gallery__heading {
    margin: 0;
    font-size: var(--gallery-heading-size, var(--font-size--3xl));
    line-height: var(--line-height--heading-tight);
  }

  .showcase-gallery__subtext {
    margin: 0;
    max-width: 80ch;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--md);
  }

  .gallery-item {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .gallery-item__media {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
    overflow: hidden;
  }

  .gallery-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-item__image--placeholder {
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .gallery-item__caption {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  /* SEO copy block sits centred beneath the gallery. */
  .showcase-gallery__seo {
    margin-block-start: var(--margin-4xl);
    text-align: center;
  }

  .showcase-gallery__seo-heading {
    margin: 0 0 var(--margin-md);
    font-size: var(--font-size--2xl);
    line-height: var(--line-height--heading-tight);
    text-wrap: balance;
  }

  .showcase-gallery__seo-body {
    max-width: 90ch;
    margin-inline: auto;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--sm);
    text-align: left;
  }

  .showcase-gallery__seo-body > :first-child {
    margin-block-start: 0;
  }

  .showcase-gallery__seo-body > :last-child {
    margin-block-end: 0;
  }

  @media screen and (max-width: 749px) {
    .showcase-gallery__heading {
      font-size: var(--font-size--xl);
    }

    .showcase-gallery__subtext {
      font-size: var(--font-size--sm);
    }

    .showcase-gallery__seo-heading {
      font-size: var(--font-size--lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social gallery",
  "tag": "section",
  "class": "section-showcase-gallery",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Decorating your home? Get inspired by real interiors!"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "var(--font-size--2xl)", "label": "Medium" },
        { "value": "var(--font-size--3xl)", "label": "Large" },
        { "value": "var(--font-size--4xl)", "label": "Extra large" }
      ],
      "default": "var(--font-size--3xl)"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Thousands of lorem ipsum customers have already shared photos of dolor sit amet."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Photos visible on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Photos visible on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show scroll progress bar",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "SEO content block"
    },
    {
      "type": "text",
      "id": "seo_heading",
      "label": "Secondary heading",
      "default": "Online furniture and home goods store in Lorem City"
    },
    {
      "type": "richtext",
      "id": "seo_body",
      "label": "Body text",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "@lorem_ipsum"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social gallery",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
