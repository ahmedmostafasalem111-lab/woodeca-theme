{% comment %}
  Tabbed specifications block: a segmented "Overall dimensions" / "Additional"
  control swapping two diagram panels in place, a full spec list beneath it, and a
  downloadable files list.

  Every value is read from product metafields and each row is omitted when its
  metafield is empty, so the block only ever shows real data. The whole section
  hides itself when nothing at all is populated.

  Spec rows are declared as blocks, so which specs appear (and in what order) is
  editable per store without touching Liquid.
{% endcomment %}

{% liquid
  assign ns = section.settings.metafield_namespace | default: 'custom'

  assign dimensions_diagram = product.metafields[ns]['dimensions_diagram']
  assign additional_diagram = product.metafields[ns]['additional_diagram']
  assign dimensions_summary = product.metafields[ns]['dimensions_summary'].value
  assign floor_clearance = product.metafields[ns]['floor_clearance'].value
  assign delivery_option = product.metafields[ns]['delivery_option'].value
  assign spec_files = product.metafields[ns]['spec_files'].value

  # Decide whether there is anything worth rendering at all.
  assign has_diagram = false
  if dimensions_diagram != blank or additional_diagram != blank
    assign has_diagram = true
  endif

  assign has_captions = false
  if dimensions_summary != blank or floor_clearance != blank or delivery_option != blank
    assign has_captions = true
  endif

  assign populated_rows = 0
  for block in section.blocks
    if block.type == 'spec'
      assign row_value = product.metafields[ns][block.settings.metafield_key].value
      if row_value != blank
        assign populated_rows = populated_rows | plus: 1
      endif
    endif
  endfor

  assign has_files = false
  if spec_files != blank and spec_files.size > 0
    assign has_files = true
  endif

  assign render_section = false
  if has_diagram or has_captions or populated_rows > 0 or has_files
    assign render_section = true
  endif

  # The other two tabs. Description is the product's own body; care instructions
  # are a metafield, so a product without either simply shows fewer tabs.
  # Rich text metafields must go through metafield_tag; printed directly they
  # output their raw JSON. Visibility is decided from the rendered text so a
  # field saved empty (`{"type":"root","children":[]}`) hides the tab too.
  assign care_field = product.metafields[ns]['care_instructions']
  assign care_text = ''
  if care_field != blank
    assign care_text = care_field | metafield_tag
  endif
  assign care_plain = care_text | strip_html | strip

  assign has_specs_tab = render_section
  assign has_description_tab = false
  if product.description != blank
    assign has_description_tab = true
  endif
  assign has_care_tab = false
  if care_plain != blank
    assign has_care_tab = true
  endif

  if has_description_tab or has_care_tab
    assign render_section = true
  endif

  # Whichever tab comes first is the one that opens; there is no fixed default,
  # because the Specifications tab itself can be absent.
  assign first_tab = ''
  if has_specs_tab
    assign first_tab = 'specifications'
  elsif has_description_tab
    assign first_tab = 'description'
  elsif has_care_tab
    assign first_tab = 'care'
  endif
%}

{% if render_section %}
  <div
    id="{{ section.settings.anchor_id | default: 'specifications' }}"
    class="section section--{{ section.settings.section_width }} product-specs spacing-style"
    style="
      {% render 'spacing-padding', settings: section.settings %}
      {% if section.settings.text_color != blank %}
        --color-foreground: {{ section.settings.text_color }};
        --color-foreground-rgb: {{ section.settings.text_color.rgb }};
      {% endif %}
      --specs-columns: {{ section.settings.columns }};
    "
  >
    {% if section.settings.heading != blank %}
      <h2 class="product-specs__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {%- comment -%}
      Three underlined tabs across the top. The shared tab component drives them,
      but the strip is written out here rather than rendered from the two-option
      snippet because this one has three entries and any of them can be absent.
    {%- endcomment -%}
    <showcase-panel-tabs-component class="product-specs__tabs">
      <div
        class="product-specs__tabstrip"
        role="tablist"
        aria-label="{{ section.settings.tabs_label | default: 'Product details' | escape }}"
        on:keydown="/onKeyDown"
      >
        {% for entry in (1..3) %}
          {% liquid
            case forloop.index
              when 1
                assign tab_key = 'specifications'
                assign tab_shown = has_specs_tab
                assign tab_text = section.settings.tab_specs_label | default: 'Specifications'
              when 2
                assign tab_key = 'description'
                assign tab_shown = has_description_tab
                assign tab_text = section.settings.tab_description_label | default: 'Description'
              else
                assign tab_key = 'care'
                assign tab_shown = has_care_tab
                assign tab_text = section.settings.tab_care_label | default: 'Care Instructions'
            endcase

            assign tab_active = false
            if tab_key == first_tab
              assign tab_active = true
            endif
          %}
          {% if tab_shown %}
            <button
              type="button"
              class="product-specs__tab{% if tab_active %} panel-tab--active{% endif %}"
              ref="tabs[]"
              data-panel="{{ tab_key }}"
              role="tab"
              aria-selected="{{ tab_active }}"
              {% unless tab_active %}
                tabindex="-1"
              {% endunless %}
              on:click="/select"
            >
              {{- tab_text -}}
            </button>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%} ---- Specifications ---- {%- endcomment -%}
      {% if has_specs_tab %}
        <div
          class="product-specs__panel"
          ref="panels[]"
          data-panel="specifications"
          role="tabpanel"
          {% unless first_tab == 'specifications' %}
            hidden
          {% endunless %}
        >
          {%- comment -%}
            The whole image block is skipped when the metafield is empty — no
            empty frame, no placeholder.
          {%- endcomment -%}
          {% if dimensions_diagram != blank %}
            <div class="product-specs__diagram">
              {{
                dimensions_diagram
                | image_url: width: 1200
                | image_tag: loading: 'lazy', alt: section.settings.tab_specs_label
              }}
            </div>
          {% endif %}

          {% if additional_diagram != blank %}
            <div class="product-specs__diagram">
              {{
                additional_diagram
                | image_url: width: 1200
                | image_tag: loading: 'lazy', alt: section.settings.tab_additional_label
              }}
            </div>
          {% endif %}

          {%- comment -%} Caption stats sit below the diagram. {%- endcomment -%}
          {% if has_captions %}
            <div class="product-specs__captions">
              {% if dimensions_summary != blank %}
                <p class="product-specs__caption">
                  <span class="product-specs__caption-label">
                    {{- section.settings.dimensions_caption_label | default: 'Dimensions' -}}:
                  </span>
                  <span>{{ dimensions_summary }}</span>
                </p>
              {% endif %}
              {% if floor_clearance != blank %}
                <p class="product-specs__caption">
                  <span class="product-specs__caption-label">
                    {{- section.settings.clearance_caption_label | default: 'Clearance from the floor' -}}:
                  </span>
                  <span>{{ floor_clearance }}</span>
                </p>
              {% endif %}
              {% if delivery_option != blank %}
                <p class="product-specs__caption">
                  <span class="product-specs__caption-label">
                    {{- section.settings.delivery_caption_label | default: 'Delivery option' -}}:
                  </span>
                  <span>{{ delivery_option }}</span>
                </p>
              {% endif %}
            </div>
          {% endif %}

          {%- comment -%} Full spec list, one row per configured block that has a value. {%- endcomment -%}
          {% if populated_rows > 0 %}
            <dl class="product-specs__list">
              {% for block in section.blocks %}
                {% if block.type != 'spec' %}
                  {% continue %}
                {% endif %}

                {% assign row_value = product.metafields[ns][block.settings.metafield_key].value %}
                {% if row_value == blank %}
                  {% continue %}
                {% endif %}

                <div
                  class="product-specs__row"
                  {{ block.shopify_attributes }}
                >
                  <dt class="product-specs__term">{{ block.settings.label }}</dt>
                  <dd class="product-specs__value">
                    {% if block.settings.is_link and block.settings.link_url != blank %}
                      <a href="{{ block.settings.link_url }}">{{ row_value }}</a>
                    {% else %}
                      {{ row_value }}
                    {% endif %}
                  </dd>
                </div>
              {% endfor %}
            </dl>
          {% endif %}

          {%- comment -%} Downloadable files, from a file-list metafield. {%- endcomment -%}
          {% if has_files %}
            <div class="product-specs__files">
              {% if section.settings.files_heading != blank %}
                <h3 class="product-specs__files-heading">{{ section.settings.files_heading }}</h3>
              {% endif %}

              <ul class="product-specs__file-list">
                {% for file in spec_files %}
                  <li>
                    <a
                      href="{{ file | file_url }}"
                      class="product-specs__file"
                      download
                    >
                      <span class="svg-wrapper product-specs__file-icon" aria-hidden="true">
                        {{- 'icon-file.svg' | inline_asset_content -}}
                      </span>
                      <span class="product-specs__file-name">
                        {{- file.alt | default: file | default: section.settings.file_fallback_label -}}
                      </span>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {%- comment -%} ---- Description ---- {%- endcomment -%}
      {% if has_description_tab %}
        <div
          class="product-specs__panel product-specs__prose"
          ref="panels[]"
          data-panel="description"
          role="tabpanel"
          {% unless first_tab == 'description' %}
            hidden
          {% endunless %}
        >
          {{ product.description }}
        </div>
      {% endif %}

      {%- comment -%} ---- Care instructions ---- {%- endcomment -%}
      {% if has_care_tab %}
        <div
          class="product-specs__panel product-specs__prose"
          ref="panels[]"
          data-panel="care"
          role="tabpanel"
          {% unless first_tab == 'care' %}
            hidden
          {% endunless %}
        >
          {{ care_text }}
        </div>
      {% endif %}
    </showcase-panel-tabs-component>
  </div>
{% endif %}

<script
  src="{{ 'showcase-panel-tabs.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% stylesheet %}
  .product-specs__heading {
    margin: 0 0 var(--margin-xl);
    font-size: var(--font-size--2xl);
  }

  .product-specs__panel {
    padding-block-start: var(--padding-2xl);
  }

  /*
    Underlined tab strip, styled locally rather than on the shared pill classes so
    the pill version used by the delivery and related-products blocks is untouched.
    `panel-tab--active` is the one shared name kept, because the tab component
    toggles exactly that class.
  */
  .product-specs__tabstrip {
    display: flex;
    gap: var(--gap-xl);
    width: 100%;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    /* Three long labels will not fit a phone; the strip scrolls instead. */
    overflow-x: auto;
    scrollbar-width: none;
  }

  .product-specs__tabstrip::-webkit-scrollbar {
    display: none;
  }

  .product-specs__tab {
    flex: 0 0 auto;
    padding: var(--padding-xs) 0;
    border: 0;
    /* Reserves the active underline's space so the row cannot shift on select. */
    border-block-end: 2px solid transparent;
    background: transparent;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    font-size: var(--font-size--md);
    white-space: nowrap;
    cursor: pointer;
  }

  .product-specs__tab.panel-tab--active {
    border-block-end-color: var(--color-foreground);
    color: var(--color-foreground);
    font-weight: 600;
  }

  /* Rich text coming from the product body or the care metafield. */
  .product-specs__prose {
    max-width: 72ch;
    font-size: var(--font-size--sm);
    line-height: 1.7;
  }

  .product-specs__prose > :first-child {
    margin-block-start: 0;
  }

  .product-specs__prose > :last-child {
    margin-block-end: 0;
  }

  .product-specs__diagram {
    display: flex;
    justify-content: center;
  }

  .product-specs__diagram img {
    max-width: min(100%, 720px);
    height: auto;
  }

  .product-specs__captions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-lg);
    padding-block: var(--padding-2xl);
  }

  .product-specs__caption {
    margin: 0;
    font-size: var(--font-size--sm);
  }

  .product-specs__caption-label {
    font-weight: 600;
  }

  /* Spec list flows into columns with a dotted leader per row. */
  .product-specs__list {
    display: grid;
    grid-template-columns: repeat(var(--specs-columns, 2), minmax(0, 1fr));
    gap: var(--gap-2xs) var(--gap-3xl);
    margin: 0;
    padding-block-start: var(--padding-lg);
    border-block-start: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .product-specs__row {
    display: flex;
    align-items: baseline;
    gap: var(--gap-2xs);
    padding-block: var(--padding-2xs);
  }

  .product-specs__term {
    flex-shrink: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--sm);
  }

  .product-specs__value {
    margin: 0;
    margin-inline-start: auto;
    font-size: var(--font-size--sm);
    text-align: right;
  }

  .product-specs__value a {
    color: var(--product-link-accent, #b8813f);
  }

  .product-specs__files {
    padding-block-start: var(--padding-2xl);
  }

  .product-specs__files-heading {
    margin: 0 0 var(--margin-md);
    font-size: var(--font-size--lg);
  }

  .product-specs__file-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-specs__file {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
    color: var(--product-link-accent, #3b7de0);
    font-size: var(--font-size--sm);
    text-decoration: none;
  }

  .product-specs__file:hover {
    text-decoration: underline;
  }

  .product-specs__file-icon,
  .product-specs__file-icon svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .product-specs__heading {
      font-size: var(--font-size--xl);
    }

    .product-specs__captions,
    .product-specs__list {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product specs",
  "tag": "section",
  "class": "section-product-specs",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads product metafields. Rows without a value are hidden, and the whole section disappears when nothing is populated."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "specifications",
      "info": "Target of the sticky bar's \"Characteristics\" link."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "header",
      "content": "Diagram tabs"
    },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Tab group accessible label",
      "default": "Specification views"
    },
    {
      "type": "text",
      "id": "tab_specs_label",
      "label": "Specifications tab label",
      "default": "Specifications"
    },
    {
      "type": "text",
      "id": "tab_description_label",
      "label": "Description tab label",
      "default": "Description",
      "info": "Hidden for products with no description."
    },
    {
      "type": "text",
      "id": "tab_care_label",
      "label": "Care tab label",
      "default": "Care Instructions",
      "info": "Hidden unless the product's custom.care_instructions metafield is filled in."
    },
    {
      "type": "text",
      "id": "tab_additional_label",
      "label": "Additional diagram alt text",
      "default": "Additional"
    },
    {
      "type": "header",
      "content": "Caption stats"
    },
    {
      "type": "text",
      "id": "dimensions_caption_label",
      "label": "Dimensions label",
      "default": "Dimensions (L x W x H)"
    },
    {
      "type": "text",
      "id": "clearance_caption_label",
      "label": "Clearance label",
      "default": "Clearance from the floor"
    },
    {
      "type": "text",
      "id": "delivery_caption_label",
      "label": "Delivery option label",
      "default": "Delivery option"
    },
    {
      "type": "header",
      "content": "Files"
    },
    {
      "type": "text",
      "id": "files_heading",
      "label": "Files heading",
      "default": "Useful files"
    },
    {
      "type": "text",
      "id": "file_fallback_label",
      "label": "Fallback file name",
      "default": "Download"
    },
    {
      "type": "header",
      "content": "Layout and colors"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Spec list columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Body material"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Metafield key",
          "default": "body_material",
          "info": "Key within the namespace above. The row hides if this metafield is empty."
        },
        {
          "type": "checkbox",
          "id": "is_link",
          "label": "Render value as a link",
          "default": false
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL",
          "visible_if": "{{ block.settings.is_link }}"
        }
      ]
    }
  ]
}
{% endschema %}
