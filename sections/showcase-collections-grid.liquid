{% comment %}
  Collections grid. Three cards per row on desktop; on mobile the grid becomes a
  horizontal scroller showing one card plus a peek of the next.
{% endcomment %}

{% liquid
  assign card_blocks = section.blocks | where: 'type', 'card'
%}

<div
  class="section-background"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
></div>

<div
  class="section section--{{ section.settings.section_width }} showcase-collections spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
    --collections-columns: {{ section.settings.columns }};
    --collections-heading-size: {{ section.settings.heading_size }};
    --collections-footer-background: {{ section.settings.card_footer_background | default: '#f2f2f0' }};
    --collections-arrow-background: {{ section.settings.arrow_background | default: '#1c1c1c' }};
    --collections-arrow-icon: {{ section.settings.arrow_icon_color | default: '#ffffff' }};
  "
>
  {% if section.settings.heading != blank %}
    <h2 class="showcase-collections__heading">{{ section.settings.heading }}</h2>
  {% endif %}


  <div class="showcase-collections__grid">
    {% for block in card_blocks %}
      {%- liquid
        assign card_tag = 'div'
        if block.settings.link != blank
          assign card_tag = 'a'
        endif
      -%}
      <{{ card_tag }}
        {% if card_tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
        class="collection-card"
        {{ block.shopify_attributes }}
      >
        <span class="collection-card__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag: loading: 'lazy', class: 'collection-card__image', alt: block.settings.title, sizes: '(min-width: 750px) 31vw, 72vw', widths: '300, 450, 600, 750, 900'
            }}
          {% elsif request.design_mode %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'collection-card__image collection-card__image--placeholder' }}
          {% endif %}

        </span>

        <span class="collection-card__footer">
          <span class="collection-card__text">
            {% if block.settings.title != blank %}
              <span class="collection-card__title">{{ block.settings.title }}</span>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <span class="collection-card__subtitle">{{ block.settings.subtitle }}</span>
            {% endif %}
          </span>

          <span class="collection-card__arrow" aria-hidden="true">
            <span class="svg-wrapper">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </span>
        </span>
      </{{ card_tag }}>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .showcase-collections__heading {
    margin: 0 0 var(--margin-lg);
    font-size: var(--collections-heading-size, var(--font-size--3xl));
    line-height: var(--line-height--heading-tight);
  }

  .showcase-collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--collections-columns, 3), minmax(0, 1fr));
    gap: var(--gap-lg);
  }

  /*
    Every `.collection-card` rule is scoped under `.showcase-collections`, which is
    unique to this section. The bare class is NOT unique — Horizon's own
    collection-card, bento-grid and editorial-collection-grid snippets and base.css
    all use it, so unscoped rules here leak into those.
  */
  .showcase-collections .collection-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--style-border-radius-inputs, 8px);
    color: var(--color-foreground);
    text-decoration: none;
    overflow: hidden;
  }

  .showcase-collections .collection-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
    overflow: hidden;
  }

  .showcase-collections .collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--animation-speed-slow) var(--animation-easing);
  }

  .showcase-collections .collection-card:hover .collection-card__image {
    scale: 1.03;
  }

  .showcase-collections .collection-card__image--placeholder {
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .showcase-collections .collection-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    padding: var(--padding-md);
    background-color: var(--collections-footer-background);
  }

  .showcase-collections .collection-card__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .showcase-collections .collection-card__title {
    font-size: var(--font-size--md);
    font-weight: 600;
  }

  .showcase-collections .collection-card__subtitle {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  .showcase-collections .collection-card__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--collections-arrow-background);
    color: var(--collections-arrow-icon);
  }

  .showcase-collections .collection-card__arrow .svg-wrapper,
  .showcase-collections .collection-card__arrow svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  /*
    ---- Mobile ----
    One large card plus a peek of the next, matching the reference. Desktop is
    untouched: everything here lives inside the 749px query and stays scoped to
    `.showcase-collections`.
  */
  @media screen and (max-width: 749px) {
    /* Tighter gutter than the 16px page margin, without letting the page scroll. */
    .showcase-collections.spacing-style {
      padding-block-start: 20px;
    }

    .showcase-collections__heading {
      margin-block-end: 14px;
      font-size: var(--font-size--lg);
    }

    /* Pills stay on one line and scroll horizontally. */
    .showcase-collections__grid {
      display: flex;
      gap: 11px;
      /* Pulls the row 4px into the page gutter for a ~12px effective margin. */
      margin-inline: -4px;
      padding-inline: 4px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .showcase-collections__grid::-webkit-scrollbar {
      display: none;
    }

    .showcase-collections .collection-card {
      flex: 0 0 clamp(220px, 74vw, 280px);
      width: auto;
      /* Stretch keeps every card the same height regardless of text length. */
      align-self: stretch;
      border-radius: 2px;
      background-color: #f5f4f1;
      box-shadow: none;
      scroll-snap-align: start;
    }

    .showcase-collections .collection-card__media {
      aspect-ratio: 1 / 1;
    }


    .showcase-collections .collection-card__footer {
      /* Top-aligned so the arrow sits level with the title, not the whole block. */
      align-items: flex-start;
      gap: 8px;
      flex: 1 1 auto;
      padding: 11px;
      background-color: transparent;
    }

    .showcase-collections .collection-card__text {
      gap: 3px;
    }

    /* Clamping both lines is what keeps the card heights equal. */
    .showcase-collections .collection-card__title {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      font-size: 13.5px;
      line-height: 1.3;
      overflow: hidden;
    }

    .showcase-collections .collection-card__subtitle {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      font-size: 10.5px;
      line-height: 1.45;
      overflow: hidden;
    }

    .showcase-collections .collection-card__arrow {
      width: 22px;
      height: 22px;
      /* Nudged down to centre against the first line of the title. */
      margin-block-start: 1px;
    }

    .showcase-collections .collection-card__arrow .svg-wrapper,
    .showcase-collections .collection-card__arrow svg {
      width: 11px;
      height: 11px;
    }

    /* Subtle rule closing the section. */
    .showcase-collections__grid::after {
      content: '';
      flex: 0 0 1px;
    }

    .showcase-collections.spacing-style {
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
      padding-block-end: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections grid",
  "tag": "section",
  "class": "section-showcase-collections",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections and co-creation"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "var(--font-size--2xl)", "label": "Medium" },
        { "value": "var(--font-size--3xl)", "label": "Large" },
        { "value": "var(--font-size--4xl)", "label": "Extra large" }
      ],
      "default": "var(--font-size--3xl)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards per row on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "card_footer_background",
      "label": "Card footer background",
      "default": "#f2f2f0"
    },
    {
      "type": "color",
      "id": "arrow_background",
      "label": "Card arrow background",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "arrow_icon_color",
      "label": "Card arrow icon",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lorem ipsum dolor. SIT."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Consectetur adipiscing elit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections grid",
      "blocks": [
        { "type": "card", "settings": { "title": "Lorem ipsum. SIT.", "subtitle": "Collection for teenagers" } },
        { "type": "card", "settings": { "title": "Dolor sit x AMET", "subtitle": "Children's poufs and pillows" } },
        { "type": "card", "settings": { "title": "Consectetur", "subtitle": "Bright furniture for home and garden" } }
      ]
    }
  ]
}
{% endschema %}
