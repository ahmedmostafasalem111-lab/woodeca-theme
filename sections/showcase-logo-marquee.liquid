{% comment %}
  Slim auto-scrolling logo strip with a static label on the left.

  Pure CSS marquee — no JS, no arrows, no drag. The track is rendered three times
  as identical siblings and every copy animates together by exactly its own width
  plus one gap, so the moment one copy leaves the viewport the next is already in
  the same position. That is what makes the loop seamless; a single copy would
  show a gap on wrap.

  The same `--marquee-gap` spaces logos inside a track AND the tracks from each
  other, which is what keeps the seam invisible.
{% endcomment %}

{% liquid
  assign logos = section.blocks | where: 'type', 'logo'
  assign speed = section.settings.scroll_speed | default: 30
%}

{%- comment -%} QA-014: an empty section renders nothing — no padded wrapper, no gap. {%- endcomment -%}
{%- liquid
  assign has_content = false
  assign marquee_logos = section.blocks | where: 'type', 'logo'
  if marquee_logos.size > 0
    assign has_content = true
  endif
-%}
{% if has_content %}
<div
  class="section section--{{ section.settings.section_width }} logo-marquee spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
    --marquee-speed: {{ speed }}s;
    --marquee-heading-size: {{ section.settings.heading_size }}px;
    --marquee-logo-height: {{ section.settings.logo_height }}px;
    --marquee-logo-max-width: {{ section.settings.logo_max_width }}px;
  "
>
  {% if logos.size > 0 %}
    <div class="logo-marquee__row">
      {% if section.settings.show_heading and section.settings.heading != blank %}
        <div class="logo-marquee__label">
          <span class="logo-marquee__heading">{{ section.settings.heading }}</span>
        </div>
      {% endif %}

      <div
        class="logo-marquee__viewport{% if section.settings.grayscale %} logo-marquee__viewport--grayscale{% endif %}"
        {% if section.settings.direction == 'right' %}
          data-direction="right"
        {% endif %}
      >
        {%- comment -%}
          Three copies. Only the first carries real alt text — the other two are
          hidden from assistive tech so logos are not announced three times.
        {%- endcomment -%}
        {% for i in (1..3) %}
          <div
            class="logo-marquee__track"
            {% unless forloop.first %}
              aria-hidden="true"
            {% endunless %}
          >
            {% for block in logos %}
              <div class="logo-marquee__item" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  {% if forloop.parentloop.first %}
                    {{
                      block.settings.image
                      | image_url: width: 400
                      | image_tag: loading: 'lazy', class: 'logo-marquee__logo', alt: block.settings.alt, sizes: '136px', widths: '136, 272, 400'
                    }}
                  {% else %}
                    {{
                      block.settings.image
                      | image_url: width: 400
                      | image_tag: loading: 'lazy', class: 'logo-marquee__logo', alt: '', sizes: '136px', widths: '136, 272, 400'
                    }}
                  {% endif %}
                {% else %}
                  <span class="logo-marquee__placeholder">
                    {{- block.settings.alt | default: 'Logo' -}}
                  </span>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% endif %}

{% stylesheet %}
  .logo-marquee__row {
    display: flex;
    align-items: center;
    column-gap: 25px;
    overflow: hidden;
  }

  /*
    Floor of 144px, but `flex: 0 0 auto` lets the block grow with the text so a
    larger heading size stays on one line instead of wrapping or clipping.
  */
  .logo-marquee__label {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 144px;
  }

  .logo-marquee__heading {
    color: var(--color-foreground);
    font-size: var(--marquee-heading-size, 14px);
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
  }

  /*
    Viewport owns the gap variable so the tracks and the logos inside them share
    one value. The mask fades both edges instead of hard-cutting the logos.
  */
  .logo-marquee__viewport {
    --marquee-gap: 32px;

    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    user-select: none;
    /*
      Narrow fade. At 5% of a ~1600px strip the ramp is 80px wide, which washes out
      most of whichever logo is at the edge; 2% keeps the softening without eating one.
      Prefixed copy for WebKit, which still needs it.
    */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 2%, black 98%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 2%, black 98%, transparent 100%);
  }

  /* Height comes from the items — nothing in the chain forces it to zero. */
  .logo-marquee__track {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-around;
    gap: var(--marquee-gap);
    min-height: var(--marquee-logo-height, 64px);
    will-change: transform;
    animation: logo-marquee-scroll var(--marquee-speed, 30s) linear infinite;
  }

  .logo-marquee__viewport[data-direction='right'] .logo-marquee__track {
    animation-direction: reverse;
  }

  /* Travels its own width plus one gap, so the next copy lands exactly in place. */
  @keyframes logo-marquee-scroll {
    0% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(calc(-100% - var(--marquee-gap)));
    }
  }

  /*
    Explicit min-height, not just a cap. `max-height` alone never creates a height,
    so before the images load the item had nothing to size from and collapsed to 0 —
    which then kept the lazy images permanently out of the viewport.
  */
  .logo-marquee__item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: var(--marquee-logo-height, 64px);
  }

  .logo-marquee__logo {
    /* Real height; width follows the logo's aspect ratio. */
    height: var(--marquee-logo-height, 64px);
    width: auto;
    max-width: var(--marquee-logo-max-width, 160px);
    flex-shrink: 0;
    object-fit: contain;
  }

  .logo-marquee__viewport--grayscale .logo-marquee__logo {
    filter: grayscale(1);
  }

  .logo-marquee__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--marquee-logo-max-width, 124px);
    height: var(--marquee-logo-height, 44px);
    border-radius: 4px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    font-size: var(--font-size--xs);
    text-align: center;
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .logo-marquee__viewport {
      --marquee-gap: 52px;
    }
  }

  @media screen and (min-width: 990px) {
    .logo-marquee__viewport {
      --marquee-gap: 90px;
    }
  }

  /* Label stacks above the strip on small screens. */
  @media screen and (max-width: 749px) {
    .logo-marquee__row {
      flex-direction: column;
      column-gap: 0;
      row-gap: 10px;
    }

    .logo-marquee__label {
      min-width: 0;
      max-width: 100%;
    }

    /* Stacked above the strip, so a long heading may wrap rather than overflow. */
    .logo-marquee__heading {
      white-space: normal;
      text-wrap: balance;
    }

    .logo-marquee__viewport {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee__track {
      animation: none;
    }

    /* Static, but still reachable by scrolling rather than clipped. */
    .logo-marquee__viewport {
      overflow-x: auto;
      mask-image: none;
    }

    .logo-marquee__track:not(:first-child) {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Logo marquee",
  "tag": "section",
  "class": "section-logo-marquee",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Payment Partners"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 11,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Seconds per loop",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 30,
      "info": "Higher is slower. Motion is disabled automatically for visitors who prefer reduced motion."
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "info": "Raise this if your logo files have white space baked around the mark."
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo maximum width",
      "min": 60,
      "max": 260,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Display logos in grayscale",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout and colors"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Describes the logo for screen readers, e.g. the provider name."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo marquee",
      "blocks": [
        { "type": "logo", "settings": { "alt": "Visa" } },
        { "type": "logo", "settings": { "alt": "Mastercard" } },
        { "type": "logo", "settings": { "alt": "American Express" } },
        { "type": "logo", "settings": { "alt": "Meeza" } },
        { "type": "logo", "settings": { "alt": "Fawry" } },
        { "type": "logo", "settings": { "alt": "ValU" } },
        { "type": "logo", "settings": { "alt": "Cash on delivery" } },
        { "type": "logo", "settings": { "alt": "Instalments" } }
      ]
    }
  ]
}
{% endschema %}
