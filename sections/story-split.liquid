{% comment %}
  Story page "image with text", stacked edge to edge like Mocka's story page.
  Desktop (≥990px): the image takes 62.5% of the screen and bleeds to its edge
  (left or right), 640px tall; the text sits in the other 37.5%, vertically
  centred, max 340px wide. Phones: full-width image (1.6:1), then the text.
  Images always lazy-load at low priority so they never compete with the hero.
  No image: a text-only block (a placeholder only in the theme editor).
{% endcomment %}
{%- liquid
  assign image = section.settings.image
  assign has_image = false
  if image != blank or request.design_mode
    assign has_image = true
  endif
-%}

<div
  class="story-split story-split--image-{{ section.settings.image_side | default: 'right' }}{% unless has_image %} story-split--text-only{% endunless %}"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
>
  {% if has_image %}
    <div class="story-split__media">
      {% if image != blank %}
        {{
          image
          | image_url: width: 1800
          | image_tag:
            class: 'story-split__image',
            loading: 'lazy',
            fetchpriority: 'low',
            widths: '390, 600, 750, 900, 1100, 1400, 1800',
            sizes: '(min-width: 990px) 62.5vw, 100vw',
            alt: image.alt
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'story-split__image story-split__image--placeholder' }}
      {% endif %}
    </div>
  {% endif %}

  <div class="story-split__text">
    <div class="story-split__text-inner">
      {% if section.settings.heading != blank %}
        <h2 class="story-split__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="story-split__body">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.link_label != blank and section.settings.link_url != blank %}
        <a class="story-split__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .story-split {
    display: flex;
    flex-direction: column;
  }

  .story-split__media {
    aspect-ratio: 1.6 / 1;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .story-split__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-split__text {
    padding: 32px 16px;
  }

  .story-split__heading {
    margin: 0 0 16px;
    font-family: var(--font-heading--family);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
  }

  .story-split__body {
    font-size: 16px;
    line-height: 26px;
  }

  .story-split__body > :first-child {
    margin-block-start: 0;
  }

  .story-split__body > :last-child {
    margin-block-end: 0;
  }

  .story-split__link {
    display: inline-block;
    margin-block-start: 20px;
    color: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media screen and (min-width: 990px) {
    .story-split {
      flex-direction: row;
      align-items: stretch;
      min-height: 640px;
    }

    .story-split--image-left {
      flex-direction: row;
    }

    .story-split--image-right {
      flex-direction: row-reverse;
    }

    .story-split__media {
      flex: 0 0 62.5%;
      aspect-ratio: auto;
      height: 640px;
    }

    .story-split__text {
      display: flex;
      flex: 1 1 37.5%;
      align-items: center;
      justify-content: center;
      padding: 48px 40px;
    }

    .story-split__text-inner {
      width: 100%;
      max-width: 340px;
    }

    .story-split__heading {
      font-size: 36px;
    }

    .story-split--text-only {
      min-height: 0;
    }

    .story-split--text-only .story-split__text {
      padding-block: 96px;
    }

    .story-split--text-only .story-split__text-inner {
      max-width: 720px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story image with text",
  "tag": "section",
  "class": "section-story-split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made in our own factory" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "color", "id": "background_color", "label": "Text side background", "info": "Optional." }
  ],
  "presets": [{ "name": "Story image with text" }]
}
{% endschema %}
