{% comment %}
  Content/info image cards. Each card is a full-bleed image with a bottom-left text
  overlay and no visible button — the whole card is the link. Three per row on
  desktop, swipeable with a peek of the next card on mobile.

  `show_section` lets a placement whose content has not been written yet be
  switched off rather than deleted and rebuilt later. It defaults to on, so every
  existing placement is unaffected.
{% endcomment %}

{%- comment -%} QA-014: an empty section renders nothing — no padded wrapper, no gap. {%- endcomment -%}
{%- liquid
  assign has_content = false
  if section.settings.heading != blank
    assign has_content = true
  endif
  for block in section.blocks
    if block.settings.image != blank or block.settings.heading != blank or block.settings.subtext != blank
      assign has_content = true
      break
    endif
  endfor
-%}
{% if section.settings.show_section and has_content %}
<div
  class="section-background"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
></div>

<div
  class="section section--{{ section.settings.section_width }} showcase-info spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
    --info-heading-size: {{ section.settings.heading_size }};
    --info-card-text: {{ section.settings.card_text_color | default: '#ffffff' }};
    --info-scrim-opacity: {{ section.settings.scrim_opacity | divided_by: 100.0 }};
  "
>
  {% if section.settings.heading != blank %}
    <h2 class="showcase-info__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {%- capture info_cards -%}
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="info-card"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 900
            | image_tag: loading: 'lazy', class: 'info-card__image', alt: block.settings.heading, sizes: '(min-width: 750px) 31vw, 85vw', widths: '300, 450, 600, 750, 900'
          }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'info-card__image info-card__image--placeholder' }}
        {% endif %}

        <span class="info-card__scrim" aria-hidden="true"></span>

        <span class="info-card__content">
          {% if block.settings.heading != blank %}
            <span class="info-card__title">{{ block.settings.heading }}</span>
          {% endif %}
          {% if block.settings.subtext != blank %}
            <span class="info-card__subtext">{{ block.settings.subtext }}</span>
          {% endif %}
        </span>
      </a>
    {%- endfor -%}
  {%- endcapture -%}

  {% render 'scroll-row',
    content: info_cards,
    columns: section.settings.columns,
    columns_mobile: 1,
    peek: 0.15,
    show_arrows: section.settings.show_arrows,
    show_progress: section.settings.show_progress,
    gap: 'var(--gap-lg)',
    prev_label: 'Previous cards',
    next_label: 'Next cards'
  %}
</div>
{% endif %}

{% stylesheet %}
  .showcase-info__heading {
    margin: 0 0 var(--margin-xl);
    font-size: var(--info-heading-size, var(--font-size--3xl));
    line-height: var(--line-height--heading-tight);
  }

  .info-card {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--style-border-radius-inputs, 8px);
    color: var(--info-card-text);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
  }

  .info-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--animation-speed-slow) var(--animation-easing);
  }

  .info-card:hover .info-card__image {
    scale: 1.04;
  }

  .info-card__image--placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  /* Scrim keeps the overlay copy legible against any photograph. */
  .info-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / var(--info-scrim-opacity)) 0%,
      rgb(0 0 0 / calc(var(--info-scrim-opacity) * 0.4)) 45%,
      transparent 75%
    );
  }

  .info-card__content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs);
    padding: var(--padding-lg);
  }

  .info-card__title {
    font-size: var(--font-size--xl);
    font-weight: 700;
    line-height: var(--line-height--heading-tight);
    text-wrap: balance;
  }

  .info-card__subtext {
    font-size: var(--font-size--sm);
  }

  @media screen and (max-width: 749px) {
    .showcase-info__heading {
      font-size: var(--font-size--xl);
    }

    .info-card__title {
      font-size: var(--font-size--lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Info image cards",
  "tag": "section",
  "class": "section-showcase-info",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show this section",
      "default": true,
      "info": "Turn off to hide the block without deleting its content."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More useful information"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "var(--font-size--2xl)", "label": "Medium" },
        { "value": "var(--font-size--3xl)", "label": "Large" },
        { "value": "var(--font-size--4xl)", "label": "Extra large" }
      ],
      "default": "var(--font-size--3xl)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards visible on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show scroll progress bar",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading text",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card overlay text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "label": "Card scrim opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Info card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Lorem ipsum dolor"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Consectetur adipiscing elit sed do"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Info image cards",
      "blocks": [
        { "type": "card", "settings": { "heading": "Design project as a gift", "subtext": "We will refund its cost with loyalty bonuses." } },
        { "type": "card", "settings": { "heading": "Lorem Club bonuses", "subtext": "Update your interior profitably" } },
        { "type": "card", "settings": { "heading": "You can try it on", "subtext": "We deliver fabric samples to your home" } }
      ]
    }
  ]
}
{% endschema %}
