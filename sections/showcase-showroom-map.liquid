{% comment %}
  Showroom map section: heading + description above a two-column layout — a map
  embed on the left and a searchable, scrollable location list on the right.

  The map accepts either an embed URL (rendered in an iframe) or a static
  placeholder image, so the section is presentable before a real map is wired up.
{% endcomment %}

<div
  class="section-background"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
></div>

<div
  class="section section--{{ section.settings.section_width }} showcase-map spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
    --map-width: {{ section.settings.map_width }}%;
    --map-height: {{ section.settings.map_height }}px;
    --map-heading-size: {{ section.settings.heading_size }};
  "
>
  {% if section.settings.heading != blank or section.settings.description != blank %}
    <div class="showcase-map__header">
      {% if section.settings.heading != blank %}
        <h2 class="showcase-map__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="showcase-map__description">{{ section.settings.description }}</div>
      {% endif %}
    </div>
  {% endif %}

  <showcase-locations-component class="showcase-map__columns">
    <div class="showcase-map__map">
      {% if section.settings.map_embed_url != blank %}
        <iframe
          src="{{ section.settings.map_embed_url }}"
          class="showcase-map__frame"
          title="{{ section.settings.map_title | default: 'Showroom locations map' | escape }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      {% elsif section.settings.map_image != blank %}
        {{
          section.settings.map_image
          | image_url: width: 1600
          | image_tag: loading: 'lazy', class: 'showcase-map__image', alt: section.settings.map_title
        }}
      {% else %}
        <div class="showcase-map__empty-map">
          <span class="svg-wrapper" aria-hidden="true">
            {{- 'icon-pin.svg' | inline_asset_content -}}
          </span>
          <p>{{ section.settings.map_placeholder_text }}</p>
        </div>
      {% endif %}
    </div>

    <div class="showcase-map__panel">
      <div class="showcase-map__search">
        <label
          for="location-search-{{ section.id }}"
          class="visually-hidden"
        >
          {{ section.settings.search_placeholder | default: 'Address or name' }}
        </label>
        <input
          type="text"
          id="location-search-{{ section.id }}"
          class="showcase-map__search-input"
          ref="search"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          autocomplete="off"
          on:input="/filterLocations"
        >
        <span class="svg-wrapper showcase-map__search-icon" aria-hidden="true">
          {{- 'icon-search.svg' | inline_asset_content -}}
        </span>
      </div>

      <div class="showcase-map__list">
        {% for block in section.blocks %}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="location-entry"
            ref="entries[]"
            {{ block.shopify_attributes }}
          >
            <span class="location-entry__icon svg-wrapper" aria-hidden="true">
              {{- 'icon-store.svg' | inline_asset_content -}}
            </span>

            <span class="location-entry__body">
              {% if block.settings.tags != blank %}
                <span class="location-entry__tags">
                  {% assign tag_list = block.settings.tags | split: ',' %}
                  {% for tag in tag_list %}
                    <span class="location-entry__tag">{{ tag | strip }}</span>
                  {% endfor %}
                </span>
              {% endif %}

              <span class="location-entry__name-row">
                <span class="location-entry__name">{{ block.settings.name }}</span>
                <span class="location-entry__chevron svg-wrapper" aria-hidden="true">
                  {{- 'icon-chevron-right.svg' | inline_asset_content -}}
                </span>
              </span>

              {% if block.settings.address != blank %}
                <span class="location-entry__address">{{ block.settings.address }}</span>
              {% endif %}
            </span>
          </a>
        {% endfor %}

        <p
          class="showcase-map__no-results"
          ref="empty"
          hidden
        >
          {{ section.settings.no_results_text }}
        </p>
      </div>
    </div>
  </showcase-locations-component>
</div>

<script
  src="{{ 'showcase-locations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% stylesheet %}
  .showcase-map__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    margin-block-end: var(--margin-xl);
  }

  .showcase-map__heading {
    margin: 0;
    font-size: var(--map-heading-size, var(--font-size--3xl));
    line-height: var(--line-height--heading-tight);
  }

  .showcase-map__description {
    max-width: 80ch;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--md);
  }

  .showcase-map__description > :first-child {
    margin-block-start: 0;
  }

  .showcase-map__description > :last-child {
    margin-block-end: 0;
  }

  .showcase-map__columns {
    display: grid;
    grid-template-columns: var(--map-width) 1fr;
    gap: var(--gap-lg);
  }

  .showcase-map__map {
    height: var(--map-height, 520px);
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
    overflow: hidden;
  }

  .showcase-map__frame {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .showcase-map__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-map__empty-map {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xs);
    height: 100%;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    text-align: center;
  }

  .showcase-map__empty-map .svg-wrapper,
  .showcase-map__empty-map svg {
    width: var(--icon-size-lg);
    height: var(--icon-size-lg);
  }

  .showcase-map__panel {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    height: var(--map-height, 520px);
  }

  .showcase-map__search {
    position: relative;
    flex-shrink: 0;
  }

  .showcase-map__search-input {
    width: 100%;
    padding: var(--padding-sm) var(--padding-2xl) var(--padding-sm) var(--padding-md);
    border: var(--style-border-width-inputs) solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: var(--font-size--sm);
  }

  .showcase-map__search-icon {
    position: absolute;
    top: 50%;
    right: var(--padding-sm);
    translate: 0 -50%;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    pointer-events: none;
  }

  .showcase-map__list {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .location-entry {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--gap-sm);
    padding-block: var(--padding-md);
    border-block-end: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    color: var(--color-foreground);
    text-decoration: none;
  }

  .location-entry:hover {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .location-entry__icon {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    margin-block-start: 2px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
  }

  .location-entry__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .location-entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-3xs);
    margin-block-end: var(--margin-3xs);
  }

  .location-entry__tag {
    padding: 1px var(--padding-3xs);
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    font-size: var(--font-size--2xs);
  }

  .location-entry__name-row {
    display: flex;
    align-items: center;
    gap: var(--gap-3xs);
  }

  .location-entry__name {
    font-size: var(--font-size--sm);
    font-weight: 600;
  }

  .location-entry__chevron {
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
  }

  .location-entry__address {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--xs);
  }

  .showcase-map__no-results {
    padding-block: var(--padding-lg);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--sm);
  }

  @media screen and (max-width: 989px) {
    .showcase-map__columns {
      grid-template-columns: 1fr;
    }

    .showcase-map__panel {
      height: auto;
    }

    .showcase-map__list {
      max-height: 380px;
    }
  }

  @media screen and (max-width: 749px) {
    .showcase-map__heading {
      font-size: var(--font-size--xl);
    }

    .showcase-map__description {
      font-size: var(--font-size--sm);
    }

    .showcase-map__map {
      height: 320px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Showroom map",
  "tag": "section",
  "class": "section-showcase-map",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Seeing is believing!"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "var(--font-size--2xl)", "label": "Medium" },
        { "value": "var(--font-size--3xl)", "label": "Large" },
        { "value": "var(--font-size--4xl)", "label": "Extra large" }
      ],
      "default": "var(--font-size--3xl)"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem ipsum dolor sit amet. We invite you to visit our showrooms and personally evaluate the quality of our consectetur adipiscing elit.</p>"
    },
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "text",
      "id": "map_embed_url",
      "label": "Map embed URL",
      "info": "Paste the src URL from a Google Maps or Yandex Maps embed. Takes priority over the image below."
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Map placeholder image",
      "info": "Shown when no embed URL is set."
    },
    {
      "type": "text",
      "id": "map_title",
      "label": "Map accessible title",
      "default": "Showroom locations map"
    },
    {
      "type": "text",
      "id": "map_placeholder_text",
      "label": "Empty map message",
      "default": "Add a map embed URL or image in the theme editor."
    },
    {
      "type": "range",
      "id": "map_width",
      "label": "Map column width",
      "min": 40,
      "max": 75,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Map height",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "header",
      "content": "Location list"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Address or name"
    },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "No results message",
      "default": "No locations match your search."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Lorem Ipsum Showroom"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address",
          "default": "123 Dolor Sit Street, Amet District"
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Tags",
          "info": "Comma-separated, e.g. New, Flagship"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Showroom map",
      "blocks": [
        { "type": "location", "settings": { "name": "Lorem Central", "address": "12 Ipsum Avenue, Dolor", "tags": "New" } },
        { "type": "location", "settings": { "name": "Sit Amet Plaza", "address": "45 Consectetur Road, Adipiscing" } },
        { "type": "location", "settings": { "name": "Elit Mall", "address": "78 Tempor Boulevard, Incididunt", "tags": "Flagship" } },
        { "type": "location", "settings": { "name": "Labore Park", "address": "90 Magna Street, Aliqua" } },
        { "type": "location", "settings": { "name": "Veniam Square", "address": "34 Nostrud Lane, Exercitation" } }
      ]
    }
  ]
}
{% endschema %}
