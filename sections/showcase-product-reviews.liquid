{% comment %}
  Reviews block — empty-state UI only, plus a UGC photo-submission teaser strip.

  This deliberately does not store or render review data. Reviews on Shopify should
  come from a dedicated app (Judge.me, Loox, Shopify Product Reviews), which injects
  its own markup via an app block. When such an app is installed, point the "Add a
  review" button at it, or replace this section with the app's block.
{% endcomment %}

<div
  class="section section--{{ section.settings.section_width }} product-reviews spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --reviews-card-background: {{ section.settings.card_background | default: '#e4ede2' }};
    --reviews-cta-background: {{ section.settings.cta_background | default: '#333333' }};
    --reviews-cta-text: {{ section.settings.cta_text_color | default: '#ffffff' }};
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
  "
>
  {% if section.settings.heading != blank %}
    <h2 class="product-reviews__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="product-reviews__card">
    <div class="product-reviews__copy">
      {% if section.settings.empty_heading != blank %}
        <p class="product-reviews__empty-heading">{{ section.settings.empty_heading }}</p>
      {% endif %}

      {% if section.settings.empty_text != blank %}
        <p class="product-reviews__empty-text">{{ section.settings.empty_text }}</p>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a
          href="{{ section.settings.cta_link | default: '#' }}"
          class="product-reviews__cta"
        >
          {{- section.settings.cta_label -}}
        </a>
      {% endif %}
    </div>

    <div class="product-reviews__art" aria-hidden="true">
      {% if section.settings.illustration != blank %}
        {{
          section.settings.illustration
          | image_url: width: 600
          | image_tag: loading: 'lazy', alt: ''
        }}
      {% else %}
        <span class="svg-wrapper product-reviews__art-icon">
          {{- 'icon-heart.svg' | inline_asset_content -}}
        </span>
      {% endif %}
    </div>
  </div>

  {%- comment -%} UGC / photo-submission teaser strip. {%- endcomment -%}
  {% if section.settings.show_ugc and section.settings.ugc_heading != blank %}
    <div class="product-reviews__ugc">
      <div class="product-reviews__ugc-text">
        <p class="product-reviews__ugc-heading">{{ section.settings.ugc_heading }}</p>
        {% if section.settings.ugc_text != blank %}
          <p class="product-reviews__ugc-sub">{{ section.settings.ugc_text }}</p>
        {% endif %}
      </div>

      {% if section.settings.ugc_cta_label != blank %}
        <a
          href="{{ section.settings.ugc_cta_link | default: '#' }}"
          class="product-reviews__ugc-cta"
        >
          {{- section.settings.ugc_cta_label -}}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .product-reviews__heading {
    margin: 0 0 var(--margin-lg);
    font-size: var(--font-size--2xl);
  }

  .product-reviews__card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--gap-xl);
    align-items: center;
    padding: var(--padding-2xl);
    border-radius: var(--style-border-radius-inputs, 12px);
    background-color: var(--reviews-card-background);
  }

  .product-reviews__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
  }

  .product-reviews__empty-heading {
    margin: 0;
    font-size: var(--font-size--xl);
    font-weight: 700;
    text-wrap: balance;
  }

  .product-reviews__empty-text {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--sm);
  }

  .product-reviews__cta {
    margin-block-start: var(--margin-2xs);
    padding: var(--padding-sm) var(--padding-2xl);
    border-radius: var(--style-border-radius-buttons-primary, 4px);
    background-color: var(--reviews-cta-background);
    color: var(--reviews-cta-text);
    font-size: var(--font-size--sm);
    text-decoration: none;
  }

  .product-reviews__art img {
    display: block;
    width: auto;
    max-height: 150px;
  }

  .product-reviews__art-icon,
  .product-reviews__art-icon svg {
    width: 88px;
    height: 88px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-25));
  }

  .product-reviews__ugc {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-lg);
    margin-block-start: var(--margin-lg);
    padding: var(--padding-xl);
    border: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: var(--style-border-radius-inputs, 12px);
  }

  .product-reviews__ugc-heading {
    margin: 0;
    font-size: var(--font-size--lg);
    font-weight: 600;
  }

  .product-reviews__ugc-sub {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--sm);
  }

  .product-reviews__ugc-cta {
    flex-shrink: 0;
    color: var(--color-foreground);
    font-size: var(--font-size--sm);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .product-reviews__heading {
      font-size: var(--font-size--xl);
    }

    .product-reviews__card {
      grid-template-columns: 1fr;
      padding: var(--padding-xl);
    }

    /* Illustration drops below the copy and shrinks. */
    .product-reviews__art {
      justify-self: end;
    }

    .product-reviews__art img {
      max-height: 96px;
    }

    .product-reviews__ugc {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section-product-reviews",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Empty-state UI only — it does not store reviews. Install a reviews app (Judge.me, Loox) for real review data, then point the button at it or swap in the app's own block."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty state heading",
      "default": "There are no reviews yet, be the first!"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Share your experience and help other customers choose with confidence."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Add a review"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "illustration",
      "label": "Illustration",
      "info": "Optional line-art graphic shown on the right."
    },
    {
      "type": "header",
      "content": "Photo submission teaser"
    },
    {
      "type": "checkbox",
      "id": "show_ugc",
      "label": "Show teaser strip",
      "default": true
    },
    {
      "type": "text",
      "id": "ugc_heading",
      "label": "Teaser heading",
      "default": "Renovating your home? We want to see it!"
    },
    {
      "type": "text",
      "id": "ugc_text",
      "label": "Teaser text",
      "default": "Send us photos of your interior and get featured in our gallery."
    },
    {
      "type": "text",
      "id": "ugc_cta_label",
      "label": "Teaser link label",
      "default": "Submit a photo"
    },
    {
      "type": "url",
      "id": "ugc_cta_link",
      "label": "Teaser link"
    },
    {
      "type": "header",
      "content": "Layout and colors"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#e4ede2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
