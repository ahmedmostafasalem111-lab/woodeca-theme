{% comment %}
  Markup-only endpoint for the cart drawer's "You may also like" row.

  Requested by the drawer script as
  `/recommendations/products?product_id=…&section_id=showcase-cart-recommendations`,
  which is what populates `recommendations.products`. Rendering the cards here
  rather than from the JSON endpoint means Liquid formats the money, so the
  drawer never builds a currency string in JavaScript.

  This section is never placed on a page; it exists only to be fetched.
{% endcomment %}

{% for product in recommendations.products %}
  <a href="{{ product.url }}" class="cart-rec" data-cart-rec>
    {% if product.featured_image != blank %}
      {{
        product.featured_image
        | image_url: width: 160
        | image_tag: loading: 'lazy', class: 'cart-rec__image', alt: product.title
      }}
    {% endif %}

    <span class="cart-rec__text">
      <span class="cart-rec__title">{{ product.title }}</span>

      {% if product.metafields.reviews.rating.value != blank %}
        <span class="cart-rec__rating">
          ★ {{ product.metafields.reviews.rating.value.rating }}
          {%- if product.metafields.reviews.rating_count.value > 0 %}
            ({{ product.metafields.reviews.rating_count.value }})
          {% endif -%}
        </span>
      {% endif %}

      <span class="cart-rec__price">
        {{- product.price | money -}}
        {% if product.compare_at_price > product.price %}
          <span class="cart-rec__compare">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </span>

      <span class="cart-rec__cta">{{ section.settings.cta_label | default: 'Options' }}</span>
    </span>
  </a>
{% endfor %}

{% stylesheet %}
  /*
    The card styles live here, with the markup that uses them, even though the
    cards are injected into the cart drawer. Section stylesheets are compiled
    into the global bundle whether or not the section is placed on a page, so
    these rules are present wherever the drawer is.
  */
  .cart-rec {
    flex: 0 0 78%;
    display: flex;
    gap: var(--gap-2xs);
    padding: var(--padding-2xs);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    border-radius: 8px;
    scroll-snap-align: start;
    text-decoration: none;
  }

  .cart-rec__image {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    border-radius: 6px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    object-fit: contain;
  }

  .cart-rec__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cart-rec__title {
    color: var(--color-foreground);
    font-size: var(--font-size--xs);
    line-height: 1.3;
  }

  .cart-rec__rating {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--2xs);
  }

  .cart-rec__price {
    font-size: var(--font-size--xs);
    font-weight: 700;
  }

  .cart-rec__compare {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    font-size: var(--font-size--2xs);
    text-decoration: line-through;
  }

  .cart-rec__cta {
    align-self: start;
    margin-block-start: 2px;
    padding: 3px 10px;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: 999px;
    color: var(--color-foreground);
    font-size: var(--font-size--2xs);
  }

  @media screen and (min-width: 990px) {
    .cart-rec {
      flex-basis: 88%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart recommendations",
  "settings": [
    {
      "type": "text",
      "id": "cta_label",
      "label": "Card button label",
      "default": "Options"
    }
  ]
}
{% endschema %}
