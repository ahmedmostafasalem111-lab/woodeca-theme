{% comment %}
  One image beside one block of text, with an optional button.

  Two jobs, one section. The story page places it twice with the media on
  opposite sides so the two read as a before/after pair, and the designers page
  uses the same section for its sample-ordering promo. That is why the media side
  is a setting rather than a second file.

  `show_section` exists so a block the shop has no content for yet — samples,
  say — can be switched off in the editor instead of being deleted and rebuilt
  later.
{% endcomment %}

{%- comment -%} QA-014: an empty section renders nothing — no padded wrapper, no gap. {%- endcomment -%}
{%- liquid
  assign has_content = false
  if section.settings.image != blank or section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.body != blank or section.settings.button_label != blank
    assign has_content = true
  endif
-%}
{% if section.settings.show_section and has_content %}
  <div
    class="section-background"
    {% if section.settings.background_color != blank %}
      style="background-color: {{ section.settings.background_color }};"
    {% endif %}
  ></div>

  <div
    class="section section--{{ section.settings.section_width }} media-promo spacing-style"
    style="
      {% render 'spacing-padding', settings: section.settings %}
      {% if section.settings.text_color != blank %}
        --color-foreground: {{ section.settings.text_color }};
        --color-foreground-rgb: {{ section.settings.text_color.rgb }};
      {% endif %}
      --media-promo-button: {{ section.settings.button_background | default: '#1c1c1c' }};
      --media-promo-button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
      --media-promo-ratio: {{ section.settings.image_ratio | default: '4 / 3' }};
    "
  >
    <div class="media-promo__inner media-promo__inner--media-{{ section.settings.media_position | default: 'start' }}">
      <div class="media-promo__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', class: 'media-promo__image', alt: section.settings.heading, sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1200'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'media-promo__image media-promo__image--placeholder' }}
        {% endif %}
      </div>

      <div class="media-promo__text">
        {% if section.settings.eyebrow != blank %}
          <p class="media-promo__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="media-promo__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.body != blank %}
          <div class="media-promo__body">{{ section.settings.body }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="media-promo__button">
            {{- section.settings.button_label -}}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .media-promo__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-2xl);
    align-items: center;
  }

  /*
    Side is chosen with `order`, so the markup stays in one sequence — image then
    text — however the pair is arranged. Two sections placed with opposite sides
    therefore read identically to a screen reader while mirroring visually.
  */
  .media-promo__inner--media-end .media-promo__media {
    order: 2;
  }

  .media-promo__media {
    border-radius: var(--style-border-radius-inputs, 8px);
    overflow: hidden;
  }

  .media-promo__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--media-promo-ratio, 4 / 3);
    object-fit: cover;
  }

  .media-promo__image--placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .media-promo__eyebrow {
    margin: 0 0 var(--margin-2xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .media-promo__heading {
    margin: 0 0 var(--margin-md);
    font-size: var(--font-size--2xl);
    line-height: var(--line-height--heading-tight);
  }

  .media-promo__body {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--md);
    line-height: 1.7;
  }

  .media-promo__body > :first-child {
    margin-block-start: 0;
  }

  .media-promo__body > :last-child {
    margin-block-end: 0;
  }

  .media-promo__button {
    display: inline-block;
    margin-block-start: var(--margin-lg);
    padding: var(--padding-sm) var(--padding-xl);
    border-radius: 999px;
    background-color: var(--media-promo-button, #1c1c1c);
    color: var(--media-promo-button-text, #ffffff);
    font-size: var(--font-size--sm);
    font-weight: 600;
    text-decoration: none;
  }

  @media screen and (max-width: 989px) {
    .media-promo__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--gap-lg);
    }

    /* Image first on a phone whichever side it takes on desktop. */
    .media-promo__inner--media-end .media-promo__media {
      order: 0;
    }

    .media-promo__heading {
      font-size: var(--font-size--xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "section-media-promo",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show this section",
      "default": true,
      "info": "Turn off to hide the block without deleting its content."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image side on desktop",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait (3:4)" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to hide the button."
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "A full URL, or an anchor on this page such as #enquiry."
    },
    {
      "type": "header",
      "content": "Layout and colors"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
