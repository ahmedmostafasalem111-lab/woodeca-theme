{% comment %}
  Horizontal row of category tiles (image + label) with arrow navigation and a
  scroll progress bar. Eight tiles fit a desktop view; mobile shows about three
  and swipes.
{% endcomment %}

<div
  class="section-background"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
></div>

<div
  class="section section--{{ section.settings.section_width }} showcase-category-row spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
    --category-tile-background: {{ section.settings.tile_background | default: '#f2f2f0' }};
    --category-tile-radius: {{ section.settings.tile_radius }}px;
    --category-label-size: {{ section.settings.label_size }};
    --category-label-weight: {{ section.settings.label_weight }};
  "
>
  {% if section.settings.heading != blank %}
    <h2 class="showcase-category-row__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {%- capture tiles -%}
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="category-tile"
        {{ block.shopify_attributes }}
      >
        <span class="category-tile__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 400
              | image_tag: loading: 'lazy', class: 'category-tile__image', alt: block.settings.label
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'category-tile__image category-tile__image--placeholder' }}
          {% endif %}
        </span>

        {% if block.settings.label != blank %}
          <span class="category-tile__label">{{ block.settings.label }}</span>
        {% endif %}
      </a>
    {%- endfor -%}
  {%- endcapture -%}

  {% render 'scroll-row',
    content: tiles,
    columns: section.settings.columns,
    columns_mobile: section.settings.columns_mobile,
    peek: section.settings.peek_mobile,
    show_arrows: section.settings.show_arrows,
    show_progress: section.settings.show_progress,
    gap: 'var(--gap-md)',
    align: 'start',
    prev_label: 'Previous categories',
    next_label: 'Next categories'
  %}
</div>

{% stylesheet %}
  .showcase-category-row__heading {
    margin: 0 0 var(--margin-xl);
    font-size: var(--font-size--2xl);
  }

  /*
    The card surface lives on the tile itself, not on the media box, so the image and
    its label sit inside one enclosed card rather than reading as two stacked elements.
  */
  .category-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs);
    padding-block-end: var(--padding-sm);
    border-radius: var(--category-tile-radius, 0px);
    background-color: var(--category-tile-background);
    color: var(--color-foreground);
    text-decoration: none;
    overflow: hidden;
  }

  .category-tile__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    /*
      Inset sized so the image fills 79.2% of the box — 10% larger than the previous
      72% (padding 14%). The box itself is untouched; only the inner padding shrinks.
    */
    padding: 10.4%;
  }

  .category-tile__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .category-tile__image--placeholder {
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .category-tile__label {
    /* Keeps longer labels off the card's rounded edges. */
    padding-inline: var(--padding-xs);
    font-size: var(--category-label-size, var(--font-size--sm));
    font-weight: var(--category-label-weight, 500);
    text-align: center;
    text-wrap: balance;
  }

  .category-tile:hover .category-tile__label {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .showcase-category-row__heading {
      font-size: var(--font-size--xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category tile row",
  "tag": "section",
  "class": "section-showcase-category-row",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank for a tiles-only row, as in the reference layout."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Tiles visible on desktop",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Tiles visible on mobile",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "peek_mobile",
      "label": "Next tile peek on mobile",
      "min": 0,
      "max": 0.9,
      "step": 0.1,
      "default": 0.5,
      "info": "Added to the count above. 2 tiles plus 0.5 shows two and a half."
    },
    {
      "type": "range",
      "id": "tile_radius",
      "label": "Tile corner radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 4,
      "info": "Set to 100 for fully circular tiles."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show scroll progress bar",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "label_size",
      "label": "Label size",
      "options": [
        { "value": "var(--font-size--xs)", "label": "Extra small" },
        { "value": "var(--font-size--sm)", "label": "Small" },
        { "value": "var(--font-size--md)", "label": "Medium" }
      ],
      "default": "var(--font-size--sm)"
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "tile_background",
      "label": "Tile background",
      "default": "#f2f2f0"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Lorem ipsum"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tile row",
      "blocks": [
        { "type": "category", "settings": { "label": "Sofas and armchairs" } },
        { "type": "category", "settings": { "label": "Beds and mattresses" } },
        { "type": "category", "settings": { "label": "Cabinets and shelving" } },
        { "type": "category", "settings": { "label": "Office furniture" } },
        { "type": "category", "settings": { "label": "Chests of drawers" } },
        { "type": "category", "settings": { "label": "Tables and chairs" } },
        { "type": "category", "settings": { "label": "Children's furniture" } },
        { "type": "category", "settings": { "label": "Garden furniture" } },
        { "type": "category", "settings": { "label": "Lorem ipsum dolor" } },
        { "type": "category", "settings": { "label": "Consectetur elit" } }
      ]
    }
  ]
}
{% endschema %}
