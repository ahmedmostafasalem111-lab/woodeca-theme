{% comment %}
  Fixed mobile bottom tab bar: five icon + label pairs, persistent across scroll.
  Hidden entirely on desktop.

  The bar also publishes its height as `--mobile-tab-bar-height` on :root and adds
  bottom padding to the page wrapper, so fixed-bottom content never sits under it.
{% endcomment %}

{% if section.blocks.size > 0 %}
  <nav
    class="mobile-tab-bar"
    aria-label="{{ section.settings.nav_label | default: 'Quick navigation' | escape }}"
    style="
      --tab-bar-background: {{ section.settings.background_color | default: '#ffffff' }};
      --tab-bar-text: {{ section.settings.text_color | default: '#1c1c1c' }};
      --tab-bar-active: {{ section.settings.active_color | default: '#e8342a' }};
      --tab-bar-label-size: {{ section.settings.label_size }};
    "
  >
    <ul class="mobile-tab-bar__list">
      {% for block in section.blocks %}
        {% liquid
          assign icon_file = 'icon-' | append: block.settings.icon | append: '.svg'

          # Mark the tab matching the current page so the bar reflects location.
          assign is_active = false
          if block.settings.link != blank and block.settings.link == request.path
            assign is_active = true
          endif
        %}
        <li
          class="mobile-tab-bar__item"
          {{ block.shopify_attributes }}
        >
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="mobile-tab-bar__link{% if is_active %} mobile-tab-bar__link--active{% endif %}"
            {% if is_active %}
              aria-current="page"
            {% endif %}
          >
            <span class="svg-wrapper mobile-tab-bar__icon" aria-hidden="true">
              {{- icon_file | inline_asset_content -}}
            </span>
            {% if block.settings.label != blank %}
              <span class="mobile-tab-bar__label">{{ block.settings.label }}</span>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}

{% stylesheet %}
  .mobile-tab-bar {
    display: none;
  }

  @media screen and (max-width: 989px) {
    :root {
      --mobile-tab-bar-height: 60px;
    }

    .mobile-tab-bar {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: var(--layer-sticky, 20);
      display: block;
      height: var(--mobile-tab-bar-height);
      /* Respect the iOS home-indicator inset. */
      padding-block-end: env(safe-area-inset-bottom, 0px);
      border-block-start: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
      background-color: var(--tab-bar-background);
      color: var(--tab-bar-text);
    }

    .mobile-tab-bar__list {
      display: flex;
      align-items: stretch;
      height: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .mobile-tab-bar__item {
      flex: 1 1 0;
      min-width: 0;
    }

    .mobile-tab-bar__link {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }

    .mobile-tab-bar__link--active {
      color: var(--tab-bar-active);
    }

    .mobile-tab-bar__icon,
    .mobile-tab-bar__icon svg {
      width: var(--icon-size-sm);
      height: var(--icon-size-sm);
    }

    .mobile-tab-bar__label {
      font-size: var(--tab-bar-label-size, 10px);
      line-height: 1.2;
      text-align: center;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 100%;
    }

    /* Keep page content clear of the fixed bar. */
    .page-wrapper {
      padding-block-end: calc(var(--mobile-tab-bar-height) + env(safe-area-inset-bottom, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mobile tab bar",
  "tag": "aside",
  "class": "mobile-tab-bar-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Fixed bar at the bottom of the viewport on mobile only. Hidden on desktop."
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Accessible label",
      "default": "Quick navigation"
    },
    {
      "type": "select",
      "id": "label_size",
      "label": "Label size",
      "options": [
        { "value": "9px", "label": "Extra small" },
        { "value": "10px", "label": "Small" },
        { "value": "11px", "label": "Medium" }
      ],
      "default": "10px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Icon and label",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active tab",
      "default": "#e8342a"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "grid-default", "label": "Catalog (grid)" },
            { "value": "heart", "label": "Favorites (heart)" },
            { "value": "cart", "label": "Basket (bag)" },
            { "value": "account", "label": "Login (person)" },
            { "value": "store", "label": "Showrooms (store)" },
            { "value": "search", "label": "Search" },
            { "value": "pin", "label": "Location" },
            { "value": "chat", "label": "Chat" },
            { "value": "phone", "label": "Phone" }
          ],
          "default": "grid-default"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Catalog"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile tab bar",
      "blocks": [
        { "type": "tab", "settings": { "icon": "grid-default", "label": "Catalog" } },
        { "type": "tab", "settings": { "icon": "heart", "label": "Favorites" } },
        { "type": "tab", "settings": { "icon": "cart", "label": "Basket" } },
        { "type": "tab", "settings": { "icon": "account", "label": "Login" } },
        { "type": "tab", "settings": { "icon": "store", "label": "Showrooms" } }
      ]
    }
  ]
}
{% endschema %}
