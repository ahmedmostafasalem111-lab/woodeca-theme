{% comment %}
  App blocks only (e.g. the Judge.me review widget on the product page), with
  the same width and vertical padding settings as the other showcase sections.
  A plain section loop rather than Horizon's _blocks wrapper: theme check
  flags app blocks placed in _blocks as missing theme blocks.
{% endcomment %}
<div
  class="section section--{{ section.settings.section_width }} showcase-apps spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>

{%- comment -%}
  Reveal the Judge.me all-reviews widget once its layout has settled: Judge.me
  builds its top area in steps and its own styles resize those parts afterwards,
  so "done-setup" isn't the end. Shown when the widget's size hasn't changed for
  600 ms (CSS shows it after 6 s regardless).
{%- endcomment -%}
<script>
  (() => {
    const widget = document.querySelector('.jdgm-all-reviews-widget-v2025');
    if (!widget || typeof ResizeObserver === 'undefined') return;
    let timer;
    const ready = () => { widget.classList.add('is-settled'); observer.disconnect(); };
    const observer = new ResizeObserver(() => {
      clearTimeout(timer);
      if (widget.querySelector('.jdgm--done-setup-widget')) timer = setTimeout(ready, 600);
    });
    observer.observe(widget);
  })();
</script>

{% stylesheet %}
  /*
    Judge.me "All reviews" page widget. Judge.me hides its server-rendered reviews
    until its script has set the widget up (~1.5–3 s), then the widget grows to
    several thousand pixels and rebuilds its top area in steps (summary, actions
    and photo gallery, Reviews/Questions tabs): the footer and the first reviews
    jumped (CLS 1.3 on mobile). Reserve space so the footer starts below the
    screen, and keep the widget invisible until its layout has settled (the
    script below adds .is-settled). If that never happens, it shows after 6 s.
  */
  .jdgm-all-reviews-widget-v2025 {
    min-height: 120vh;
  }

  .jdgm-all-reviews-widget-v2025:not(.is-settled) {
    visibility: hidden;
    animation: showcase-jdgm-reveal 0s 6s forwards;
  }

  @keyframes showcase-jdgm-reveal {
    to {
      visibility: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Apps",
  "tag": "section",
  "class": "section-showcase-apps",
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [{ "name": "Apps" }]
}
{% endschema %}
