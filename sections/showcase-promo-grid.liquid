{% comment %}
  Promo product carousel ("We will deliver quickly [icon] from 1 day"). The
  heading is split into two text fields so an inline icon can sit between them.
  Below it: products from a collection (default: Ready To Ship) in the same
  shared product card and scroll row as the homepage product carousels — swipe
  on phones, arrows on desktop — plus a "View all" link to the collection.
  The section keeps its own background and text colours.
{% endcomment %}

{% liquid
  assign icon_file = 'icon-' | append: section.settings.heading_icon | append: '.svg'

  assign source_collection = section.settings.collection
  if source_collection == blank
    assign source_collection = collections['ready-to-ship']
  endif
  assign products_limit = section.settings.products_limit | default: 12

  # "View all": the link when set, otherwise the collection itself.
  assign view_all_link = section.settings.button_link
  if view_all_link == blank and source_collection != blank
    assign view_all_link = source_collection.url
  endif
%}

<div
  class="section-background"
  style="background-color: {{ section.settings.background_color | default: '#dfe7dd' }};"
></div>

<div
  class="section section--{{ section.settings.section_width }} showcase-promo spacing-style"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.text_color != blank %}
      --color-foreground: {{ section.settings.text_color }};
      --color-foreground-rgb: {{ section.settings.text_color.rgb }};
    {% endif %}
    --promo-button-background: {{ section.settings.button_background | default: '#333333' }};
    --promo-button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    {% if section.settings.card_badge_background != blank %}
      --showcase-card-badge-background: {{ section.settings.card_badge_background }};
    {% endif %}
    {% if section.settings.card_badge_text_color != blank %}
      --showcase-card-badge-text: {{ section.settings.card_badge_text_color }};
    {% endif %}
    {% if section.settings.card_discount_background != blank %}
      --showcase-card-discount-background: {{ section.settings.card_discount_background }};
    {% endif %}
    {% if section.settings.card_discount_text_color != blank %}
      --showcase-card-discount-text: {{ section.settings.card_discount_text_color }};
    {% endif %}
    {% if section.settings.card_quick_add_background != blank %}
      --showcase-card-quick-add-background: {{ section.settings.card_quick_add_background }};
    {% endif %}
    {% if section.settings.card_quick_add_icon_color != blank %}
      --showcase-card-quick-add-icon: {{ section.settings.card_quick_add_icon_color }};
    {% endif %}
    {% if section.settings.card_media_background != blank %}
      --showcase-card-media-background: {{ section.settings.card_media_background }};
    {% endif %}
  "
>
  <div class="showcase-promo__header">
    <div class="showcase-promo__intro">
      {% if section.settings.heading != blank or section.settings.heading_suffix != blank %}
        <h2 class="showcase-promo__heading section-title">
          {%- if section.settings.heading != blank -%}
            <span>{{ section.settings.heading }}</span>
          {%- endif -%}

          {%- if section.settings.show_heading_icon -%}
            <span class="showcase-promo__heading-icon" aria-hidden="true">
              {%- if section.settings.heading_icon_image != blank -%}
                {{
                  section.settings.heading_icon_image
                  | image_url: width: 96
                  | image_tag: loading: 'lazy', alt: '', sizes: '48px', widths: '48, 96'
                }}
              {%- else -%}
                {{- icon_file | inline_asset_content -}}
              {%- endif -%}
            </span>
          {%- endif -%}

          {%- if section.settings.heading_suffix != blank -%}
            <span>{{ section.settings.heading_suffix }}</span>
          {%- endif -%}
        </h2>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="showcase-promo__subtext">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    {% if section.settings.button_label != blank and view_all_link != blank %}
      <a
        href="{{ view_all_link }}"
        class="showcase-promo__button"
      >
        {{- section.settings.button_label -}}
      </a>
    {% endif %}
  </div>

  {%- capture carousel_items -%}
    {%- if source_collection != blank -%}
      {%- for product in source_collection.products limit: products_limit -%}
        <div>
          {% render 'showcase-product-card',
            product: product,
            show_quick_add: section.settings.show_quick_add,
            show_swatches: section.settings.show_swatches
          %}
        </div>
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {% if carousel_items != blank %}
    {% render 'scroll-row',
      content: carousel_items,
      columns: section.settings.columns,
      columns_mobile: section.settings.columns_mobile,
      peek: section.settings.peek_mobile,
      show_arrows: section.settings.show_arrows,
      show_progress: section.settings.show_progress,
      gap: 'var(--gap-lg)',
      prev_label: 'Previous products',
      next_label: 'Next products'
    %}
  {% elsif request.design_mode %}
    <p class="showcase-promo__empty">Pick a collection with products to show them here.</p>
  {% endif %}
</div>

<script
  src="{{ 'showcase-card-cart.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- comment -%} The swatch tap (photo swap, colour-aware links) is handled by the same script as the collection grid. {%- endcomment -%}
{% if section.settings.show_swatches %}
  <script
    src="{{ 'showcase-card-slider.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% stylesheet %}
  /* Title style: .section-title (base.css); ~18px to the content (14px on phones). */
  .showcase-promo__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-lg);
    margin-block-end: 18px;
  }

  .showcase-promo__intro {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .showcase-promo__heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
    margin: 0;
  }

  .showcase-promo__heading-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .showcase-promo__heading-icon svg,
  .showcase-promo__heading-icon img {
    width: 1.4em;
    height: 1.4em;
    object-fit: contain;
  }

  .showcase-promo__subtext {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--md);
  }

  .showcase-promo__button {
    flex-shrink: 0;
    padding: var(--padding-sm) var(--padding-xl);
    border-radius: var(--style-border-radius-buttons-primary, 4px);
    background-color: var(--promo-button-background);
    color: var(--promo-button-text);
    font-size: var(--font-size--sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .showcase-promo__empty {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--sm);
  }

  @media screen and (max-width: 749px) {
    .showcase-promo__header {
      flex-direction: column;
      align-items: stretch;
      margin-block-end: 14px;
    }

    .showcase-promo__subtext {
      font-size: var(--font-size--sm);
    }

    /* Button becomes full width and sits below the copy. */
    .showcase-promo__button {
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo product carousel",
  "tag": "section",
  "class": "section-showcase-promo",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (before icon)",
      "default": "We will deliver quickly"
    },
    {
      "type": "checkbox",
      "id": "show_heading_icon",
      "label": "Show inline heading icon",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_icon",
      "label": "Inline icon",
      "options": [
        { "value": "package-check", "label": "Package with check (ready to ship)" },
        { "value": "truck", "label": "Truck" },
        { "value": "pin", "label": "Location pin" },
        { "value": "store", "label": "Store" },
        { "value": "cart", "label": "Cart" },
        { "value": "phone", "label": "Phone" },
        { "value": "heart", "label": "Heart" },
        { "value": "star", "label": "Star" },
        { "value": "discount", "label": "Discount" }
      ],
      "default": "package-check",
      "visible_if": "{{ section.settings.show_heading_icon }}"
    },
    {
      "type": "image_picker",
      "id": "heading_icon_image",
      "label": "Custom icon image",
      "info": "Overrides the icon above when set.",
      "visible_if": "{{ section.settings.show_heading_icon }}"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading (after icon)",
      "default": "from 1 day"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "info": "No longer used: section titles share one style (Theme settings → Typography → Section heading font).",
      "options": [
        { "value": "var(--font-size--2xl)", "label": "Medium" },
        { "value": "var(--font-size--3xl)", "label": "Large" },
        { "value": "var(--font-size--4xl)", "label": "Extra large" }
      ],
      "default": "var(--font-size--3xl)"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Furniture and home goods you don't have to wait for"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Empty = the Ready To Ship collection (/collections/ready-to-ship)."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Maximum products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "View all link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link",
      "info": "Empty = the collection above."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards visible on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Cards visible on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "peek_mobile",
      "label": "Next card peek on mobile",
      "min": 0,
      "max": 0.9,
      "step": 0.1,
      "default": 0.8,
      "info": "Added to the count above. 1 card plus 0.8 shows one and most of the next."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show scroll progress bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add-to-cart button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show colour swatches",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#dfe7dd"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "View all background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "View all text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_media_background",
      "label": "Card image background",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "card_badge_background",
      "label": "Card badge background",
      "default": "#f6e6c3"
    },
    {
      "type": "color",
      "id": "card_badge_text_color",
      "label": "Card badge text",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "card_discount_background",
      "label": "Card discount badge background",
      "default": "#e8705a"
    },
    {
      "type": "color",
      "id": "card_discount_text_color",
      "label": "Card discount badge text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_quick_add_background",
      "label": "Card quick add background",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "card_quick_add_icon_color",
      "label": "Card quick add icon",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Promo product carousel"
    }
  ]
}
{% endschema %}
