{% doc %}
  Renders the header search field (pill input with a magnifier on the right edge)
  plus the optional "Search by photo" pill button. Rendered twice by the header —
  inline on desktop and inside the mobile disclosure — so the markup lives here.

  @param {object} section - The header section, for placeholder and photo-search settings.
  @param {string} id_suffix - Unique suffix so the input ids don't collide across the two renders.

  @example
  {% render 'showcase-search-form', section: section, id_suffix: 'desktop' %}
{% enddoc %}

<div class="showcase-search">
  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="showcase-search__form"
    {% if id_suffix == 'desktop' %}
      data-search-desktop
      data-search-suggest-url="{{ routes.predictive_search_url }}"
    {% endif %}
  >
    <label
      for="showcase-search-{{ id_suffix }}"
      class="visually-hidden"
    >
      {{ section.settings.search_placeholder | default: 'Search' }}
    </label>
    <input
      type="text"
      id="showcase-search-{{ id_suffix }}"
      name="q"
      class="showcase-search__input"
      placeholder="{{ section.settings.search_placeholder | escape }}"
      autocomplete="off"
      {% if id_suffix == 'desktop' %}
        aria-controls="showcase-search-panel-{{ id_suffix }}"
        aria-expanded="false"
        aria-autocomplete="list"
      {% endif %}
    >
    <input
      type="hidden"
      name="options[prefix]"
      value="last"
    >
    <button
      type="submit"
      class="showcase-search__submit"
      aria-label="{{ section.settings.search_submit_label | default: 'Search' | escape }}"
    >
      <span class="svg-wrapper" aria-hidden="true">
        {{- 'icon-search.svg' | inline_asset_content -}}
      </span>
    </button>

    {%- comment -%} Desktop live suggestions, filled by showcase-search-desktop.js. {%- endcomment -%}
    {% if id_suffix == 'desktop' %}
      <div
        class="showcase-search__panel"
        id="showcase-search-panel-{{ id_suffix }}"
        data-search-panel
        hidden
      >
        <div class="showcase-search__results" data-search-results aria-live="polite"></div>
        <button type="submit" class="showcase-search__all" data-search-all hidden>
          {{- 'actions.view_all' | t -}}
        </button>
      </div>
    {% endif %}
  </form>

  {% if section.settings.show_photo_search %}
    <a
      href="{{ section.settings.photo_search_link | default: '#' }}"
      class="showcase-search__photo"
    >
      <span class="svg-wrapper" aria-hidden="true">
        {{- 'icon-camera.svg' | inline_asset_content -}}
      </span>
      <span class="showcase-search__photo-label">{{ section.settings.photo_search_label }}</span>
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .showcase-search {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    width: 100%;
  }

  .showcase-search__form {
    position: relative;
    flex-grow: 1;
    min-width: 0;
  }

  /* Desktop suggestions; rows reuse the mobile overlay's result styles. */
  .showcase-search__panel {
    position: absolute;
    top: calc(100% + 6px);
    inset-inline: 0;
    z-index: 40;
    max-height: min(70vh, 520px);
    overflow-y: auto;
    padding: var(--padding-xs);
    border-radius: 12px;
    background-color: var(--color-background, #ffffff);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.14);
  }

  .showcase-search__panel[hidden] {
    display: none;
  }

  .showcase-search__all {
    display: block;
    width: 100%;
    margin-block-start: var(--margin-2xs);
    padding: var(--padding-sm);
    border: 0;
    border-radius: 8px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    color: var(--color-foreground);
    font-weight: 600;
    cursor: pointer;
  }

  .showcase-search__all[hidden] {
    display: none;
  }

  .showcase-search__all:hover {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .showcase-search__input {
    width: 100%;
    padding: var(--padding-sm) var(--padding-2xl) var(--padding-sm) var(--padding-md);
    border: var(--style-border-width-inputs) solid var(--showcase-search-border, transparent);
    border-radius: 999px;
    background-color: var(--showcase-search-background, #f2f2f0);
    color: var(--showcase-header-text, var(--color-foreground));
    font-size: var(--font-size--sm);
  }

  .showcase-search__input::placeholder {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
  }

  .showcase-search__submit {
    position: absolute;
    top: 50%;
    right: var(--padding-2xs);
    translate: 0 -50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--showcase-header-text, var(--color-foreground));
    cursor: pointer;
  }

  .showcase-search__submit .svg-wrapper,
  .showcase-search__submit svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  /* Photo-search pill sits alongside the input. */
  .showcase-search__photo {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-3xs);
    flex-shrink: 0;
    padding: var(--padding-2xs) var(--padding-md);
    border: var(--style-border-width-inputs) solid var(--showcase-photo-border, #3b7de0);
    border-radius: 999px;
    color: var(--showcase-photo-text, var(--color-foreground));
    font-size: var(--font-size--sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .showcase-search__photo .svg-wrapper,
  .showcase-search__photo svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  @media screen and (max-width: 989px) {
    .showcase-search__photo-label {
      display: none;
    }

    .showcase-search__photo {
      padding-inline: var(--padding-2xs);
    }
  }
{% endstylesheet %}
