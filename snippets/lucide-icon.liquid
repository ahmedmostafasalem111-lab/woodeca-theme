{%- doc -%}
  Outline icons from Lucide (https://lucide.dev, ISC licence), copied from the
  official lucide-static package: factory, package-check, shield-check, headset
  (v1.52.0) and facebook, instagram (v0.469.0, the last release with brand icons).
  Drawn at 24×24 with a 1.5 stroke in the current text colour; size it with CSS.

  @param {string} name - factory | package-check | shield-check | headset | facebook | instagram
  @param {string} [class] - Extra class for the <svg>.

  @example
  {% render 'lucide-icon', name: 'factory', class: 'why-woodeca__svg' %}
{%- enddoc -%}
{%- capture paths -%}
  {%- case name -%}
    {%- when 'factory' -%}
      <path d="M12 16h.01"/><path d="M16 16h.01"/><path d="M3 19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.5a.5.5 0 0 0-.769-.422l-4.462 2.844A.5.5 0 0 1 15 10.5v-2a.5.5 0 0 0-.769-.422L9.77 10.922A.5.5 0 0 1 9 10.5V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><path d="M8 16h.01"/>
    {%- when 'package-check' -%}
      <path d="M12 22V12"/><path d="m16 17 2 2 4-4"/><path d="M21 11.127V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l1.32-.753"/><path d="M3.29 7 12 12l8.71-5"/><path d="m7.5 4.27 8.997 5.148"/>
    {%- when 'shield-check' -%}
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'headset' -%}
