{% doc %}
  Flattens the shown "Installment provider" blocks into one string for the
  installment snippet to split: entries "block_id|months|ppm", joined by ";".
  ppm is the extra cost in millionths of the price (11.3353% → 113353), so the
  instalment sums stay in integers.

  A provider's months are typed as "3,6,9" and its extra cost % as one value for
  every plan ("0") or one per plan in the same order ("11.3353,22.6828"); a plan
  without its own value takes the last one given. Spaces and "%" are ignored; a
  month count below 1 is skipped, and a provider left with no valid plan is left
  out entirely.

  @param {object} section - The product section carrying the provider blocks.

  @example
  {% capture plan_text %}{% render 'showcase-instalment-plans', section: section %}{% endcapture %}
{% enddoc %}

{%- liquid
  for block in section.blocks
    if block.type != 'instalment_provider' or block.settings.enabled == false
      continue
    endif

    assign month_list = block.settings.months | remove: ' ' | split: ','
    assign extra_list = block.settings.extra_cost | default: '0' | remove: ' ' | remove: '%' | split: ','
    assign last_extra = extra_list | last | default: '0'
    for month_text in month_list
      assign months = month_text | times: 1
      if months < 1
        continue
      endif
      assign extra = extra_list[forloop.index0] | default: last_extra
      assign ppm = extra | times: 10000 | round
      if ppm < 0
        assign ppm = 0
      endif
      echo block.id | append: '|' | append: months | append: '|' | append: ppm | append: ';'
    endfor
  endfor
-%}
