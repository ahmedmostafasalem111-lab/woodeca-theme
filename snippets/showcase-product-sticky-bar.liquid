{% doc %}
  Persistent buy bar.

  Desktop keeps the condensed identity row that takes over once the hero scrolls
  past: thumbnail, title with anchor links, price and the buy buttons.

  Mobile drops the identity row and pins two full-width buttons — Add To Cart and
  Buy It Now — to the bottom of the viewport, which is the only place a thumb can
  reliably reach on a long product page.

  Both buttons drive the hero's form: Add To Cart submits it normally, while Buy
  It Now posts the same line through the cart API and then sends the customer to
  checkout, so the two share one variant id and one quantity.

  Refs here belong to the hero's `showcase-product-component`, so a variant change
  updates the bar and the buy box together.

  @param {object} product - The product.
  @param {object} selected_variant - The currently selected variant.
  @param {object} section - The section, for labels and anchor ids.
  @param {string} form_id - Id of the hero's product form, so this bar's buttons submit it.

  @example
  {% render 'showcase-product-sticky-bar', product: product, selected_variant: variant, section: section, form_id: id %}
{% enddoc %}

<div class="product-sticky-bar" ref="stickyBar">
  <div class="product-sticky-bar__inner">
    <div class="product-sticky-bar__identity">
      <span class="product-sticky-bar__thumb" ref="stickyThumb">
        {% if selected_variant.featured_image != blank %}
          {{
            selected_variant.featured_image
            | image_url: width: 160
            | image_tag: loading: 'lazy', alt: product.title, sizes: '64px', widths: '80, 160'
          }}
        {% elsif product.featured_image != blank %}
          {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: product.title, sizes: '64px', widths: '80, 160' }}
        {% endif %}
      </span>

      <span class="product-sticky-bar__text">
        <span class="product-sticky-bar__title">{{ product.title }}</span>

        {%- comment -%}
          Only the specs anchor remains; the delivery block it used to point at is
          no longer part of the product page, and a link to a missing id does
          nothing but look broken.
        {%- endcomment -%}
        <span class="product-sticky-bar__anchors">
          <a href="#{{ section.settings.specs_anchor | default: 'specifications' }}">
            {{- section.settings.specs_anchor_label | default: 'Characteristics' -}}
          </a>
        </span>
      </span>
    </div>

    <div class="product-sticky-bar__actions">
      <span class="product-sticky-bar__price" ref="stickyPriceTarget">
        {%- render 'showcase-money', amount: selected_variant.price -%}
      </span>

      <button
        type="submit"
        form="{{ form_id }}"
        class="product-sticky-bar__add"
        ref="stickyAddButton"
        {% unless selected_variant.available %}disabled{% endunless %}
      >
        {%- if selected_variant.available -%}
          {{ section.settings.add_to_cart_label | default: 'Add to cart' }}
        {%- else -%}
          {{ section.settings.sold_out_label | default: 'Sold out' }}
        {%- endif -%}
      </button>

      {% if section.settings.show_buy_now %}
        <button
          type="button"
          class="product-sticky-bar__buy"
          ref="buyNowButton"
          data-busy-label="{{ section.settings.buy_now_busy_label | default: 'Working…' | escape }}"
          data-default-label="{{ section.settings.buy_now_label | default: 'Buy It Now' | escape }}"
          {% unless selected_variant.available %}disabled{% endunless %}
          on:click="/buyNow"
        >
          {{- section.settings.buy_now_label | default: 'Buy It Now' -}}
        </button>
      {% endif %}

    </div>
  </div>
</div>

{% stylesheet %}
  .product-sticky-bar {
    position: sticky;
    top: 0;
    z-index: var(--layer-sticky, 20);
    background-color: var(--product-sticky-background, var(--color-background));
    border-block-end: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .product-sticky-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-lg);
    max-width: var(--page-width);
    margin-inline: auto;
    padding: var(--padding-2xs) var(--page-margin);
  }

  .product-sticky-bar__identity {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    min-width: 0;
  }

  .product-sticky-bar__thumb {
    display: block;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 4px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    overflow: hidden;
  }

  .product-sticky-bar__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .product-sticky-bar__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .product-sticky-bar__title {
    font-size: var(--font-size--sm);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-sticky-bar__anchors {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
  }

  .product-sticky-bar__anchors a {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--xs);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .product-sticky-bar__anchors a:hover {
    color: var(--color-foreground);
  }

  .product-sticky-bar__actions {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    flex-shrink: 0;
  }

  .product-sticky-bar__price {
    font-size: var(--font-size--lg);
    font-weight: 700;
    white-space: nowrap;
  }

  .product-sticky-bar__add,
  .product-sticky-bar__buy {
    padding: var(--padding-sm) var(--padding-2xl);
    border: none;
    border-radius: var(--style-border-radius-buttons-primary, 4px);
    font-size: var(--font-size--sm);
    cursor: pointer;
  }

  .product-sticky-bar__add {
    background-color: var(--product-cta-background, #333);
    color: var(--product-cta-text, #fff);
  }

  .product-sticky-bar__buy {
    background-color: var(--product-accent, #e8342a);
    color: #ffffff;
  }

  .product-sticky-bar__add:disabled,
  .product-sticky-bar__buy:disabled {
    opacity: var(--opacity-50);
    cursor: not-allowed;
  }

  @media screen and (max-width: 989px) {
    /*
      Fixed to the bottom of the viewport rather than sticky to the top. Sticky
      would pin it under the header, which is where the customer is not looking
      once they have scrolled into the specs. The hero adds matching bottom
      padding so the bar never covers the last row of content.
    */
    .product-sticky-bar {
      position: fixed;
      inset-block: auto 0;
      inset-inline: 0;
      top: auto;
      z-index: 30;
      border-block-end: 0;
      border-block-start: var(--border-width-sm) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
      box-shadow: 0 -2px 12px rgb(0 0 0 / 0.08);
      padding-block-end: env(safe-area-inset-bottom, 0px);
    }

    /* Thumbnail, title and anchor links would crowd out the two buttons. */
    .product-sticky-bar__identity,
    .product-sticky-bar__price {
      display: none;
    }

    .product-sticky-bar__inner {
      padding-block: var(--padding-2xs);
    }

    .product-sticky-bar__actions {
      flex-grow: 1;
      gap: var(--gap-2xs);
    }

    .product-sticky-bar__add,
    .product-sticky-bar__buy {
      flex: 1 1 0;
      padding-inline: var(--padding-sm);
      border-radius: 999px;
      font-size: var(--font-size--md);
      font-weight: 600;
    }
  }
{% endstylesheet %}
