{% doc %}
  Compact assurance row above the variant pickers — short checkmark claims such as
  "3 Year Warranty" and "Exchange & Return within 14 Days".

  Entries are section blocks so the copy is editable per store and nothing here is
  hardcoded. Each block picks its own icon from the theme's existing icon set.

  @param {object} section - The section holding the `assurance` blocks.
  @param {string} [delivery] - Rendered delivery estimate, listed right after the first entry.

  @example
  {% render 'showcase-product-assurances', section: section %}
{% enddoc %}

{% assign assurances = section.blocks | where: 'type', 'assurance' %}

{% if assurances.size > 0 or delivery != blank %}
  <ul class="product-assurances" role="list">
    {% if assurances.size == 0 %}
      <li class="product-assurances__delivery">{{ delivery }}</li>
    {% endif %}
    {% for block in assurances %}
      {% assign icon_file = block.settings.icon | default: 'checkmark' | prepend: 'icon-' | append: '.svg' %}
      <li class="product-assurance" {{ block.shopify_attributes }}>
        {%- comment -%} With a link set, the whole row links (e.g. to the returns page); it looks the same. {%- endcomment -%}
        {%- if block.settings.link != blank -%}<a class="product-assurance__link" href="{{ block.settings.link }}">{%- endif -%}
        <span class="svg-wrapper product-assurance__icon" aria-hidden="true">
          {{- icon_file | inline_asset_content -}}
        </span>
        <span class="product-assurance__text">{{ block.settings.text }}</span>
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </li>
      {% if forloop.first and delivery != blank %}
        <li class="product-assurances__delivery">{{ delivery }}</li>
      {% endif %}
    {% endfor %}
  </ul>
{% endif %}

{% stylesheet %}
  /*
    One evenly spaced list: rows 8px apart, 20px below the instalment box (the
    buy box's 12px gap + 8). The first entry (the warranty) is the emphasised one.
  */
  .product-assurances {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .product-assurance {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 15px;
    font-weight: 500;
  }

  .product-assurance:first-child {
    font-weight: 600;
  }

  .product-assurance__link {
    display: inherit;
    align-items: inherit;
    gap: inherit;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .product-assurance__icon {
    flex: 0 0 auto;
    color: var(--color-foreground);
  }

  .product-assurance .product-assurance__icon,
  .product-assurance .product-assurance__icon svg {
    width: 20px;
    height: 20px;
  }

  .product-assurances__delivery .product-delivery-estimate {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
  }

  @media screen and (min-width: 990px) {
    .product-assurances {
      gap: 9px;
      margin-block-start: 11px;
    }

    .product-assurance,
    .product-assurances__delivery .product-delivery-estimate {
      gap: 9px;
      font-size: 17px;
    }

    .product-assurance .product-assurance__icon,
    .product-assurance .product-assurance__icon svg,
    .product-assurances__delivery .product-delivery-estimate__icon,
    .product-assurances__delivery .product-delivery-estimate__icon svg {
      width: 22px;
      height: 22px;
    }
  }
{% endstylesheet %}
