{% doc %}
  Circular video thumbnails that open a full-screen player, in the style of a
  stories row.

  Videos come from the product's own media, not a metafield — that is where
  merchants already upload them, and it means the row needs no extra setup per
  product. Both native Shopify video and external (YouTube/Vimeo) media are
  picked up. The whole row renders nothing when the product has no video.

  @param {object} product - The product whose media is read.
  @param {object} section - The section, for labels.

  @example
  {% render 'showcase-product-inspiration', product: product, section: section %}
{% enddoc %}

{% liquid
  assign native_videos = product.media | where: 'media_type', 'video'
  assign external_videos = product.media | where: 'media_type', 'external_video'
  assign inspiration_videos = native_videos | concat: external_videos
%}

{% if inspiration_videos.size > 0 %}
  <div class="product-inspiration">
    {% if section.settings.inspiration_heading != blank %}
      <h2 class="product-inspiration__heading">{{ section.settings.inspiration_heading }}</h2>
    {% endif %}

    <ul class="product-inspiration__row" role="list">
      {% for media in inspiration_videos %}
        {% liquid
          # Native videos carry their own poster; external ones expose a preview image.
          assign poster = media.preview_image

          assign media_label = media.alt
          if media_label == blank
            assign media_label = product.title
          endif
        %}
        <li class="product-inspiration__item">
          <button
            type="button"
            class="product-inspiration__bubble"
            ref="inspirationTriggers[]"
            data-inspiration-index="{{ forloop.index0 }}"
            aria-label="{{ section.settings.inspiration_play_label | default: 'Play video' | escape }} — {{ media_label | escape }}"
            on:click="/openInspiration"
          >
            {% if poster != blank %}
              {{
                poster
                | image_url: width: 220
                | image_tag: loading: 'lazy', class: 'product-inspiration__poster', alt: '', sizes: '72px', widths: '80, 150, 220'
              }}
            {% endif %}
            <span class="svg-wrapper product-inspiration__play" aria-hidden="true">
              {{- 'icon-play.svg' | inline_asset_content -}}
            </span>
          </button>
        </li>
      {% endfor %}
    </ul>

    {%- comment -%}
      One dialog reused by every bubble. Each slide is rendered up front but the
      media is only mounted once opened, so a product with six videos does not
      pull six streams on page load.
    {%- endcomment -%}
    <dialog
      class="product-inspiration__dialog"
      ref="inspirationDialog"
      aria-label="{{ section.settings.inspiration_heading | default: 'Videos' | escape }}"
    >
      <button
        type="button"
        class="product-inspiration__close"
        aria-label="{{ section.settings.inspiration_close_label | default: 'Close video' | escape }}"
        on:click="/closeInspiration"
      >
        <span class="svg-wrapper" aria-hidden="true">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>

      {% for media in inspiration_videos %}
        <div
          class="product-inspiration__stage"
          ref="inspirationStages[]"
          data-inspiration-index="{{ forloop.index0 }}"
          hidden
        >
          {% if media.media_type == 'video' %}
            {{ media | video_tag: controls: true, playsinline: true, preload: 'none' }}
          {% else %}
            {{ media | external_video_tag: loading: 'lazy' }}
          {% endif %}
        </div>
      {% endfor %}
    </dialog>
  </div>
{% endif %}

{% stylesheet %}
  .product-inspiration {
    margin-block-start: var(--margin-lg);
  }

  .product-inspiration__heading {
    margin: 0 0 var(--margin-sm);
    font-size: var(--font-size--md);
    font-weight: 600;
  }

  /*
    Horizontal scroll rather than wrap: the row is a peek-and-swipe strip at every
    width, so a long list never pushes the buy box down the page.
  */
  .product-inspiration__row {
    display: flex;
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .product-inspiration__row::-webkit-scrollbar {
    display: none;
  }

  .product-inspiration__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .product-inspiration__bubble {
    position: relative;
    display: block;
    width: var(--inspiration-size, 76px);
    height: var(--inspiration-size, 76px);
    padding: 0;
    border: 2px solid var(--product-accent, #e8342a);
    border-radius: 50%;
    background-color: var(--product-gallery-background, #f2f2f0);
    cursor: pointer;
    overflow: hidden;
  }

  .product-inspiration__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-inspiration__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    /* Keeps the glyph legible over a light poster without dimming the whole tile. */
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.6));
  }

  .product-inspiration__play svg {
    width: 22px;
    height: 22px;
  }

  .product-inspiration__dialog {
    width: min(920px, 92vw);
    max-height: 88vh;
    padding: 0;
    border: none;
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: #000000;
    overflow: hidden;
  }

  .product-inspiration__dialog::backdrop {
    background-color: rgb(0 0 0 / 0.7);
  }

  .product-inspiration__close {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: rgb(0 0 0 / 0.55);
    color: #ffffff;
    cursor: pointer;
  }

  .product-inspiration__close svg {
    width: 16px;
    height: 16px;
  }

  .product-inspiration__stage[hidden] {
    display: none;
  }

  .product-inspiration__stage video,
  .product-inspiration__stage iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
  }

  /*
    Fullscreen strips the dialog's own sizing, so the media has to be told to
    fill the screen rather than keep its 16:9 letterbox. `contain` keeps portrait
    clips whole instead of cropping them to the screen's shape.
  */
  .product-inspiration__dialog:fullscreen {
    width: 100%;
    max-width: none;
    max-height: none;
    border-radius: 0;
  }

  .product-inspiration__dialog:fullscreen .product-inspiration__stage,
  .product-inspiration__dialog:fullscreen .product-inspiration__stage video,
  .product-inspiration__dialog:fullscreen .product-inspiration__stage iframe {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .product-inspiration__bubble {
      --inspiration-size: 66px;
    }
  }
{% endstylesheet %}
