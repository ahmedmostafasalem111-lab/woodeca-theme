{% doc %}
  Renders a single product card in the reference layout: image, then a price row
  (current price, with the compare-at price and discount percentage kept together
  beside it), title, stock status line, and a circular quick-add button.

  Used by every product carousel on the homepage (sections 3, 6 and 8) so the card
  anatomy is defined in exactly one place.

  Pass either a real `product`, or the individual placeholder fields for use before
  collections are connected.

  @param {object} [product] - A product object. When present its data wins over the manual fields.
  @param {string} [title] - Fallback product title.
  @param {string} [price] - Fallback formatted current price.
  @param {string} [compare_price] - Fallback formatted compare-at price.
  @param {object} [image] - Fallback image object.
  @param {string} [stock_text] - Stock status line, e.g. "In stock: 1 pc.".
  @param {string} [stock_level] - 'in', 'low' or 'out'. Drives the status dot colour.
  @param {string} [url] - Destination link.
  @param {boolean} [show_quick_add] - Render the circular add-to-cart button. Default true.

  Collection-grid extras (all off by default so the homepage carousels are unchanged):

  @param {boolean} [show_swatches] - Render a colour swatch row under the title.
  @param {string} [swatch_option_name] - Which product option holds the colours. Default 'Color'.
  @param {number} [swatch_limit] - Swatches shown before the "+N" overflow label. Default 5.
  @param {boolean} [show_reviews] - Render the review-count line when review data exists.
  @param {boolean} [show_image_slider] - Page through the product's images in the media box. Default false.
  @param {number} [slider_limit] - Maximum images the slider renders. Default 5.
  @param {boolean} [show_dimensions] - Render the dimensions line when the metafield exists.
  @param {string} [dimensions_namespace] - Metafield namespace for dimensions. Default 'custom'.
  @param {string} [dimensions_key] - Metafield key for dimensions. Default 'dimensions'.
  @param {string} [dimensions_label] - Prefix label for the dimensions line.

  @example
  {% render 'showcase-product-card', product: product %}
  {% render 'showcase-product-card', product: product, show_swatches: true, show_reviews: true %}
{% enddoc %}

{% liquid
  if show_quick_add == nil
    assign show_quick_add = true
  endif

  # Prefer live product data, fall back to the placeholder settings.
  if product != blank and product != nil
    assign card_title = product.title
    assign card_url = product.url
    assign card_image = product.featured_image
    capture card_price
      render 'showcase-money', amount: product.price
    endcapture
    if product.compare_at_price > product.price
      capture card_compare_price
        render 'showcase-money', amount: product.compare_at_price
      endcapture
    endif
    unless product.available
      assign resolved_stock_level = 'out'
    endunless
  else
    assign card_title = title
    assign card_url = url
    assign card_image = image
    assign card_price = price
    assign card_compare_price = compare_price
  endif

  assign resolved_stock_level = resolved_stock_level | default: stock_level | default: 'in'

  # Discount percentage is derived rather than authored so it can never disagree
  # with the two prices shown next to it.
  assign discount_percent = 0
  if product != blank and product != nil
    if product.compare_at_price > product.price and product.compare_at_price > 0
      assign discount_amount = product.compare_at_price | minus: product.price | times: 100.0
      assign discount_percent = discount_amount | divided_by: product.compare_at_price | round
    endif
  endif

  # ---- Collection-grid extras ----
  assign swatch_limit = swatch_limit | default: 5
  assign swatch_option_name = swatch_option_name | default: 'Color'
  assign dimensions_namespace = dimensions_namespace | default: 'custom'
  assign dimensions_key = dimensions_key | default: 'dimensions'

  assign colour_option = null
  assign swatch_overflow = 0

  if show_swatches and product != blank and product != nil
    for product_option in product.options_with_values
      assign option_name_down = product_option.name | downcase
      assign wanted_name_down = swatch_option_name | downcase
      if option_name_down == wanted_name_down
        assign colour_option = product_option
      endif
    endfor

    # Fall back to the first option that actually carries swatch data.
    if colour_option == null
      for product_option in product.options_with_values
        assign swatch_count = product_option.values | map: 'swatch' | compact | size
        if swatch_count > 0 and colour_option == null
          assign colour_option = product_option
        endif
      endfor
    endif

    if colour_option != null
      assign swatch_overflow = colour_option.values.size | minus: swatch_limit
    endif
  endif

  # Review count follows the Shopify Product Reviews metafield convention.
  assign review_count = 0
  if show_reviews and product != blank and product != nil
    assign review_count = product.metafields.reviews.rating_count.value | default: 0
  endif

  assign dimensions_value = null
  if show_dimensions and product != blank and product != nil
    assign dimensions_value = product.metafields[dimensions_namespace][dimensions_key].value
  endif

  # ---- Card image slider ----
  # Opt-in so the collection grid can carry it without changing the homepage or PDP
  # carousels. Capped so a product with 30 photos doesn't bloat a 24-card grid.
  assign card_slider_images = null
  if show_image_slider and product != blank and product != nil
    assign slider_limit = slider_limit | default: 5
    if product.images.size > 1
      assign card_slider_images = product.images | slice: 0, slider_limit
    endif
  endif

  # ---- Add to cart ----
  # The card has no variant picker, so it adds the first available variant. Resolved
  # server-side so the button can never post a missing or unavailable variant id.
  assign card_variant_id = null
  assign card_purchasable = false
  if product != blank and product != nil
    assign card_variant = product.selected_or_first_available_variant
    if card_variant != nil and card_variant.available
      assign card_variant_id = card_variant.id
      assign card_purchasable = true
    endif
  endif

  # Already-in-cart state comes from the cart itself, so removing the item elsewhere
  # returns the button to its default state on the next page load.
  assign card_in_cart = false
  if card_variant_id != null
    for line_item in cart.items
      if line_item.variant_id == card_variant_id
        assign card_in_cart = true
        break
      endif
    endfor
  endif
%}

<div class="showcase-card">
  <div class="showcase-card__media">
    {%- comment -%}
      With the slider on, the media box becomes a scroll-snap track of the product's
      own images. Native scrolling gives the mobile swipe for free; the arrows just
      drive the same scroll on desktop. Only image 1 loads eagerly.
    {%- endcomment -%}
    {% if card_slider_images != null and card_slider_images.size > 1 %}
      <div class="showcase-card__slides" data-card-slides>
        {% for slide_image in card_slider_images %}
          {%- liquid
            assign card_link_tag = 'div'
            if card_url != blank
              assign card_link_tag = 'a'
            endif
          -%}
          <{{ card_link_tag }}
            {% if card_link_tag == 'a' %}href="{{ card_url }}"{% endif %}
            class="showcase-card__slide"
            draggable="false"
            tabindex="-1"
            aria-hidden="true"
          >
            {% liquid
              if forloop.first
                assign slide_loading = 'eager'
              else
                assign slide_loading = 'lazy'
              endif
            %}
            {{
              slide_image
              | image_url: width: 600
              | image_tag: loading: slide_loading, class: 'showcase-card__image', alt: card_title, draggable: 'false', sizes: '(min-width: 990px) 23vw, (min-width: 750px) 30vw, 50vw', widths: '200, 300, 400, 500, 600'
            }}
          </{{ card_link_tag }}>
        {% endfor %}
      </div>

      {%- comment -%}
        Dots only. The track is a native scroll-snap container, so swiping needs
        no JavaScript and no arrow buttons — the dots are the whole affordance,
        and they stay visible rather than appearing on hover.
      {%- endcomment -%}
      <div class="showcase-card__slide-dots" data-card-slide-dots aria-hidden="true">
        {% for slide_image in card_slider_images %}
          <span class="showcase-card__slide-dot{% if forloop.first %} showcase-card__slide-dot--active{% endif %}"></span>
        {% endfor %}
      </div>
    {% else %}
      {%- liquid
        assign card_link_tag = 'div'
        if card_url != blank
          assign card_link_tag = 'a'
        endif
      -%}
      <{{ card_link_tag }}
        {% if card_link_tag == 'a' %}href="{{ card_url }}"{% endif %}
        class="showcase-card__media-link"
        draggable="false"
        tabindex="-1"
        aria-hidden="true"
      >
        {% if card_image != blank %}
          {{
            card_image
            | image_url: width: 600
            | image_tag: loading: 'lazy', class: 'showcase-card__image', alt: card_title, draggable: 'false', sizes: '(min-width: 990px) 23vw, (min-width: 750px) 30vw, 50vw', widths: '200, 300, 400, 500, 600'
          }}
        {% else %}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'showcase-card__image showcase-card__image--placeholder' }}
        {% endif %}
      </{{ card_link_tag }}>
    {% endif %}

  </div>

  {%- comment -%}
    Tabs hanging from the bottom-left of the image: the product's own label
    (custom.product_label). The media box clips its overflow, so the row sits
    just under it rather than inside it. Nothing is rendered without a label.
  {%- endcomment -%}
  {%- if product != blank and product != nil -%}
    {%- capture card_tabs -%}
      {%- render 'showcase-product-label', product: product, style: 'tab' -%}
    {%- endcapture -%}
    {%- if card_tabs != blank -%}
      <div class="showcase-card__tabs">{{ card_tabs }}</div>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
    The cart button lives in the text row, not the image box, so the media panel
    holds only the photo.
  {%- endcomment -%}
  <div class="showcase-card__info">
    <div class="showcase-card__info-text">
    {%- comment -%}
      Stacked, divan.ru style: the struck-through compare-at price on top, the
      sale price directly under it, the name just below. No compare-at price =
      the sale price alone.
    {%- endcomment -%}
    <div class="showcase-card__price-row">
      {% if card_compare_price != blank or discount_percent > 0 %}
        <span class="showcase-card__was">
          {% if card_compare_price != blank %}
            <s class="showcase-card__compare-price">{{ card_compare_price }}</s>
          {% endif %}
          {% if discount_percent > 0 %}
            <span class="showcase-card__discount">-{{ discount_percent }}%</span>
          {% endif %}
        </span>
      {% endif %}

      <span class="showcase-card__price">{{ card_price }}</span>

      {% if review_count > 0 %}
        <span class="showcase-card__reviews">
          <span class="svg-wrapper" aria-hidden="true">
            {{- 'icon-chat.svg' | inline_asset_content -}}
          </span>
          {{ review_count }}
          {%- if review_count == 1 %} review{% else %} reviews{% endif -%}
        </span>
      {% endif %}
    </div>

    {%- liquid
      assign card_link_tag = 'div'
      if card_url != blank
        assign card_link_tag = 'a'
      endif
    -%}
    <{{ card_link_tag }}
      {% if card_link_tag == 'a' %}href="{{ card_url }}"{% endif %}
      class="showcase-card__title"
      draggable="false"
    >
      {{- card_title -}}
    </{{ card_link_tag }}>

    {% if stock_text != blank %}
      <p class="showcase-card__stock showcase-card__stock--{{ resolved_stock_level }}">
        <span class="showcase-card__stock-dot" aria-hidden="true"></span>
        {{ stock_text }}
      </p>
    {% endif %}

    {% if dimensions_value != blank %}
      <p class="showcase-card__dimensions">
        <span class="showcase-card__dimensions-label">
          {{- dimensions_label | default: 'Dimensions (L x W x H), cm' -}}
        </span>
        <span class="showcase-card__dimensions-value">{{ dimensions_value }}</span>
      </p>
    {% endif %}

    {% if colour_option != null %}
      <div class="showcase-card__swatches">
        {% for option_value in colour_option.values limit: swatch_limit %}
          {%- comment -%}
            Three sources, in descending order of fidelity:
              1. the swatch Shopify holds against the option value,
              2. the matching variant's own photo, cropped into the circle,
              3. a neutral disc, only when a value has neither.

            Source 2 is what makes these render at all in this store — no option
            value here has swatch data, but every variant has an image. It also
            supplies the image the card swaps to when the swatch is pressed.
          {%- endcomment -%}
          {% liquid
            assign swatch_variant = null
            for candidate in product.variants
              if candidate.title == option_value.name or candidate.options contains option_value.name
                if swatch_variant == null
                  assign swatch_variant = candidate
                endif
              endif
            endfor

            assign swatch_image = swatch_variant.featured_image

            # The variant's assigned image is often a different shot of the same
            # piece, not the same shot recoloured — on this store the White
            # variant points at "_White_3" while the card leads with "_White_1",
            # and swapping between them made the product appear to change size.
            #
            # So prefer the first image in the product's own media that belongs
            # to this colour: the counterpart of the lead shot, framed the same
            # way. Falls back to the variant image when nothing matches.
            assign colour_key = option_value.name | downcase | replace: ' ', '_'
            for candidate_image in product.images
              assign image_key = candidate_image | downcase
              if image_key contains colour_key
                assign swatch_image = candidate_image
                break
              endif
            endfor

            assign swap_src = null
            if swatch_image != blank
              assign swap_src = swatch_image | image_url: width: 600
            endif
          %}
          <button
            type="button"
            class="showcase-card__swatch"
            data-card-swatch
            {% if swap_src != blank %}
              data-swatch-image="{{ swap_src }}"
            {% endif %}
            {% if swatch_variant != null %}
              data-swatch-variant="{{ swatch_variant.id }}"
            {% endif %}
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            title="{{ option_value.name | escape }}"
            aria-label="{{ option_value.name | escape }}"
          >
            {% if option_value.swatch != blank %}
              {% render 'swatch', swatch: option_value.swatch, mode: 'unscaled', label: option_value.name %}
            {% elsif swatch_image != blank %}
              {{
                swatch_image
                | image_url: width: 80
                | image_tag: loading: 'lazy', class: 'showcase-card__swatch-img', alt: '', sizes: '20px', widths: '40, 60, 80'
              }}
            {% else %}
              <span class="showcase-card__swatch-fallback"></span>
            {% endif %}
          </button>
        {% endfor %}

        {% if swatch_overflow > 0 %}
          <span class="showcase-card__swatch-overflow">+{{ swatch_overflow }}</span>
        {% endif %}
      </div>
    {% endif %}
    </div>

    {% if show_quick_add and card_purchasable %}
      <button
        type="button"
        class="showcase-card__quick-add{% if card_in_cart %} showcase-card__quick-add--added{% endif %}"
        data-cart-add
        data-variant-id="{{ card_variant_id }}"
        data-cart-url="{{ routes.cart_url }}"
        data-label-add="Add {{ card_title | escape }} to cart"
        data-label-added="{{ card_title | escape }} is in your cart. Go to cart"
        aria-label="
          {%- if card_in_cart -%}
            {{ card_title | escape }} is in your cart. Go to cart
          {%- else -%}
            Add {{ card_title | escape }} to cart
          {%- endif -%}
        "
      >
        <span class="svg-wrapper showcase-card__quick-add-icon showcase-card__quick-add-icon--bag" aria-hidden="true">
          {{- 'icon-cart.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper showcase-card__quick-add-icon showcase-card__quick-add-icon--done" aria-hidden="true">
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
        </span>
      </button>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .showcase-card {
    --showcase-card-radius: var(--style-border-radius-inputs, 8px);

    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /*
    A press on the card that moves a few pixels (a normal hand) used to start
    the browser's native drag of the image/link: its shrunken ghost image read
    as a "shrink/minimize" animation and the click never happened. Cards aren't
    draggable, so the press stays a plain click and navigates instantly.
  */
  .showcase-card a,
  .showcase-card img {
    -webkit-user-drag: none;
  }

  .showcase-card__media {
    position: relative;
    background-color: var(--showcase-card-media-background, rgb(var(--color-foreground-rgb) / var(--opacity-5)));
    border-radius: var(--showcase-card-radius);
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .showcase-card__media-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  /* ---- Image slider ---- */
  .showcase-card__slides {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .showcase-card__slides::-webkit-scrollbar {
    display: none;
  }

  .showcase-card__slide {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: start;
  }

  /*
    Dots are the only slider control and are always visible — they double as the
    "there are more photos" hint, which a hover-revealed control cannot do on a
    touchscreen. Nothing here changes size on interaction.
  */
  .showcase-card__slide-dots {
    position: absolute;
    inset-inline: 0;
    bottom: 8px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .showcase-card__slide-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-25));
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .showcase-card__slide-dot--active {
    background-color: var(--color-foreground);
  }

  /*
    The photo fills its tile, with only enough inset to keep the product clear of
    the dots. `contain` still means a portrait and a landscape shot sit at the
    same optical size.

    Inset trimmed from 6%/10% to 1%/3%: with `contain`, the rendered product is
    governed by the tighter of the two axes, so the vertical inset going from 16%
    to 4% grows the product by about 14%.
  */
  .showcase-card__image {
    width: 100%;
    height: 100%;
    padding: 1% 1% 3%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .showcase-card__image--placeholder {
    width: 100%;
    height: 100%;
    padding: 6%;
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .showcase-card__quick-add {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: var(--showcase-card-quick-add-background, var(--color-foreground));
    color: var(--showcase-card-quick-add-icon, var(--color-background));
    cursor: pointer;
    transition:
      transform var(--animation-speed) var(--animation-timing-bounce),
      background-color var(--animation-speed) var(--animation-easing);
  }

  .showcase-card__quick-add:hover {
    transform: scale(1.08);
  }

  .showcase-card__quick-add .svg-wrapper,
  .showcase-card__quick-add svg {
    width: 15px;
    height: 15px;
  }

  /* Both icons are rendered; the state class decides which one shows. */
  .showcase-card__quick-add-icon--done,
  .showcase-card__quick-add--added .showcase-card__quick-add-icon--bag {
    display: none;
  }

  .showcase-card__quick-add--added .showcase-card__quick-add-icon--done {
    display: flex;
  }

  /*
    Confirmed state: a solid green disc with a heavier tick, so it reads at
    32px. The stroke is set here rather than inherited, because the shared
    icon uses the theme's thin default.
  */
  .showcase-card__quick-add--added {
    background-color: var(--showcase-card-quick-add-added-background, #22a45d);
    color: #ffffff;
  }

  .showcase-card__quick-add--added svg {
    width: 17px;
    height: 17px;
    stroke-width: 2.4;
  }

  .showcase-card__quick-add--busy {
    opacity: var(--opacity-60);
    pointer-events: none;
  }

  .showcase-card__quick-add--error {
    background-color: var(--showcase-card-quick-add-error-background, #c0392b);
  }

  /*
    Text row: name/price block on the left, circular cart button right-aligned and
    centred against it. Matches the reference, where the button sits outside the
    image box rather than overlapping the photo.
  */
  .showcase-card__info {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-xs);
    padding-block-start: var(--padding-sm);
  }

  /* 5px between the price block and the name (and the rows after it). */
  .showcase-card__info-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  /* Compare-at on top, sale price directly under it — no gap between them. */
  .showcase-card__price-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  .showcase-card__price {
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
  }

  /* Hanging tabs: flat top against the image, 2px bottom corners, 5px in. */
  .showcase-card__tabs {
    display: flex;
    gap: 4px;
    min-width: 0;
    padding-inline-start: 5px;
  }

  .showcase-card__tabs .product-label--tab {
    flex: 0 1 auto;
    padding: 5px;
    border-radius: 0 0 2px 2px;
    font-size: 10px;
    font-weight: 500;
    line-height: 10px;
  }

  /* Never splits: the chip always sits beside the price it discounts. */
  .showcase-card__was {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
    white-space: nowrap;
  }

  .showcase-card__compare-price {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
  }

  .showcase-card__discount {
    padding: 1px var(--padding-3xs);
    border-radius: 4px;
    background-color: var(--showcase-card-discount-background, #e8705a);
    color: var(--showcase-card-discount-text, #fff);
    font-size: var(--font-size--2xs);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Titles clamp to two lines so cards in a row stay the same height. */
  .showcase-card__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    color: var(--color-foreground);
    font-size: 14px;
    font-weight: 400;
    line-height: 21px;
    text-decoration: none;
  }

  @media screen and (min-width: 990px) {
    .showcase-card__compare-price {
      font-size: 16px;
      line-height: 24px;
    }

    .showcase-card__price {
      font-size: 18px;
      line-height: 27px;
    }

    .showcase-card__title {
      font-size: 16px;
      line-height: 24px;
    }
  }

  .showcase-card__stock {
    display: flex;
    align-items: center;
    gap: var(--gap-3xs);
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--2xs);
  }

  .showcase-card__stock-dot {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: currentcolor;
  }

  .showcase-card__stock--in .showcase-card__stock-dot {
    background-color: var(--color-instock, #3d8a4f);
  }

  .showcase-card__stock--low .showcase-card__stock-dot {
    background-color: var(--color-lowstock, #e8705a);
  }

  .showcase-card__stock--out .showcase-card__stock-dot {
    background-color: var(--color-outofstock, #b0b0b0);
  }

  /* ---- Collection-grid extras ---- */
  .showcase-card__reviews {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-inline-start: auto;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--2xs);
    white-space: nowrap;
  }

  .showcase-card__reviews .svg-wrapper,
  .showcase-card__reviews svg {
    width: 12px;
    height: 12px;
  }

  /* Dotted leader between the label and the value, as in the reference. */
  .showcase-card__dimensions {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3xs);
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--2xs);
  }

  .showcase-card__dimensions-label {
    flex-shrink: 0;
  }

  .showcase-card__dimensions-label::after {
    content: '';
    display: inline-block;
    width: 100%;
  }

  .showcase-card__dimensions-value {
    margin-inline-start: auto;
    white-space: nowrap;
  }

  /*
    One row, never wrapping. Swatches keep a fixed diameter on every card so a
    product with many variants can't shrink them or push them onto a second line —
    the overflow chip absorbs the remainder instead.
  */
  .showcase-card__swatches {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 6px;
    margin-block-start: var(--margin-2xs);
  }

  .showcase-card__swatch {
    /*
      Containing block for the shared swatch snippet's visually-hidden label.
      Without it that absolutely positioned label resolves against an ancestor
      outside the card's scroll row, escapes the row's clip, and widens the
      whole page on phones.
    */
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    width: var(--showcase-card-swatch-size, 20px);
    height: var(--showcase-card-swatch-size, 20px);
    --swatch-size: var(--showcase-card-swatch-size, 20px);

    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
    transition: box-shadow var(--animation-speed) var(--animation-easing);
  }

  /* Ring sits outside the circle so it never crops the colour underneath. */
  .showcase-card__swatch[aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-foreground);
  }

  /* Pin the shared swatch snippet to the same diameter regardless of its own sizing. */
  .showcase-card__swatch > * {
    width: 100% !important;
    height: 100% !important;
    min-width: 0;
    min-height: 0;
  }

  /* Variant photo standing in for a colour chip: crop to fill, never letterbox. */
  .showcase-card__swatch-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-card__swatch-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .showcase-card__swatch-overflow {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    font-size: var(--font-size--2xs);
  }
{% endstylesheet %}
